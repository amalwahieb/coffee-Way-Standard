r:var(--copper);font-size:12px;font-weight:700;cursor:pointer;vertical-align:middle;padding:0;line-height:1}.thelp{margin:11px 0 4px;background:rgba(42,32,24,.05);border:1px solid var(--paperLine);border-radius:12px;padding:12px}.thelp-pair{display:flex;align-items:stretch;gap:8px}.thelp-card{flex:1;border-radius:10px;padding:10px}.thelp-card.sour{background:rgba(62,142,142,.13);border:1px solid rgba(62,142,142,.45)}.thelp-card.bitter{background:rgba(210,121,46,.13);border:1px solid rgba(210,121,46,.5)}.thelp-vs{align-self:center;font-size:11px;color:var(--inkSoft);font-weight:700}.thelp-term{font-weight:700;margin-bottom:5px;color:var(--ink);font-size:13px}.thelp-taste{font-size:12.5px;line-height:1.55;color:#5A4E40}.thelp-fix{font-size:12px;line-height:1.45;margin-top:6px;color:var(--ink);font-weight:700}.thelp-rest{margin-top:10px;display:flex;flex-direction:column;gap:7px}.thelp-row{font-size:12.5px;line-height:1.55;color:#5A4E40}.thelp-row b{color:var(--ink)}.thelp-foot{margin-top:10px;font-size:11px;color:var(--inkSoft);line-height:1.5;font-style:italic}body.ar .thelp-fix,body.ar .thelp-foot{font-style:normal}.jtrail{margin-top:16px;background:rgba(42,32,24,.04);border:1px solid rgba(42,32,24,.08);border-radius:12px;padding:14px 16px}.jhead{display:flex;align-items:center;justify-content:space-between;font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.12em;color:var(--inkSoft);text-transform:uppercase;margin-bottom:8px}.finapply{margin-top:10px;width:100%;padding:11px;border-radius:10px;border:none;background:var(--copper);color:#160E09;font-weight:700;font-size:13px;cursor:pointer;font-family:'Space Grotesk',sans-serif}.jundo{border:none;background:none;color:var(--copper);font-size:11px;cursor:pointer;padding:0;text-transform:none;letter-spacing:0}.jreset{border:none;background:none;color:var(--copper);font-size:11px;cursor:pointer;padding:0;text-transform:none;letter-spacing:0}.jstatus{font-size:12.5px;line-height:1.5;color:var(--ink);font-weight:600;margin-bottom:9px}.jrow{display:flex;align-items:baseline;gap:10px;font-size:13px;color:#5A4E40;padding:6px 0;border-bottom:1px solid rgba(42,32,24,.06)}.jrow:last-child{border-bottom:none}.jn{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--inkSoft);width:14px;flex:none}.jt{font-weight:600;color:var(--ink)}.ja{color:var(--copper);font-weight:600}.jm{margin-inline-start:auto;font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--inkSoft)}.jrow.jgreat .jt,.jrow.jgreat .ja{color:var(--teal)}body.ar .sel{background-position:11px 20px,16px 20px;padding:0 12px 0 32px}#byline{font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--copper);margin:-6px 0 18px}body.ar #byline{letter-spacing:0;font-family:'Noto Sans Arabic',sans-serif;font-size:12px;text-transform:none}.sharebtn{display:block;width:100%;margin-top:9px;padding:13px;border-radius:12px;font-family:\"Space Grotesk\";font-weight:500;font-size:13.5px;border:1px solid var(--paperLine);background:transparent;color:var(--ink);font-family:'Space Grotesk',sans-serif;font-size:14px;font-weight:600;cursor:pointer}#toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--bg);color:var(--cream);padding:10px 18px;border-radius:20px;font-size:13px;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:80;box-shadow:0 4px 14px rgba(0,0,0,.3)}#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}body.ar,body.ar *{letter-spacing:normal !important}#retResult .thelp{background:rgba(244,238,227,.06);border-color:#3a2f24}#retResult .thelp-row{color:#CFC6B8}#retResult .thelp-row b{color:#F4EEE3}#retResult .thelp-foot{color:#A28F78}.lib-fresh{font-size:11px;margin-top:6px;font-weight:600;font-family:'JetBrains Mono',monospace;letter-spacing:.03em}.mach-hint{font-size:12px;color:var(--creamSoft);line-height:1.55;margin-bottom:12px;padding:12px 14px;border-radius:11px;background:rgba(224,129,60,.06);border:1px solid rgba(224,129,60,.15);border-color:var(--line);border-radius:8px}.mach-head{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:17px;color:var(--cream);margin:4px 0 12px}.mach-sel{margin-bottom:14px}.msec{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.16em;color:var(--copper);margin:18px 0 6px;text-transform:uppercase}.machine{margin-top:-4px}.mtitle{font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.12em;color:var(--copperBright);margin-bottom:10px}.mrow{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:11px 0;font-size:13px;border-bottom:1px solid rgba(62,50,42,.35)}.mrow:last-child{border-bottom:none}.mk{color:var(--creamSoft);font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.04em}.mv{color:var(--cream);font-weight:600;text-align:end;font-family:ui-serif,'New York',Georgia,serif;font-size:17px}.mnote{font-size:11px;color:var(--creamSoft);margin-top:9px;font-style:italic;line-height:1.45}body.ar .mnote{font-style:normal}.seg-btn[data-id=\"osamah\"]{font-size:10.5px;padding:0 7px;line-height:1.35}#cardOverlay{display:none;position:fixed;inset:0;background:rgba(10,7,5,.92);z-index:90;align-items:center;justify-content:center;padding:20px}.co-in{max-width:420px;width:100%;text-align:center}.co-in img{width:100%;border-radius:14px;box-shadow:0 8px 30px rgba(0,0,0,.5)}.co-hint{color:#A28F78;font-size:13px;margin:12px 0}.co-close{padding:11px 26px;border-radius:10px;border:1px solid #D2792E;background:transparent;color:#E89A4B;font-size:14px;font-weight:600}.sharebtn[data-sharecard]{margin-bottom:26px}.impwrap{display:flex;gap:8px;margin:0 0 16px}.impwrap .txt{flex:1;min-width:0}#machineView .sharebtn{color:var(--copperBright);border-color:var(--copper);font-weight:600}.impbtn{padding:0 18px;border-radius:11px;border:1px solid var(--copper);background:var(--copper);color:#140E0C;font-weight:600;font-size:13px;font-weight:600;white-space:nowrap}.adj{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--copper);margin-top:4px}.grind .adj{color:var(--copperBright)}.hist-chg{color:var(--copperBright)}#toTop{position:fixed;bottom:22px;inset-inline-end:18px;width:46px;height:46px;border-radius:50%;border:none;background:var(--copper);color:var(--bg);font-size:20px;font-weight:700;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.35);opacity:0;pointer-events:none;transform:translateY(8px);transition:opacity .25s,transform .25s;z-index:60}#toTop.show{opacity:1;pointer-events:auto;transform:translateY(0)}</style></head><body><div class=\"wrap\">\n<div class=\"topbar\"><div id=\"nav\" class=\"navwrap\"></div></div>\n<div id=\"updateBanner\" class=\"updbar\" style=\"display:none\"></div>\n<h1>Coffee Way Standard</h1>\n<div id=\"byline\"></div>\n<div id=\"buildView\">\n<div class=\"panel\" id=\"inputs\"></div>\n<div id=\"card\"></div>\n<div id=\"afterBrew\"><div class=\"ab-title\">After the brew · weigh your cup (optional)</div><div class=\"ab-grid\"><div class=\"ab-f\"><div class=\"ab-l\">Water poured (ml)</div><input id=\"poured\" class=\"abnum\" inputmode=\"decimal\"></div><div class=\"ab-f\"><div class=\"ab-l\">Coffee in cup (ml)</div><input id=\"cupOut\" class=\"abnum\" inputmode=\"decimal\" placeholder=\"weigh it\"></div></div><div id=\"retResult\" class=\"ab-result\"></div></div>\n<div id=\"saveBar\"><div id=\"activeHint\" class=\"active-hint\"></div><button id=\"saveToggle\" class=\"savebar-btn\">★ Save this bag</button><div id=\"saveForm\" class=\"saveform\"><input id=\"saveName\" class=\"pname\" placeholder=\"name this bag\" maxlength=\"32\"><button id=\"saveConfirm\" class=\"savebtn\">Save</button><button id=\"saveCancel\" class=\"cancelbtn\">✕</button></div></div>\n</div>\n<div id=\"libraryView\"></div>\n<div id=\"machineView\" style=\"display:none\"></div>\n<div id=\"learnView\"></div>\n</div>\n<button id=\"toTop\" aria-label=\"Back to top\">↑</button>\n<div id=\"toast\"></div>\n<div id=\"cardOverlay\"></div>\n<div id=\"gsetupOverlay\" class=\"gso\" style=\"display:none\"></div>\n<div id=\"timerOverlay\" class=\"tov\"><div class=\"tov-inner\"><div class=\"tov-eyebrow\" id=\"tEyebrow\">Pour timer</div><div class=\"tov-ring-wrap\"><svg class=\"tov-ring\" viewBox=\"0 0 240 240\"><circle class=\"tov-ring-bg\" cx=\"120\" cy=\"120\" r=\"108\"/><circle class=\"tov-ring-fg\" id=\"tRing\" cx=\"120\" cy=\"120\" r=\"108\"/></svg><div class=\"tov-ring-center\"><div class=\"tov-state\" id=\"tState\">POUR</div><div class=\"tov-time\" id=\"tTime\">0:00</div><div class=\"tov-target\" id=\"tTarget\"></div></div></div><div class=\"tov-note\" id=\"tNote\"></div><div class=\"tov-next\" id=\"tNext\"></div><div class=\"tov-steps\" id=\"tSteps\"></div><div class=\"tov-ctrls\"><button id=\"tPause\" class=\"tov-btn\">Pause</button><button id=\"tSkip\" class=\"tov-btn\">Skip</button><button id=\"tReset\" class=\"tov-btn\">Reset</button><button id=\"tClose\" class=\"tov-btn tov-close\">Close</button></div></div></div>\n<script>\nvar APP_VERSION=\"1.8.7\";\n// To enable update checks: set this to the raw URL of version.json in your repo,\n// e.g. \"https://raw.githubusercontent.com/USER/REPO/main/version.json\". Leave \"\" to disable.\nvar VERSION_URL=\"https://raw.githubusercontent.com/amalwahieb/coffee-Way-Standard/main/version.json\";\nvar REPO_URL=\"https://github.com/amalwahieb/coffee-Way-Standard\";\n\n// ============ ENGINE (identical to the app) ============\nconst ROASTS=[{id:\"light\",label:\"Light\",temp:99,grind:\"Medium-fine\",notch:-2,agit:\"high\",bloomMult:2.2,rest:[10,24]},{id:\"med-light\",label:\"Med-Light\",temp:96,grind:\"Medium-fine\",notch:-1,agit:\"high\",bloomMult:2.1,rest:[8,21]},{id:\"medium\",label:\"Medium\",temp:93,grind:\"Medium\",notch:0,agit:\"medium\",bloomMult:2.0,rest:[6,18]},{id:\"med-dark\",label:\"Med-Dark\",temp:90,grind:\"Medium-coarse\",notch:1,agit:\"low\",bloomMult:2.0,rest:[4,14]},{id:\"dark\",label:\"Dark\",temp:88,grind:\"Coarse\",notch:2,agit:\"low\",bloomMult:2.0,rest:[3,10]}];\nconst PROCESSES=[{id:\"washed\",label:\"Washed\",flavor:\"clean, bright, articulate cup\",tweak:\"Brew straight for clarity.\",degas:0},{id:\"honey\",label:\"Honey\",flavor:\"rounder sweetness with light fruit\",tweak:\"Standard pours; sweetness sits in the middle.\",degas:2},{id:\"natural\",label:\"Natural\",flavor:\"fruit-forward, heavy, sometimes boozy\",tweak:\"Gentler pours — the bed is fragile and degasses fast.\",degas:5},{id:\"anaerobic\",label:\"Anaerobic\",flavor:\"intense, funky, fermented character\",tweak:\"Pull it back: cooler or coarser so the funk doesn't dominate.\",degas:5},{id:\"coferment\",label:\"Co-fermented / Infused\",flavor:\"loud added aromatics riding over the base coffee\",tweak:\"Keep it cool and gentle — added aromatics turn harsh fast.\",degas:5},{id:\"wethulled\",label:\"Wet-hulled (Sumatra)\",flavor:\"earthy, herbal, heavy body, low acidity\",tweak:\"Body over brightness — standard pours; expect a slow, muddy-looking bed.\",degas:2},{id:\"decaf\",label:\"Decaf (any method)\",flavor:\"softer, rounder version of the bean\",tweak:\"Porous beans extract fast — brewed cooler; go coarser before anything else if bitter.\",degas:0}];\nconst STRENGTHS=[{id:\"light\",label:\"Lighter\",ratio:17.0},{id:\"balanced\",label:\"Balanced\",ratio:16.67},{id:\"strong\",label:\"Stronger\",ratio:15.5}];\nconst GOALS=[{id:\"everyday\",label:\"Everyday Balanced\",method:\"everyday\"},{id:\"brighter\",label:\"Fruity · Kasuya 4:6\",method:\"fourSix\"},{id:\"sweeter\",label:\"Sweeter · Kasuya 4:6\",method:\"fourSix\"},{id:\"classic\",label:\"Classic · Hoffmann\",method:\"hoffmann\"},{id:\"osamah\",label:\"Osamah Alawwam · Roasting House owner\",method:\"osamah\",grindOff:-3,tempOff:1}];\nconst ORIGINS=[{id:\"ethiopia\",label:\"Ethiopia\",notes:\"jasmine, citrus, stone fruit, tea-like body\",tip:\"Aromatics are delicate — don't over-agitate; let the floral top notes survive.\"},{id:\"kenya\",label:\"Kenya\",notes:\"blackcurrant, tomato, syrupy body, vivid acidity\",tip:\"Can take a slightly finer grind to pull more of that blackcurrant depth.\",notch:-1},{id:\"colombia\",label:\"Colombia\",notes:\"caramel, red apple, balanced sweetness\",tip:\"Forgiving and balanced — a great bag to benchmark your dial-in on.\"},{id:\"peru\",label:\"Peru\",notes:\"mild chocolate, nuts, caramel, soft citrus, gentle acidity\",tip:\"Soft and forgiving — a clean, balanced everyday cup; often organic and washed.\"},{id:\"brazil\",label:\"Brazil\",notes:\"chocolate, peanut, heavy body, low acidity\",tip:\"Dense, low-acid flavour; keep temp moderate or it turns ashy.\",temp:-1},{id:\"guatemala\",label:\"Guatemala\",notes:\"cocoa, orange, structured acidity\"},{id:\"costa-rica\",label:\"Costa Rica\",notes:\"honeyed sweetness, citrus, clean finish\"},{id:\"rwanda\",label:\"Rwanda / Burundi\",notes:\"red fruit, floral, silky\"},{id:\"panama\",label:\"Panama Gesha\",notes:\"jasmine, bergamot, tropical — delicate & rare\",tip:\"Treat it gently: low agitation, clean even pours. Don't bully a Gesha.\"},{id:\"yemen\",label:\"Yemen\",notes:\"wild, boozy, dried fruit, warm spice\"},{id:\"saudi\",label:\"Saudi Arabia (Khawlani)\",notes:\"dried fruit, dark chocolate, spice, winey, full body\",tip:\"Jazan Khawlani is usually natural-processed and heritage-grown — treat like a rich natural: gentle pours, and don't over-extract the spice.\"},{id:\"indonesia\",label:\"Indonesia / Sumatra\",notes:\"earthy, herbal, cedar, big body, low acidity\",tip:\"Usually roasted darker — lean coarser and cooler with gentle pours.\",notch:1,temp:-1},{id:\"vietnam\",label:\"Vietnam\",notes:\"dark chocolate, roasted nut, cocoa bitterness, heavy body, very low acidity\",tip:\"Usually robusta — bold and low-acid, and it turns bitter easily. Grind coarser, brew cooler, and pour gently. Specialty Vietnamese arabica (from Da Lat) is milder — treat it more like a regular origin.\",notch:1,temp:-1},{id:\"honduras\",label:\"Honduras\",notes:\"caramel, stone fruit, mild\"},{id:\"el-salvador\",label:\"El Salvador\",notes:\"chocolate, red apple, soft\"},{id:\"tanzania\",label:\"Tanzania / Uganda\",notes:\"blackcurrant, bright, juicy\"},{id:\"thailand\",label:\"Thailand\",notes:\"mild, sweet, chocolate-nut, gentle fruit\"},{id:\"mexico\",label:\"Mexico\",notes:\"nutty, gentle citrus, light body\"},{id:\"india\",label:\"India\",notes:\"spice, cedar, low acidity (often monsooned)\"},{id:\"other\",label:\"Single — other / unsure\",notes:\"follow the descriptors printed on the bag\"}];\nconst BLENDS=[{id:\"filter\",label:\"Filter / pour-over blend\",notes:\"built for clarity across its components\",tip:\"Designed for this method — brew to the roast on the bag, and keep pours even since mixed densities extract at different rates.\",notch:0,temp:0},{id:\"espresso\",label:\"Espresso blend\",notes:\"usually darker, denser; chocolate & nut\",tip:\"Roasted for pressure, not pour-over. Go coarser and cooler and pour gently.\",notch:1,temp:-1},{id:\"house\",label:\"House / breakfast blend\",notes:\"comfortable, chocolatey, forgiving\",tip:\"Easy-going and hard to wreck — a good everyday dial-in.\",notch:0,temp:0}];\nconst GRINDERS=[{id:\"comandante\",type:\"manual\",label:\"Comandante C40\",base:25,step:3,unit:\"clicks\",min:8,max:40,wf:\"A drop of RDT water kills static. Count clicks from fully closed.\"},{id:\"com-redclix\",type:\"manual\",label:\"Comandante C40 + Red Clix\",base:50,step:6,unit:\"clicks\",min:16,max:80,wf:\"Red Clix axle: each stock click becomes two — numbers run about double a standard C40.\"},{id:\"1z-q2\",type:\"manual\",label:\"1Zpresso Q2 / Q-Air\",base:24,step:3,unit:\"clicks\",min:10,max:40,wf:\"Internal dial under the burr, 30 clicks per rotation — count from zero.\"},{id:\"1z-jxpro\",type:\"manual\",label:\"1Zpresso JX-Pro\",base:70,step:8,unit:\"clicks\",min:30,max:110,wf:\"External numbered dial, ~30 clicks per rotation; count from zero.\"},{id:\"1z-j\",type:\"manual\",label:\"1Zpresso J-Max / J-Ultra\",base:80,step:8,unit:\"clicks\",min:35,max:140,wf:\"External dial J-series — J-Max 90 clicks/turn, J-Ultra 100; numbers land close, adjust by taste.\"},{id:\"1z-x\",type:\"manual\",label:\"1Zpresso X-Pro / X-Ultra\",base:54,step:5,unit:\"clicks\",min:25,max:85,wf:\"External dial, 12.5µm/click, 60 clicks per turn.\"},{id:\"1z-kmax\",type:\"manual\",label:\"1Zpresso K-Max / K-Plus\",base:2.6,step:0.3,unit:\"rotations\",min:1,max:4,wf:\"Numbered dial, 90 clicks/turn. Read whole turns plus clicks.\"},{id:\"1z-zp6\",type:\"manual\",label:\"1Zpresso ZP6\",base:3.4,step:0.3,unit:\"rotations\",min:2,max:5,wf:\"Pour-over-tuned burrs — small moves make a big difference.\"},{id:\"timemore-c\",type:\"manual\",label:\"Timemore Chestnut C2 / C3\",base:20,step:2,unit:\"clicks\",min:8,max:35,wf:\"Clicks from zero (closed).\"},{id:\"timemore-x\",type:\"manual\",label:\"Timemore Chestnut X\",base:24,step:2,unit:\"clicks\",min:10,max:40,wf:\"Clicks from zero; the X burrs feel a touch finer.\"},{id:\"kingrinder\",type:\"manual\",label:\"Kingrinder K6 / K4\",base:80,step:8,unit:\"clicks\",min:30,max:130,wf:\"External dial, 8µm/click, 60 clicks per turn.\"},{id:\"king-k2\",type:\"manual\",label:\"Kingrinder K0 / K1 / K2\",base:40,step:5,unit:\"clicks\",min:20,max:56,wf:\"Internal dial under the burr — tighten to zero, count counter-clockwise. 40 clicks per turn, ~18µm each. Never grind below 16 clicks.\"},{id:\"mibru-manual\",type:\"manual\",label:\"MIBRU (manual)\",base:16,step:1,unit:\"clicks\",min:6,max:26,wf:\"Count clicks from fully closed. MIBRU chart: espresso 6-10 — start drip ~15-17 and dial by taste.\"},{id:\"mibru-elec\",type:\"electric\",label:\"MIBRU electric (87)\",base:44,step:2,unit:\"\",min:1,max:87,wf:\"87 levels, espresso fine to french coarse — MIBRU says the middle suits drip; start ~44.\"},{id:\"mhw\",type:\"manual\",label:\"MHW-3Bomber R3 / M1\",base:28,step:4,unit:\"clicks\",min:12,max:50,wf:\"Clicks from zero — espresso lands around 13–15, pour-over roughly double that.\"},{id:\"kinu\",type:\"manual\",label:\"Kinu M47\",stepless:true,baseDesc:\"around the filter mark on the gauge\",wf:\"Stepless — set near the filter mark, then nudge by taste.\"},{id:\"porlex\",type:\"manual\",label:\"Porlex Mini / Tall\",base:6,step:1,unit:\"clicks\",min:3,max:12,wf:\"Clicks from closed; less precise, so taste and adjust.\"},{id:\"hario-sk\",type:\"manual\",label:\"Hario Skerton / Mini\",byFeel:true,wf:\"No real scale — aim medium-fine and accept some unevenness.\"},{id:\"ode1\",type:\"electric\",label:\"Fellow Ode Gen 1\",base:4.5,step:0.5,unit:\"\",min:1,max:11,wf:\"Gen 1 cuts a touch coarser than Gen 2 at the same number.\"},{id:\"ode2\",type:\"electric\",label:\"Fellow Ode Gen 2\",base:5,step:0.5,unit:\"\",min:1,max:11,wf:\"Setting 1–11 with thirds. Single-dose, very low retention.\"},{id:\"opus\",type:\"electric\",label:\"Fellow Opus\",micro:4,base:6,step:0.5,unit:\"\",min:1,max:11,wf:\"Wider range than the Ode; three clicks between each number for fine moves.\"},{id:\"encore\",type:\"electric\",label:\"Baratza Encore\",base:20,step:3,unit:\"\",min:1,max:40,wf:\"Dial 1–40. Weigh beans in; expect a little retention.\"},{id:\"encore-esp\",type:\"electric\",label:\"Baratza Encore ESP\",base:28,step:3,unit:\"\",min:1,max:40,wf:\"ESP gearing runs finer, so pour-over sits higher on the dial.\"},{id:\"virtuoso\",type:\"electric\",label:\"Baratza Virtuoso+\",base:22,step:3,unit:\"\",min:1,max:40,wf:\"Dial 1–40; cleaner grind than the Encore.\"},{id:\"sette\",type:\"electric\",label:\"Baratza Sette 270\",base:26,step:2,unit:\"\",min:1,max:30,wf:\"Espresso-first grinder — pour-over lives at the very top of the macro ring.\"},{id:\"sculptor\",type:\"electric\",label:\"Timemore Sculptor 064 / 064S\",base:6,step:0.5,unit:\"\",min:1,max:9,wf:\"Stepless numbered dial — espresso sits around 2–3, filter mid-dial.\"},{id:\"sculptor78\",type:\"electric\",label:\"Timemore Sculptor 078 / 078S\",base:9,step:1,unit:\"\",min:4,max:14,wf:\"Big dial, ~25µm per number — pour-over lives around 7–12; start at 9 and dial by taste.\"},{id:\"niche\",type:\"electric\",label:\"Niche Zero\",base:25,step:3,unit:\"\",min:0,max:50,wf:\"Reference numbers (not absolute). Single-dose, near-zero retention.\"},{id:\"df64\",type:\"electric\",label:\"DF64 / DF54\",stepless:true,baseDesc:\"just coarser than your espresso point\",wf:\"Single-dose, stepless — set by reference. RDT helps with static.\"},{id:\"sd40\",type:\"electric\",label:\"Turin SD40\",stepless:true,baseDesc:\"just coarser than your espresso point\",wf:\"Single-dose, stepless — set by reference. RDT helps with static.\"},{id:\"lagom\",type:\"electric\",label:\"Option-O Lagom\",stepless:true,baseDesc:\"around your filter reference\",wf:\"Stepless single-doser — log a reference number per coffee.\"},{id:\"varia-vs3\",type:\"electric\",label:\"Varia VS3\",stepless:true,baseDesc:\"around the filter zone of the dial\",wf:\"Stepless single-doser — log a reference number per coffee.\"},{id:\"eureka\",type:\"electric\",label:\"Eureka Mignon\",stepless:true,baseDesc:\"the filter end of the worm dial\",wf:\"Stepless and geared fine — make small moves.\"},{id:\"sgp\",type:\"electric\",label:\"Breville Smart Grinder Pro\",base:30,step:3,unit:\"\",min:1,max:60,wf:\"Outer dial 1–60 plus inner fine adjust. Purge a little first.\"},{id:\"wilfa\",type:\"electric\",label:\"Wilfa Uniform / Svart\",base:24,step:3,unit:\"\",min:1,max:40,wf:\"Numbered dial; the filter range sits mid-scale.\"},{id:\"x54\",type:\"electric\",label:\"Mahlkönig X54\",base:6.5,step:0.5,unit:\"\",min:1,max:10,wf:\"Stepless dial with markings; single-dose friendly.\"},{id:\"ek43\",type:\"electric\",label:\"Mahlkönig EK43 (café)\",base:8.5,step:1,unit:\"\",min:1,max:16,wf:\"Café workhorse — filter sits around 7–10 on the 1–16 dial; every machine drifts, anchor to taste.\"},{id:\"oxo\",type:\"electric\",label:\"OXO Brew Conical\",base:8,step:1,unit:\"\",min:1,max:15,wf:\"Numbers 1–15 with clicks between — pour-over sits mid-scale.\"},{id:\"bodum\",type:\"electric\",label:\"Bodum Bistro\",base:7,step:1,unit:\"\",min:1,max:12,wf:\"12-position ring with wide steps — expect a real jump between numbers.\"},{id:\"capresso\",type:\"electric\",label:\"Capresso Infinity\",base:10,step:1,unit:\"\",min:1,max:16,wf:\"16 positions across four zones — pour-over lives in the middle zones.\"},{id:\"cuisinart\",type:\"electric\",label:\"Cuisinart Burr Mill\",base:10,step:2,unit:\"\",min:1,max:18,wf:\"18-position dial with wide steps — dial by taste.\"},{id:\"xbloom\",type:\"electric\",label:\"xBloom Studio (built-in)\",base:36,step:4,unit:\"\",min:5,max:75,wf:\"80 levels, 18.75µm each — set in the app or on the dial.\"}];\nconst BREWERS=[{id:\"v60\",label:\"V60\",kind:\"pour\",tempOff:0,grindOff:0,ratioMul:1,finishAdd:0,note:\"Conical and fast-flowing — the all-rounder, clarity-forward.\"},{id:\"kalita\",label:\"Kalita Wave\",kind:\"pour\",tempOff:0,grindOff:0,ratioMul:1,finishAdd:15,note:\"Flat bed with three small holes — forgiving and even. Pour in gentle pulses, keeping the water level low.\"},{id:\"chemex\",label:\"Chemex\",kind:\"pour\",tempOff:1,grindOff:1,ratioMul:1,finishAdd:45,note:\"Thick filter slows the flow and adds clarity — grind a touch coarser and run water a touch hotter.\"},{id:\"aeropress\",label:\"AeroPress\",kind:\"immersion\",tempOff:-3,grindOff:-1,ratioMul:0.85,finishAdd:0,note:\"Immersion then press: short contact, finer grind, less water. Cooler water suits it.\"},{id:\"switch\",label:\"Switch\",kind:\"immersion\",tempOff:0,grindOff:1,ratioMul:1,finishAdd:0,note:\"Immersion–dripper hybrid: steep with the valve closed, then open to release. A coarser grind suits the steep.\"}];\nconst fmt=(s)=>Math.floor(s/60)+\":\"+String(Math.round(s%60)).padStart(2,\"0\");\nconst cToF=(c)=>Math.round((c*9)/5+32);\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nfunction freshnessVerdict(days,rest,degas){const min=Math.max(2,rest[0]-Math.round(degas/2)),max=rest[1]-Math.round(degas/2);if(days<min)return{id:\"fresh\",min,max};if(days<=max)return{id:\"ideal\",min,max};if(days<=max+45)return{id:\"aging\",min,max};return{id:\"stale\",min,max}}\nfunction gsTasteBtns(which){\n  var opts=[[\"sour\",P(\"Sour / weak\",\"حامض / ضعيف\")],[\"balanced\",P(\"Balanced ✓\",\"متوازن ✓\")],[\"bitter\",P(\"Bitter / harsh\",\"مر / حاد\")]];\n  var cur=gsetup[which];\n  return '<div class=\"gso-taste\">'+opts.map(function(o){return '<button class=\"gso-tbtn'+(cur===o[0]?\" on\":\"\")+'\" data-gstaste=\"'+which+'|'+o[0]+'\">'+o[1]+'</button>';}).join(\"\")+'</div>';\n}\nfunction gsetupTestHtml(){\n  var u=P(gsetup.unit,({clicks:\"نقرات\",numbers:\"أرقام\",rotations:\"لفات\"})[gsetup.unit]||gsetup.unit);\n  var mn=parseFloat(gsetup.min),mx=parseFloat(gsetup.max);\n  var coarseSuggest=Math.round(mn+(mx-mn)*0.7),fineSuggest=Math.round(mn+(mx-mn)*0.4),midSuggest=Math.round(mn+(mx-mn)*0.55);\n  if(gsetup.depth===\"thorough\"){\n    return '<div class=\"gso-title\">'+P(\"Brew two cups\",\"حضّر كوبين\")+'</div>'\n      +'<div class=\"gso-sub\">'+P(\"Same coffee and recipe both times — only the grind changes. Brew, taste, tap.\",\"نفس القهوة والوصفة في المرتين — الطحن فقط يتغيّر. اطحن، ذوّق، اضغط.\")+'</div>'\n      +'<div class=\"gso-brew\"><div class=\"gso-brew-h\">'+P(\"Cup A — coarser\",\"كوب A — أخشن\")+'</div><div class=\"gso-set\">'+P(\"Set your grinder to about \",\"اضبط مطحنتك على حوالي \")+'<input class=\"gso-num\" data-gsset=\"coarseSet\" inputmode=\"decimal\" min=\"'+gsetup.min+'\" max=\"'+gsetup.max+'\" value=\"'+(gsetup.coarseSet||coarseSuggest)+'\"> '+u+'</div>'+gsTasteBtns(\"coarseTaste\")+'</div>'\n      +'<div class=\"gso-brew\"><div class=\"gso-brew-h\">'+P(\"Cup B — finer\",\"كوب B — أنعم\")+'</div><div class=\"gso-set\">'+P(\"Now set it to about \",\"الآن اضبطه على حوالي \")+'<input class=\"gso-num\" data-gsset=\"fineSet\" inputmode=\"decimal\" min=\"'+gsetup.min+'\" max=\"'+gsetup.max+'\" value=\"'+(gsetup.fineSet||fineSuggest)+'\"> '+u+'</div>'+gsTasteBtns(\"fineTaste\")+'</div>'\n      +'<div class=\"gso-btns\"><button class=\"gso-ghost\" data-gsback=\"depth\">'+P(\"Back\",\"رجوع\")+'</button><button class=\"gso-primary\" data-gsfinish=\"1\">'+P(\"See my result\",\"أرني النتيجة\")+'</button></div>';\n  }else{\n    return '<div class=\"gso-title\">'+P(\"Brew one cup\",\"حضّر كوبًا\")+'</div>'\n      +'<div class=\"gso-sub\">'+P(\"Brew the recipe, then tell me how it tasted.\",\"حضّر الوصفة، ثم قلّي كيف طعمها.\")+'</div>'\n      +'<div class=\"gso-brew\"><div class=\"gso-hintline\">'+P(\"Suggested start: around \",\"اقتراح للبداية: حوالي \")+midSuggest+' '+u+P(\" — but use whatever you brewed.\",\" — لكن استخدم ما حضّرت به فعلًا.\")+'</div><div class=\"gso-set\">'+P(\"What did you set for the test? \",\"كم \"+gsUnitOne()+\" وضعت للتجربة؟ \")+'<input class=\"gso-num\" data-gsset=\"oneSet\" inputmode=\"decimal\" min=\"'+gsetup.min+'\" max=\"'+gsetup.max+'\" placeholder=\"'+midSuggest+'\" value=\"'+(gsetup.oneSet||\"\")+'\"> '+u+'</div>'+gsTasteBtns(\"oneTaste\")+'</div>'\n      +'<div class=\"gso-btns\"><button class=\"gso-ghost\" data-gsback=\"depth\">'+P(\"Back\",\"رجوع\")+'</button><button class=\"gso-primary\" data-gsfinish=\"1\">'+P(\"See my result\",\"أرني النتيجة\")+'</button></div>';\n  }\n}\nfunction gsRangeStep(){var mn=parseFloat(gsetup.min),mx=parseFloat(gsetup.max);var span=Math.max(1,mx-mn);return Math.max(1,Math.round(span*0.15));}\nfunction gsClamp(v){var mn=parseFloat(gsetup.min),mx=parseFloat(gsetup.max);if(isNaN(mn))mn=0;if(isNaN(mx))mx=40;if(isNaN(v))v=(mn+mx)/2;return Math.max(mn,Math.min(mx,v));}\nfunction gsRangeStep(){var mn=parseFloat(gsetup.min),mx=parseFloat(gsetup.max);if(isNaN(mn))mn=0;if(isNaN(mx))mx=40;var span=Math.max(1,mx-mn);return Math.max(1,Math.round(span*0.15));}\nfunction gsQuickStep(){var mn=parseFloat(gsetup.min),mx=parseFloat(gsetup.max);if(isNaN(mn))mn=0;if(isNaN(mx))mx=40;var span=Math.max(1,mx-mn);return Math.max(1,Math.round(span*0.10));}\nfunction gsClamp(v){var mn=parseFloat(gsetup.min),mx=parseFloat(gsetup.max);if(isNaN(mn))mn=0;if(isNaN(mx))mx=40;if(isNaN(v))v=(mn+mx)/2;return Math.max(mn,Math.min(mx,v));}\nfunction gsUnitOne(){return P(({clicks:\"click\",numbers:\"number\"})[gsetup.unit]||gsetup.unit,({clicks:\"نقرة\",numbers:\"رقم\"})[gsetup.unit]||gsetup.unit);}\nfunction gsUnitLabel(){return P(gsetup.unit===\"numbers\"?\"\":gsetup.unit,({clicks:\"نقرات\",numbers:\"\"})[gsetup.unit]||gsetup.unit);}\nfunction gsShell(body){var o=document.getElementById(\"gsetupOverlay\");o.style.display=\"\";o.innerHTML='<div class=\"gso-inner\">'+body+'</div>';}\nfunction gsFoundScreen(best,note){\n  var u=gsUnitLabel();\n  gsShell('<div class=\"gso-title\">'+P(\"Your grind for \"+gsetup.name,\"طحنتك لـ \"+gsetup.name)+'</div>'\n    +'<div class=\"gso-result\"><div class=\"gso-big\">'+best+'</div><div class=\"gso-bigu\">'+u+'</div></div>'\n    +(note?'<div class=\"gso-note\">'+note+'</div>':\"\")\n    +'<div class=\"gso-sub\">'+P(\"This is your starting point on this grinder. The app builds every recipe around it, and your brew times fine-tune it over time.\",\"هذي نقطة البداية على هذه المطحنة. التطبيق يبني كل وصفة حولها، وأوقات تحضيرك تضبطها مع الوقت.\")+'</div>'\n    +'<div class=\"gso-btns\"><button class=\"gso-ghost\" data-gsclose=\"1\">'+P(\"Cancel\",\"إلغاء\")+'</button><button class=\"gso-primary\" data-gssave=\"1\">'+P(\"Save this grinder\",\"احفظ هذه المطحنة\")+'</button></div>');\n}\nfunction gsRetryScreen(dir,coarseV,fineV){\n  var u=gsUnitLabel();\n  var dirTxt=(dir===\"finer\")?P(\"Both cups came out under-extracted (sour) — they were too coarse. Your grind is finer than both.\",\"الكوبين طلعوا ناقصين الاستخلاص (حامض) — كانوا خشنين. طحنتك أنعم منهما.\")\n    :P(\"Both cups came out over-extracted (bitter) — they were too fine. Your grind is coarser than both.\",\"الكوبين طلعوا زائدي الاستخلاص (مر) — كانوا ناعمين. طحنتك أخشن منهما.\");\n  gsShell('<div class=\"gso-title\">'+P(\"Let’s narrow it down\",\"خلّينا نقرّبها\")+'</div>'\n    +'<div class=\"gso-sub\">'+dirTxt+'</div>'\n    +'<div class=\"gso-brew\"><div class=\"gso-brew-h\">'+P(\"Try this pair next\",\"جرّب هذا الزوج القادم\")+'</div><div class=\"gso-set\">'+P(\"Cup A (coarser): \",\"كوب A (الأخشن): \")+'<b>'+coarseV+'</b> '+u+' · '+P(\"Cup B (finer): \",\"كوب B (الأنعم): \")+'<b>'+fineV+'</b> '+u+'</div></div>'\n    +'<div class=\"gso-btns\"><button class=\"gso-ghost\" data-gsclose=\"1\">'+P(\"Stop here\",\"أوقف هنا\")+'</button><button class=\"gso-primary\" data-gsretry=\"'+coarseV+'|'+fineV+'\">'+P(\"Test this pair\",\"اختبر هذا الزوج\")+'</button></div>');\n}\nfunction gsClashScreen(){\n  gsShell('<div class=\"gso-title\">'+P(\"These results don’t add up\",\"النتيجتين ما يتفقون\")+'</div>'\n    +'<div class=\"gso-sub\">'+P(\"A coarser grind always extracts less than a finer one — so the coarser cup can’t taste more extracted (bitter) than the finer cup. Something else changed between the two brews: pour speed, water temperature, or channeling.\",\"الطحنة الأخشن دائمًا تستخلص أقل من الأنعم — فما يصير الكوب الأخشن يطلع أكثر استخلاصًا (مر) من الأنعم. شيء ثاني اختلف بين التحضيرين: سرعة الصب، حرارة الماء، أو تقنية الصب.\")+'</div>'\n    +'<div class=\"gso-note\">'+P(\"Brew the same two settings again, keeping everything else identical — then tap how each tasted.\",\"حضّر نفس الرقمين مرة ثانية مع تثبيت كل شي آخر — ثم اضغط كيف طعم كل واحد.\")+'</div>'\n    +'<div class=\"gso-btns\"><button class=\"gso-ghost\" data-gsclose=\"1\">'+P(\"Stop here\",\"أوقف هنا\")+'</button><button class=\"gso-primary\" data-gsclear=\"1\">'+P(\"Taste again\",\"ذوّق مرة ثانية\")+'</button></div>');\n}\nfunction gsScore(t){return t===\"sour\"?-1:(t===\"bitter\"?1:0);}\nfunction gsetupFinish(){\n  if(gsetup.depth===\"thorough\"){\n    var s1=parseFloat(gsetup.coarseSet),s2=parseFloat(gsetup.fineSet);\n    var t1=gsetup.coarseTaste,t2=gsetup.fineTaste;\n    var cS,fS,cT,fT;\n    if(s1>=s2){cS=s1;cT=t1;fS=s2;fT=t2;}else{cS=s2;cT=t2;fS=s1;fT=t1;}\n    var step=gsRangeStep();\n    if(gsScore(cT)>gsScore(fT)){gsetup.best=undefined;gsetup.step=\"result\";gsClashScreen();return;}\n    if(cT===\"sour\"&&fT===\"sour\"){gsetup.best=undefined;gsetup.step=\"result\";gsRetryScreen(\"finer\",gsClamp(fS-step),gsClamp(fS-step*2));return;}\n    if(cT===\"bitter\"&&fT===\"bitter\"){gsetup.best=undefined;gsetup.step=\"result\";gsRetryScreen(\"coarser\",gsClamp(cS+step*2),gsClamp(cS+step));return;}\n    if(cT===\"balanced\"&&fT===\"balanced\"){\n      var mid=gsClamp(Math.round((cS+fS)/2*10)/10);gsetup.best=mid;gsetup.step=\"result\";\n      var span=parseFloat(gsetup.max)-parseFloat(gsetup.min);var wide=(cS-fS)>Math.abs(span)*0.25;\n      gsFoundScreen(mid,wide?P(\"Both cups tasted good that far apart — this coffee is forgiving, so anywhere in that band works. We took the middle.\",\"الكوبين طلعوا زينين مع الفرق الكبير — هذه القهوة متسامحة، فأي رقم بينهما ينفع. أخذنا المنتصف.\"):P(\"Both landed well — we took the middle of the two.\",\"الاثنين طلعوا زينين — أخذنا المنتصف بينهما.\"));return;\n    }\n    if(cT===\"sour\"&&fT===\"balanced\"){gsetup.best=gsClamp(fS);gsetup.step=\"result\";gsFoundScreen(gsetup.best,\"\");return;}\n    if(cT===\"balanced\"&&fT===\"bitter\"){gsetup.best=gsClamp(cS);gsetup.step=\"result\";gsFoundScreen(gsetup.best,\"\");return;}\n    if(cT===\"sour\"&&fT===\"bitter\"){gsetup.best=gsClamp(Math.round((cS+fS)/2*10)/10);gsetup.step=\"result\";gsFoundScreen(gsetup.best,P(\"Your target sits between the two — the coarse cup was under-extracted, the fine one over.\",\"هدفك بين الرقمين — الأخشن ناقص استخلاص والأنعم زائد.\"));return;}\n    gsetup.best=gsClamp(Math.round((cS+fS)/2*10)/10);gsetup.step=\"result\";gsFoundScreen(gsetup.best,\"\");return;\n  }else{\n    var v=parseFloat(gsetup.oneSet),t=gsetup.oneTaste,qs=gsQuickStep();\n    if(t===\"balanced\"){gsetup.best=gsClamp(v);gsetup.step=\"result\";gsFoundScreen(gsetup.best,\"\");return;}\n    var nb=(t===\"sour\")?gsClamp(v-qs):gsClamp(v+qs);gsetup.best=nb;gsetup.step=\"result\";\n    gsFoundScreen(nb,(t===\"sour\")?P(\"Your cup was under-extracted — try this finer setting. Brew it again to confirm, and adjust from here.\",\"كوبك كان أقل استخلاصه للقهوة، جرّب هذه الدرجة الأنعم. حضّرها مرة ثانية للتأكيد، وعدّل من هنا.\"):P(\"Your cup was over-extracted — try this coarser setting. Brew it again to confirm, and adjust from here.\",\"كوبك كان زايد استخلاصه للقهوة، جرّب هذه الدرجة الأخشن. حضّرها مرة ثانية للتأكيد، وعدّل من هنا.\"));return;\n  }\n}\nfunction gsetupSave(){\n  var mn=parseFloat(gsetup.min),mx=parseFloat(gsetup.max),best=gsetup.best;\n  var id=\"my-\"+Date.now();\n  // model: base is the midpoint of range mapped so that notch 0 gives roughly the book-medium; we store best as base and a per-notch step\n  var range=mx-mn;var step=Math.max(0.1,Math.round(range/12*10)/10);\n  var g={id:id,type:\"manual\",label:gsetup.name,base:best,step:step,unit:gsetup.unit===\"numbers\"?\"\":gsetup.unit,min:mn,max:mx,custom:true,wf:P(\"Your calibrated grinder. Trust your dialed number; adjust by taste.\",\"مطحنتك المعايَرة. ثق برقمك؛ عدّل بالذوق.\")};\n  MYGRINDERS.push(g);state.grinder=id;persist();closeGsetup();renderAll();\n}\nfunction openGsetup(){gsetup={step:\"basics\",name:\"\",unit:\"clicks\",min:\"\",max:\"\",depth:null,coarseSet:\"\",coarseTaste:\"\",fineSet:\"\",fineTaste:\"\",oneSet:\"\",oneTaste:\"\"};renderGsetup();}\nfunction closeGsetup(){gsetup=null;var o=document.getElementById(\"gsetupOverlay\");o.style.display=\"none\";o.innerHTML=\"\";}\nfunction gsField(label,inner){return '<div class=\"gso-field\"><label class=\"gso-l\">'+label+'</label>'+inner+'</div>';}\nfunction renderGsetup(){\n  if(!gsetup)return;\n  var o=document.getElementById(\"gsetupOverlay\");o.style.display=\"\";\n  var body=\"\";\n  if(gsetup.step===\"basics\"){\n    body='<div class=\"gso-title\">'+P(\"Set up your grinder\",\"إعداد مطحنتك\")+'</div>'\n      +'<div class=\"gso-sub\">'+P(\"Tell me about your grinder, then we’ll dial it in with a quick taste test.\",\"عرّفني على مطحنتك، ثم نضبطها باختبار تذوّق سريع.\")+'</div>'\n      +gsField(P(\"Grinder name *\",\"اسم المطحنة *\"),'<input id=\"gsName\" class=\"gso-input\" placeholder=\"'+P(\"e.g. Timemore C3\",\"مثل Timemore C3\")+'\" value=\"'+gsetup.name+'\">')\n      +gsField(P(\"What are its units?\",\"ما وحداته؟\"),'<select id=\"gsUnit\" class=\"gso-input\"><option value=\"clicks\"'+(gsetup.unit===\"clicks\"?\" selected\":\"\")+'>'+P(\"clicks (mostly manual grinders)\",\"نقرات (غالبًا المطاحن اليدوية)\")+'</option><option value=\"numbers\"'+(gsetup.unit===\"numbers\"?\" selected\":\"\")+'>'+P(\"numbers (mostly electric grinders)\",\"أرقام (غالبًا المطاحن الكهربائية)\")+'</option></select>')\n      +'<div class=\"gso-row\">'+gsField(P(\"Lowest (finest) *\",\"الأدنى (الأنعم) *\"),'<input id=\"gsMin\" class=\"gso-input\" inputmode=\"decimal\" placeholder=\"0\" value=\"'+gsetup.min+'\">')+gsField(P(\"Highest (coarsest) *\",\"الأعلى (الأخشن) *\"),'<input id=\"gsMax\" class=\"gso-input\" inputmode=\"decimal\" placeholder=\"40\" value=\"'+gsetup.max+'\">')+'</div>'\n      +'<div class=\"gso-btns\"><button class=\"gso-ghost\" data-gsclose=\"1\">'+P(\"Cancel\",\"إلغاء\")+'</button><button class=\"gso-primary\" data-gsbasics=\"1\">'+P(\"Next\",\"التالي\")+' →</button></div>';\n  }else if(gsetup.step===\"depth\"){\n    body='<div class=\"gso-title\">'+P(\"How thorough?\",\"ما مدى الدقة؟\")+'</div>'\n      +'<div class=\"gso-sub\">'+P(\"Both work. Two brews pinpoint it; one gets you close.\",\"الاثنان ينفعان. صبّتان تحدّدانه بدقة؛ وواحدة تقرّبك.\")+'</div>'\n      +'<button class=\"gso-card\" data-gsdepth=\"thorough\"><b>'+P(\"Thorough · 2 brews\",\"دقيق · صبّتان\")+'</b><span>'+P(\"Brew coarse, brew fine, taste both. Most accurate.\",\"اطحن خشن، اطحن ناعم، ذوّق الاثنين. الأدقّ.\")+'</span></button>'\n      +'<button class=\"gso-card\" data-gsdepth=\"quick\"><b>'+P(\"Quick · 1 brew\",\"سريع · صبّة واحدة\")+'</b><span>'+P(\"One brew, tell me how it tasted, I point you the right way.\",\"صبّة واحدة، قلّي كيف طعمها، وأدلّك على الاتجاه.\")+'</span></button>'\n      +'<div class=\"gso-btns\"><button class=\"gso-ghost\" data-gsback=\"basics\">'+P(\"Back\",\"رجوع\")+'</button></div>';\n  }else if(gsetup.step===\"test\"){\n    body=gsetupTestHtml();\n  }\n  o.innerHTML='<div class=\"gso-inner\">'+body+'</div>';\n  var nm=document.getElementById(\"gsName\");if(nm)nm.focus();\n}\nfunction allGrinders(){return GRINDERS.concat(MYGRINDERS);}\nfunction grinderById(id){return allGrinders().find(function(x){return x.id===id;});}\nfunction grindCalHtml(rec){\n  try{\n  var g=grinderById(state.grinder);\n  if(!g||g.byFeel||g.stepless)return \"\";\n  var off=GRINDOFF[g.id]||0;\n  var unit=tr(g.unit||\"\");\n  if(gcalOpen){\n    var cur=parseFloat(rec.grindNumber);\n    return '<div class=\"gcal gcal-open\"><div class=\"gcal-q\">'+P(\"This recipe shows \",\"الوصفة تعطيك \")+'<b>'+rec.grindNumber+'</b>. '+P(\"What do you actually dial on your \"+g.label+\"?\",\"ما الرقم الذي تضبطه فعلًا على \"+g.label+\"؟\")+(g.micro?P(\" (for a click past a number, type like 9.1 or 9.2)\",\" (لنقرة بعد رقم، اكتب مثل 9.1 أو 9.2)\"):\"\")+'</div>'\n      +'<div class=\"gcal-row\"><input id=\"gcalInput\" class=\"gcal-input\" inputmode=\"decimal\" placeholder=\"'+rec.grindNumber+'\"><button class=\"gcal-save\" data-gcalsave=\"1\">'+P(\"Save\",\"حفظ\")+'</button></div>'\n      +'<div class=\"gcal-hint\">'+P(\"I’ll shift every recipe on this grinder by the difference — coarser or finer, it carries through.\",\"سأزيح كل وصفة على هذه المطحنة بمقدار الفرق — أخشن أو أنعم، يسري على الكل.\")+'</div></div>';\n  }\n  if(off!==0){\n    var sign=off>0?\"+\":\"\";\n    return '<div class=\"gcal gcal-set\"><span class=\"gcal-badge\">'+P(\"Tuned to your \"+g.label,\"معايَر لـ \"+g.label)+' ('+sign+off+' '+unit+')</span> <button class=\"gcal-link\" data-gcalopen=\"1\">'+P(\"change\",\"تغيير\")+'</button> <button class=\"gcal-link\" data-gcalreset=\"1\">'+P(\"reset\",\"تصفير\")+'</button></div>';\n  }\n  return '<div class=\"gcal\"><button class=\"gcal-link\" data-gcalopen=\"1\">'+P(\"Not your number? Tell me what you dial →\",\"مو رقمك؟ قلي وش تضبط فعلًا →\")+'</button></div>';\n  }catch(e){return \"\";}\n}\nfunction grindSetting(g,notch){if(!g||g.byFeel)return{mode:\"feel\"};if(g.stepless)return{mode:\"stepless\"};var off=(g&&GRINDOFF[g.id])?GRINDOFF[g.id]:0;var v=clamp(g.base+notch*g.step+off,g.min,g.max);if(g.micro){var whole=Math.floor(v);var frac=v-whole;var clicks=Math.round(frac*g.micro);if(clicks>=g.micro){whole+=1;clicks=0;}if(whole>g.max){whole=g.max;clicks=0;}var clkWord=(lang===\"ar\")?\"نقرة\":(\"click\"+(clicks>1?\"s\":\"\"));var disp=(clicks===0)?String(whole):(String(whole)+\" · \"+clicks+\" \"+clkWord);return{mode:\"number\",value:disp,numeric:whole+clicks/g.micro,micro:g.micro,offset:off};}var snapped;if(g.step>=1){snapped=Math.round(v);}else{snapped=Math.round(v/g.step)*g.step;snapped=Math.round(snapped*10)/10;}return{mode:\"number\",value:Number.isInteger(snapped)?String(snapped):snapped.toFixed(1),numeric:snapped,offset:off}}\nfunction grindLabel(g,notch,roast){const r=grindSetting(g,notch);if(r.mode===\"number\")return (r.value+\" \"+tr(g.unit||\"\")).trim();if(r.mode===\"stepless\")return P(\"Start \",\"ابدأ من \")+tr(g.baseDesc);return tr(roast.grind)+P(\" (by feel)\",\" (بالتقدير)\")}\nfunction grindSizeOf(notch){var b=clamp(notch+3,0,6);var lab=[\"Fine\",\"Medium-fine\",\"Medium-fine\",\"Medium\",\"Medium-coarse\",\"Coarse\",\"Coarse\"][b];var ref=[\"like caster sugar\",\"like table salt\",\"like fine sand\",\"like granulated sugar\",\"like coarse sand\",\"like raw sea salt\",\"like kosher salt\"][b];return{label:lab,ref:ref,level:b}}\nfunction grindLimit(g,notch,dir){if(!g||g.byFeel||g.stepless)return false;var v=clamp(g.base+notch*g.step,g.min,g.max);return dir<0?(v<=g.min):(v>=g.max);}\nfunction buildSchedule(roast,goal,bloomWater,bloomTime,totalWater,strengthId){const out=[];if(goal.method===\"everyday\"){var eAfter=totalWater-bloomWater,eStep=eAfter/3;var e1=Math.round(bloomWater+eStep),e2=Math.round(bloomWater+eStep*2);out.push({t:0,label:\"Bloom\",to:bloomWater,note:P(\"Wet every ground, then a gentle swirl. Let it breathe.\",\"بلّل كل البن ثم دوّر بهدوء. خلّيها تتنفّس.\")});out.push({t:bloomTime,label:\"Pour 1\",to:e1,note:P(\"A gentle, even pour — keep the water level steady, never let it run dry.\",\"صبّة هادية ومتساوية — خلّي مستوى الماء ثابت، ولا تخلّيه يجف.\")});out.push({t:bloomTime+40,label:\"Pour 2\",to:e2,note:P(\"Same calm pour again. Little and often keeps it even.\",\"نفس الصبّة الهادية. شوي شوي يخلّيها متزنة.\")});out.push({t:bloomTime+80,label:\"Pour 3\",to:totalWater,note:P(\"Last pour to full. One gentle swirl, then let it drain.\",\"آخر صبّة للنهاية. دوّرة خفيفة، ثم خلّيها تصفّي.\")});let prevE=0;return out.map(function(x){var pour=x.to-prevE;prevE=x.to;return{t:x.t,label:x.label,pour:pour,cum:x.to,note:x.note};});}if(goal.method===\"osamah\"){out.push({t:0,label:\"Bloom\",to:Math.round(totalWater*0.1429),note:\"Saturate every ground, then swirl gently.\"});out.push({t:55,label:\"Pour 1\",to:Math.round(totalWater*0.6349),note:\"Slow, steady spiral — take your time, about 25 seconds.\"});out.push({t:95,label:\"Pour 2\",to:Math.round(totalWater*0.7937),note:\"Short, gentle pulse.\"});out.push({t:120,label:\"Pour 3\",to:totalWater,note:\"Top up to full, then a gentle final swirl.\"});}else if(goal.method===\"fifty\"){out.push({t:0,label:\"Bloom\",to:bloomWater,note:\"Saturate every ground, then swirl gently.\"});out.push({t:bloomTime,label:\"Pour\",to:totalWater,note:\"One steady pour straight to full — simple and even. Give it a gentle swirl to settle.\"})}else if(goal.method===\"hoffmann\"){const sixty=Math.round(totalWater*0.6);out.push({t:0,label:\"Bloom\",to:bloomWater,note:\"Saturate every ground, then swirl gently.\"});out.push({t:bloomTime,label:\"Pour 1\",to:sixty,note:P(\"This one is quick but steady — Hoffmann pours 60% at a good pace in even spirals. Keep the stream moving; a little agitation here is good.\",\"هذه صبّة سريعة بطبيعتها — هوفمان يسكب 60% بإيقاع سريع نسبيًا بدوائر ثابتة. أبقِ التدفق مستمرًا؛ وقليل من التحريك هنا مطلوب.\")});out.push({t:bloomTime+30,label:\"Pour 2\",to:totalWater,note:P(\"Now slower and gentler — top up to full by ~\"+fmt(bloomTime+60)+\", keeping the cone full. Then stir once each way and give a final swirl.\",\"الآن أبطأ وألطف — كمّل حتى الامتلاء بحلول ~\"+fmt(bloomTime+60)+\" مع إبقاء المخروط ممتلئًا. ثم حرّك مرة بكل اتجاه وأعطِ تدويرة أخيرة.\")})}else{const W=totalWater,big=goal.id===\"brighter\";const p1=Math.round(W*(big?0.24:0.16)),fortyTo=Math.round(W*0.4),n=(strengthId===\"light\"?1:(strengthId===\"strong\"?3:2));out.push({t:0,label:\"Pour 1\",to:p1,note:big?\"Bigger first pour leans fruity. Swirl.\":\"Smaller first pour leans sweeter. Swirl.\"});out.push({t:bloomTime,label:\"Pour 2\",to:fortyTo,note:(goal.id===\"brighter\"?\"A smaller second pour completes the 40% — the big first pour tips it toward acidity.\":\"A bigger second pour completes the 40% — the small first pour tips it toward sweetness.\")});for(let i=1;i<=n;i++)out.push({t:bloomTime+45*i,label:\"Pour \"+(2+i),to:Math.min(Math.round(fortyTo+(W-fortyTo)*(i/n)),W),note:i===n?\"Final pour to full volume.\":\"Strength-building pour.\"})}let prev=0;return out.map((s)=>{const pour=s.to-prev;prev=s.to;return{t:s.t,label:s.label,pour,cum:s.to,note:s.note}})}\nfunction buildScheduleImmersion(brewer,dose,bloomTime,totalWater){const out=[];if(brewer.id===\"aeropress\"){const wet=Math.min(Math.round(dose*4),totalWater);out.push({t:0,label:\"Bloom\",to:wet,note:\"Add water, stir 3×\"});out.push({t:15,label:\"Pour\",to:totalWater,note:\"Top to \"+totalWater+\"g, seat the plunger\"});out.push({t:25,label:\"Steep\",to:totalWater,note:\"Steep ~60s\"});out.push({t:85,label:\"Press\",to:totalWater,note:\"Press slowly over ~30s\"})}else{const bloom=Math.round(dose*3);out.push({t:0,label:\"Bloom\",to:bloom,note:\"Valve closed; bloom and swirl\"});out.push({t:bloomTime,label:\"Pour\",to:totalWater,note:P(\"Fill to \"+totalWater+\"ml, valve closed\",\"عبّي إلى \"+totalWater+\" مل والصمام مغلق\")});out.push({t:bloomTime+45,label:\"Steep\",to:totalWater,note:\"Steep until ~1:45\"});out.push({t:105,label:\"Release\",to:totalWater,note:\"Open the valve to drain\"})}let prev=0;return out.map((s)=>{const pour=s.to-prev;prev=s.to;return{t:s.t,label:s.label,pour,cum:s.to,note:s.note}})}\nfunction buildRecipe(state){const roast=ROASTS.find(x=>x.id===state.roast),strength=STRENGTHS.find(x=>x.id===state.strength),goal=GOALS.find(x=>x.id===state.goal),grinder=allGrinders().find(x=>x.id===((({\"1z-jmax\":\"1z-j\",\"1z-jultra\":\"1z-j\"})[state.grinder])||state.grinder))||GRINDERS[0];const brewer=BREWERS.find(x=>x.id===state.brewer)||BREWERS[0];const isBlend=state.kind===\"blend\";const process=isBlend?null:PROCESSES.find(x=>x.id===state.process),origin=isBlend?null:ORIGINS.find(x=>x.id===state.origin),blend=isBlend?BLENDS.find(x=>x.id===state.blendStyle):null;const dose=state.dose,degas=process?process.degas:2,fresh=freshnessVerdict(state.days,roast.rest,degas);const isIced=(state.serve===\"iced\"&&brewer.kind===\"pour\");let temp=roast.temp;temp+=(fresh.id===\"stale\"?2:(fresh.id===\"aging\"?1:0));if(process&&(process.id===\"anaerobic\"||process.id===\"coferment\"||process.id===\"decaf\"))temp-=1;temp=clamp(temp+((origin&&origin.temp)||0)+((blend&&blend.temp)||0)+brewer.tempOff+((!isIced&&goal&&goal.tempOff)||0)+(state.tempAdj||0),82,100);let ratio=strength.ratio;let totalWater=0;const bloomWater=Math.round(dose*roast.bloomMult);if(goal.id===\"osamah\"&&!isIced)ratio=({light:16.75,balanced:15.75,strong:15.0})[strength.id]||15.75;totalWater=Math.round(dose*ratio*(brewer.ratioMul||1));const bloomTime=clamp(({fresh:50,ideal:45,aging:40,stale:35})[fresh.id]-degas,30,50);var doseNotch=Math.round((dose-15)/8);let notch=roast.notch+((origin&&origin.notch)||0)+((blend&&blend.notch)||0)+brewer.grindOff+((!isIced&&goal&&goal.grindOff)||0)+doseNotch+(state.grindAdj||0);notch-=(fresh.id===\"stale\"?2:(fresh.id===\"aging\"?1:0));\nvar iced=isIced,icedStyle=state.icedStyle||\"hoffmann\",iceFrac=0,brewWater=totalWater,iceWeight=0,icedGoal=goal,icedLabel=\"\";\nif(iced){if(icedStyle===\"hoffmann\"){iceFrac=0.40;icedGoal=GOALS.find(function(g){return g.id===\"everyday\"});icedLabel=\"Hoffmann iced\";}else if(icedStyle===\"foursix\"){iceFrac=0.40;icedGoal=GOALS.find(function(g){return g.id===\"brighter\"});icedLabel=\"Kasuya 4:6 iced\";}else{iceFrac=0.50;icedGoal={id:\"fifty\",label:\"50/50\",method:\"fifty\"};icedLabel=\"50/50 flash\";}brewWater=Math.round(totalWater*(1-iceFrac));iceWeight=totalWater-brewWater;notch+=(strength.id===\"strong\"?-2:(strength.id===\"balanced\"?-1:0));temp=clamp(temp+1,82,100);}\nvar schedGoal=iced?icedGoal:goal;const schedule=brewer.kind===\"immersion\"?buildScheduleImmersion(brewer,dose,bloomTime,totalWater):buildSchedule(roast,schedGoal,bloomWater,bloomTime,brewWater,state.strength);const finishHigh=schedule[schedule.length-1].t+(brewer.kind===\"immersion\"?20:(schedGoal.method===\"hoffmann\"?Math.min(75+Math.round(2*dose),165):(schedGoal.method===\"fifty\"?70:(schedGoal.method===\"osamah\"?Math.max(20,Math.min(110,Math.round(35+1.5*(dose-20)))):(schedGoal.method===\"everyday\"?Math.round(50+0.8*(dose-15)):Math.round(30+0.8*(dose-15)))))))+(brewer.finishAdd||0);if(brewer.kind!==\"immersion\"&&schedule.length){var _lp=schedule[schedule.length-1];var _dt=_lp.t+5;var _fin=(schedGoal.method===\"osamah\"?fmt(finishHigh):fmt(Math.max(60,finishHigh-15)))+\"–\"+fmt(finishHigh+15);schedule.push({t:_dt,label:P(\"Drain\",\"التصفية\"),pour:0,cum:_lp.cum,noAmt:true,note:P(\"Let it draw down on its own — no more pouring. Done when the dripping stops (aim \"+_fin+\").\",\"خلّيها تصفّي لوحدها — بلا صب زيادة. خلاص لمّا يوقف التنقيط (الهدف \"+_fin+\").\")});}const methodShort=brewer.kind===\"immersion\"?\"immersion\":(goal.method===\"osamah\"?\"Osamah Alawwam\":(goal.method===\"hoffmann\"?\"classic\":(goal.id===\"brighter\"?\"fruity\":(goal.id===\"everyday\"?\"balanced\":\"sweet\"))));const agit={high:\"Light roasts cling to flavour — swirl after the bloom and after each pour, and pour from a little higher.\",medium:\"Swirl gently after the bloom and once at the end. Keep pours calm and central.\",low:\"Go gentle: low, soft pours and a single light swirl. This roast turns bitter if stirred hard.\"}[roast.agit];const freshTxt=(lang===\"ar\"?{fresh:\"الأفضل تركها ترتاح إلى اليوم \"+fresh.min+\" تقريبًا. إن حضّرتها الآن فتوقّع فورانًا قويًا ونكهات لم تكتمل بعد.\",ideal:\"في قمة نضجها (اليوم \"+fresh.min+\"–\"+fresh.max+\") — هذا أفضل وقت للتحضير.\",aging:\"بدأت النكهات تخفت — اطحن أنعم بدرجة وارفع الحرارة قليلًا.\",stale:\"تجاوزت ذروة تألقها، بس لا تزال قهوة زينة. اطحن أنعم شوي وارفع الحرارة عشان ترفعها. اطحن أنعم واستخدم ماء أسخن، ولا ترفع سقف التوقعات.\"}:{fresh:\"Best to rest until ~day \"+fresh.min+\". Brew now and expect a lively bloom and a slightly muted cup.\",ideal:\"Right in the sweet spot (day \"+fresh.min+\"–\"+fresh.max+\"). Brew with confidence.\",aging:\"Flavours are softening — grind one notch finer and run water a touch hotter.\",stale:\"Past its brightest, but still good coffee. Grind a touch finer and run water hot to lift it.\"})[fresh.id];var methodNote=brewer.kind===\"immersion\"?(brewer.id===\"aeropress\"?P(\"AeroPress immersion — steep, then press. Forgiving and quick; the timing isn't fussy.\",\"إيروبريس بالنقع — انقع ثم اضغط. طريقة متسامحة وسريعة، والتوقيت مو دقيق.\"):P(\"Switch immersion–drip — steep with the valve shut, then open to release. Relaxed and very forgiving.\",\"سويتش نقع وتقطير — انقع والصمام مسكّر، ثم افتحه ليسيل. مريحة ومتسامحة جدًا.\")):(goal.method===\"everyday\"?P(\"Everyday Balanced — a bloom and two calm, even pours. Few decisions, hard to get wrong: keep the grounds covered and don't rush. The most forgiving way to a clean, balanced cup.\",\"إوفريداي بالانس — تفتّح وصبّتين هاديتين ومتساويتين. قرارات قليلة وصعب تغلط فيها: خلّي البن مغطّى ولا تستعجل. ألطف طريقة لكوب نظيف ومتوازن.\"):(goal.method===\"osamah\"?P(\"Osamah Alawwam method — a generous, slow first pour to about 63%, then two short finishing pulses. Runs cooler with a slightly richer ratio for a sweet, full cup. Recipe by Osamah Alawwam (Roasting House owner).\",\"طريقة أسامة العوّام — صبّة أولى سخية وبطيئة تقارب 63%، وبعدها نبضتين قصيرتين للنهاية. حرارة أهدأ ونسبة أغنى شوي لكوب حلو وممتلئ. الوصفة من أسامة العوّام (صاحب بيت التحميص).\"):(goal.method===\"hoffmann\"?P(\"Hoffmann’s two-pour method. The first pour is quick but steady — you add most of the water at a good pace (to 60%) for even, turbulent extraction. The second is slower and gentler. The “rests” are the bloom and the final drawdown, not pauses between pours. If you’re new, the fast first pour is normal, not a mistake.\",\"طريقة هوفمان بصبّتين. الصبّة الأولى سريعة لكن ثابتة — تضيف معظم الماء بإيقاع جيد (حتى 60%) عشان استخلاص متساوٍ وفيه حركة. والثانية أبطأ وألطف. «فترات الراحة» هي التفتّح والتصفية الأخيرة، مو وقفات بين الصبّات. لو أنت مبتدئ، الصبّة الأولى السريعة شي طبيعي مو غلط.\"):(goal.id===\"balanced\"?P(\"4:6 method, even and forgiving — five small, relaxed pours with a rest between each. The gentlest way to a balanced cup; a great place to start. Recipe by Tetsu Kasuya.\",\"طريقة 4:6، متزنة ومتسامحة — خمس صبّات صغيرة ومرتاحة مع راحة بين كل وحدة. ألطف طريقة لكوب متوازن، وبداية ممتازة. الوصفة من تيتسو كاسويا.\"):(goal.id===\"brighter\"?P(\"4:6 method, bigger first pour — five small, relaxed pours with a rest between each. Leans fruity — more acidity and clarity. Recipe by Tetsu Kasuya.\",\"طريقة 4:6 بصبّة أولى أكبر — خمس صبّات صغيرة ومرتاحة مع راحة بين كل وحدة. تميل للفاكهية — حموضة أوضح ونقاء أكثر. الوصفة من تيتسو كاسويا.\"):P(\"4:6 method, smaller first pour — same relaxed five-pulse rhythm, weighted toward sweetness and body. Recipe by Tetsu Kasuya.\",\"طريقة 4:6 بصبّة أولى أصغر — نفس الإيقاع المرتاح بخمس نبضات، لكن مائل للحلاوة والقوام. الوصفة من تيتسو كاسويا.\"))))));\nif(iced)methodNote=P(icedLabel+\" — hot brew straight onto ice. Pour \"+brewWater+\"ml hot over \"+iceWeight+\"g ice (\"+Math.round(iceFrac*100)+\"% ice); the hot brew flash-chills and keeps the aromatics. Ground a touch finer for the melt.\",tr(icedLabel)+\" — قهوة حارة تنزل على الثلج مباشرة. اسكب \"+brewWater+\"مل ساخن على \"+iceWeight+\"غ ثلج (\"+Math.round(iceFrac*100)+\"% ثلج)؛ تبرد فورًا وتحافظ على عطرياتها. اطحن أنعم شوي عشان ذوبان الثلج.\");\nconst notes=[];notes.push({label:\"Method\",text:methodNote});if(doseNotch>0)notes.push({label:\"Dose & grind\",text:\"Bigger dose deepens the bed, so the grind is nudged coarser to keep extraction even. If it still tastes strong or bitter, go coarser still.\"});else if(doseNotch<0)notes.push({label:\"Dose & grind\",text:\"Smaller dose means a shallower bed, so the grind is nudged finer. If it tastes thin or weak, go finer still.\"});const tip=isBlend?blend.tip:origin.tip;if(tip)notes.push({label:isBlend?\"This blend\":\"This origin\",text:tip});if(!isBlend)notes.push({label:\"This process\",text:process.label+\": \"+process.tweak});notes.push({label:\"Agitation\",text:agit});notes.push({label:brewer.label,text:brewer.note});return{coffee:isBlend?tr(blend.label):tr(origin.label),dose,method:tr(brewer.label)+\" · \"+(iced?tr(icedLabel):tr(methodShort)),iced:iced,brewWater:brewWater,iceWeight:iceWeight,iceFrac:iceFrac,grinderLabel:grinder.label,grindNumber:grindLabel(grinder,notch,roast),grindNumeric:(grindSetting(grinder,notch).numeric!=null?grindSetting(grinder,notch).numeric:parseFloat(grindLabel(grinder,notch,roast))),grindSize:grindSizeOf(notch),grindWf:grinder.wf,temp,ratioStr:\"1:\"+ratio,totalWater,finishStr:fmt(finishHigh),finishSec:finishHigh,finishLo:(schedGoal.method===\"osamah\"?finishHigh:Math.max(60,finishHigh-15)),finishHi:finishHigh+15,finishRange:fmt(schedGoal.method===\"osamah\"?finishHigh:Math.max(60,finishHigh-15))+\"–\"+fmt(finishHigh+15),freshness:freshTxt,freshId:fresh.id,freshMin:fresh.min,freshMax:fresh.max,notch:notch,immersion:brewer.kind===\"immersion\",retainedEst:Math.round(2*dose),incupEst:Math.max(0,totalWater-Math.round(2*dose)),pours:schedule,notes}}\n\n// ============ STATE + UI ============\nvar lang=\"en\";\nvar TR={\n\"Serve\":\"التقديم\",\"Iced style\":\"نمط البارد\",\"Grinder\":\"المطحنة\",\"Brewer\":\"أداة التحضير\",\"Coffee type\":\"نوع القهوة\",\"Origin / variety\":\"المنشأ / الصنف\",\"Process\":\"المعالجة\",\"Tasting notes — from the bag (optional)\":\"إيحاءات القهوة — من الكيس (اختياري)\",\"Roast level\":\"درجة التحميص\",\"Roast date\":\"تاريخ التحميص\",\"Days since roast\":\"عدد الأيام من تاريخ التحميص\",\"Dose (g)\":\"كمية القهوة (غ)\",\"Strength\":\"القوة\",\"Brew Style\":\"أسلوب التحضير\",\"Light\":\"فاتح\",\"Med-Light\":\"فاتح–متوسط\",\"Medium\":\"متوسط\",\"Med-Dark\":\"متوسط–غامق\",\"Dark\":\"غامق\",\n\"Washed\":\"مغسولة\",\"Honey\":\"عسلية\",\"Natural\":\"طبيعية (مجففة)\",\"Anaerobic\":\"لا هوائية\",\n\"Lighter\":\"أخف\",\"Balanced\":\"متوازن\",\"Stronger\":\"أقوى\",\n\"Sweeter\":\"أحلى\",\n\"V60\":\"V60\",\"Kalita Wave\":\"كاليتا ويف\",\"Chemex\":\"كيمكس\",\"AeroPress\":\"إيروبريس\",\"Switch\":\"سويتش\",\n\"Filter / pour-over blend\":\"خلطة فلتر / تقطير\",\"Espresso blend\":\"خلطة إسبريسو\",\"House / breakfast blend\":\"خلطة البيت / الإفطار\",\n\"Single origin\":\"منشأ واحد\",\"Blend\":\"خلطة\",\"Hot\":\"حار\",\"Iced (flash)\":\"بارد\",\"Hoffmann\":\"هوفمان\",\"Kasuya 4:6\":\"كاسويا 4:6\",\"50 / 50\":\"50 / 50\",\n\"Ethiopia\":\"إثيوبيا\",\"Kenya\":\"كينيا\",\"Colombia\":\"كولومبيا\",\"Peru\":\"بيرو\",\"Brazil\":\"البرازيل\",\"Guatemala\":\"غواتيمالا\",\"Costa Rica\":\"كوستاريكا\",\"Rwanda / Burundi\":\"رواندا / بوروندي\",\"Panama Gesha\":\"جيشا بنما\",\"Yemen\":\"اليمن\",\"Saudi Arabia (Khawlani)\":\"السعودية — خولاني (جازان · عسير · الباحة)\",\"Indonesia / Sumatra\":\"إندونيسيا / سومطرة\",\"Vietnam\":\"فيتنام\",\"Honduras\":\"هندوراس\",\"Tanzania / Uganda\":\"تنزانيا / أوغندا\",\"Mexico\":\"المكسيك\",\"blackcurrant, bright, juicy\":\"كشمش أسود، إشراق، عصيرية\",\"nutty, gentle citrus, light body\":\"مكسرات، حمضيات لطيفة، قوام خفيف\",\"El Salvador\":\"السلفادور\",\"India\":\"الهند\",\"Single — other / unsure\":\"منشأ واحد — أخرى / غير متأكد\",\n\"Other / by feel\":\"أخرى\",\n\"Temp\":\"الحرارة\",\"Water\":\"الماء\",\"Hot water\":\"ماء ساخن\",\"Ice\":\"ثلج\",\"Dose\":\"الجرعة\",\"Ratio\":\"النسبة\",\"Est. in cup\":\"في الفنجان ~\",\"Brew time\":\"زمن التحضير\",\"Pour timeline\":\"جدول الصبّ\",\"Why this recipe?\":\"لماذا هذه الوصفة؟\",\"▶ Start pour timer\":\"▶ ابدأ مؤقّت الصبّ\",\n\"Method\":\"الطريقة\",\"Dose & grind\":\"كمية القهوة والطحن\",\"This origin\":\"هذا المنشأ\",\"This blend\":\"هذه الخلطة\",\"This process\":\"هذه المعالجة\",\"Agitation\":\"التحريك\",\n\"How did it taste? Tap to dial in the next brew\":\"كيف كان الطعم؟ اضغط وسنضبط التحضير القادم\",\n\"Sour / sharp\":\"حامض / حاد\",\"Bitter / harsh\":\"مرّ / خشن\",\"Weak / watery\":\"ضعيف / مائي\",\"Too strong\":\"قوي جدًا\",\"Flat / no clarity\":\"باهت / بلا وضوح\",\"Notes missing\":\"النكهات غائبة\",\"Tasted great ✓\":\"طعمها رائع ✓\",\n\"Sour\":\"حامض\",\"Bitter\":\"مرّ\",\"Weak\":\"ضعيف\",\"Flat\":\"باهت\",\"Dialed in ✓\":\"مضبوطة ✓\",\"logged\":\"مُسجّل\",\n\"After the brew · weigh your cup (optional)\":\"بعد التحضير · زِن فنجانك (اختياري)\",\"Water poured (ml)\":\"الماء المصبوب (مل)\",\"Coffee in cup (ml)\":\"القهوة في الفنجان (مل)\",\"weigh it\":\"زِنها\",\n\"★ Save this bag\":\"★ احفظ هذه الوصفة\",\"Save\":\"حفظ\",\"name this bag\":\"سمِّ هذا الكيس\",\"start a new bag\":\"ابدأ كيسًا جديدًا\",\n\"Learn\":\"تعلّم\",\"← Build\":\"← التحضير\",\"Your bags\":\"أكياسك\",\"Load\":\"تحميل\",\n\"The five that matter most\":\"الخمسة الأهم\",\"Glossary\":\"المصطلحات\",\"What you actually need\":\"ما تحتاجه فعلًا\",\n\"The basics that matter.\":\"الأساسيات المهمة.\",\"Manual\":\"يدوية\",\"Electric\":\"كهربائية\",\"Grind\":\"الطحن\",\"Why brew time matters\":\"لماذا وقت التحضير مهم\",\"What it is\":\"وش يعني؟\",\"The total time from the first drop of water to an empty, drained bed. You never control it directly — it is the result of your grind, your dose, and how you pour.\":\"الوقت الكامل من أول قطرة ماء حتى جفاف الطبقة وتصريفها. أنت لا تتحكم به مباشرة — إنه نتيجة الطحنة والكمية وطريقة الصبّ.\",\"Why it matters\":\"لماذا يهم\",\"Water needs enough contact time to dissolve the sweetness out of the coffee. Brew time is the clearest sign of whether that contact actually happened.\":\"الماء يحتاج وقت تلامس كافيًا ليُذيب الحلاوة من القهوة. وقت التحضير هو أوضح دليل على أن هذا التلامس حدث فعلًا.\",\"Way too fast\":\"أسرع بكثير من اللازم\",\"Water raced through without extracting enough — expect a weak, sour, thin cup. Usual causes: grind too coarse, or channeling from uneven pouring.\":\"نزل الماء بسرعة دون استخلاص كافٍ — غالبًا بيطلع الفنجان خفيف، حامض، وناقص استخلاص. الأسباب المعتادة: طحن أخشن من اللازم، أو قنوات بسبب صبّ غير متساوٍ.\",\"Way too slow\":\"أبطأ بكثير من اللازم\",\"Water sat on the coffee too long and kept stripping harsh compounds — expect bitter, dry, muddy. Usual causes: grind too fine, too much agitation, or a clogged filter.\":\"جلس الماء فوق القهوة فترة أطول من اللازم، وكمل يسحب نكهات مرة وخشنة — توقّع مرارة وجفافًا وعكارة. الأسباب المعتادة: طحن أنعم من اللازم، أو تحريك زائد، أو انسداد الفلتر.\",\"Fix the cause, not the clock\":\"عالج السبب لا الساعة\",\"You do not fix time directly — adjust the grind and time follows. Finishing near the expected time with an even bed is the real target.\":\"لا تحاول تعدل الوقت نفسه — عدّل الطحنة والوقت بيتعدل معها. الهدف الحقيقي هو الانتهاء قرب الوقت المتوقع مع طبقة متساوية.\",\"Taste is the judge\":\"الطعم هو الحكم\",\"A rough guide: within about 30 seconds of the recipe finish time is normal. If the time looked off but the cup tastes great — trust the cup. Time is a guide, taste decides.\":\"قاعدة تقريبية: أي نتيجة ضمن نحو 30 ثانية من وقت النهاية في الوصفة طبيعية. وإن بدا الوقت خاطئًا والطعم رائعًا — اعتمد على الطعم. الوقت دليل، والطعم هو الأساس.\",\"Pour timer\":\"مؤقّت الصبّ\",\"Machine\":\"الآلة\",\"Wet-hulled (Sumatra)\":\"التقشير الرطب (سومطرة)\",\"earthy, herbal, heavy body, low acidity\":\"ترابية، عشبية، قوام ثقيل، حموضة منخفضة\",\"Body over brightness — standard pours; expect a slow, muddy-looking bed.\":\"القوام قبل الإشراق — صبات عادية؛ وتوقّع سريرًا بطيئًا داكن المظهر.\",\"Decaf (any method)\":\"منزوعة الكافيين (أي طريقة)\",\"softer, rounder version of the bean\":\"نسخة أنعم وأدفأ من الحبة\",\"Porous beans extract fast — brewed cooler; go coarser before anything else if bitter.\":\"الحبوب المسامية تُستخلص بسرعة — تُحضَّر أبرد؛ وإن ظهرت مرارة فاجعل الخشونة أول علاج.\",\"Wet-hulled (Giling Basah)\":\"التقشير الرطب (جيلينغ باساه)\",\"Sumatra’s method: the parchment is stripped while the bean is still wet and soft, then dried bare. It trades acidity for weight — earthy, herbal, syrupy cups. If the bag says Sumatra and tastes like a forest floor in the best way, this is why.\":\"طريقة سومطرة: يُنزع الغلاف والحبة ما زالت رطبة وطرية، ثم تُجفف عارية. تستبدل الحموضة بالوزن — أكواب ترابية عشبية كثيفة. إن قال الكيس سومطرة وذاقت كأرض غابة بأجمل معنى، فهذا هو السبب.\",\"Decaf\":\"منزوعة الكافيين\",\"Caffeine is removed before roasting (Swiss Water, CO2, or EA methods). The processing leaves beans porous and fast-extracting, so decaf turns bitter easily — the app brews it a degree cooler, and coarser is the first fix if it still bites.\":\"يُنزع الكافيين قبل التحميص (بطرق المياه السويسرية أو ثاني أكسيد الكربون أو EA). تترك المعالجة الحبوب مسامية سريعة الاستخلاص، فتميل منزوعة الكافيين إلى المرارة بسهولة — يُحضّرها التطبيق أبرد بدرجة، والخشونة أول علاج إن بقيت المرارة.\",\"Thailand\":\"تايلاند\",\"mild, sweet, chocolate-nut, gentle fruit\":\"لطيفة، حلوة، شوكولاتة ومكسرات، فواكه هادئة\",\"Co-fermented / Infused\":\"تخمير مشترك / منكّهة\",\"loud added aromatics riding over the base coffee\":\"عطريات مضافة صاخبة فوق القهوة الأساس\",\"Keep it cool and gentle — added aromatics turn harsh fast.\":\"أبقها باردة ولطيفة — العطريات المضافة تتحول لقسوة بسرعة.\",\"Co-fermented: fruit, spices, or specific yeasts are added to the fermentation tank so the flavor develops inside the seed. Infused: flavor is added after processing. Both give loud, unmistakable aromatics — and honest roasters disclose which one you are holding. Brewed slightly cooler so the added notes stay pleasant instead of harsh.\":\"التخمير المشترك: تُضاف فواكه أو توابل أو خمائر محددة إلى خزان التخمير فتتكوّن النكهة داخل الحبة. المنكّهة: تُضاف النكهة بعد المعالجة. كلاهما يعطي عطريات صاخبة لا تُخطئها الأذن — والمحامص الصادقة تفصح أيهما بين يديك. تُحضَّر أبرد قليلًا لتبقى النكهات المضافة لطيفة بدل أن تقسو.\",\"Origin, roast, and the date — one chain\":\"المنشأ والتحميص والتاريخ — سلسلة واحدة\",\"Origin sets the bean\":\"المنشأ يحدد الحبة\",\"Altitude and variety decide density and character. Roasters pick the roast level to flatter it: bright, dense coffees (Ethiopia, Kenya) usually go lighter to protect florals; softer, nutty ones (Brazil) take medium-dark gracefully. That is why you rarely meet a dark Gesha.\":\"الارتفاع والسلالة يحددان كثافة الحبة وطابعها. والمحمصون يختارون درجة التحميص لتُبرز هذا الطابع: القهوة الكثيفة المشرقة (إثيوبيا وكينيا) غالبًا تُحمّص فاتحة لحماية الزهور، واللينة المكسراتية (البرازيل) تتقبل التحميص الأغمق بأناقة. لهذا نادرًا ما تقابل جيشا غامقة.\",\"Roast sets the clock\":\"التحميص يضبط الساعة\",\"Darker roasts are more porous and release their CO2 faster — they peak earlier and fade sooner. Light roasts trap gas in dense structure: they need longer rest and stay good longer. Process nudges the same clock — naturals usually want a few extra days.\":\"التحميص الغامق أكثر مسامية فيُطلق غازاته أسرع — يبلغ ذروته مبكرًا ويذبل مبكرًا. والفاتح يحبس الغاز في بنية كثيفة: يحتاج راحة أطول ويعيش أطول. والمعالجة تحرّك الساعة نفسها — الطبيعية غالبًا تريد أيامًا إضافية.\",\"The date tells you where you are\":\"التاريخ يخبرك أين أنت\",\"Day 20 can mean at its peak for a light washed coffee and past it for a dark roast. The number on the bag only means something combined with the roast and process.\":\"اليوم العشرون قد يعني «في القمة» لقهوة فاتحة مغسولة و«تعدّى ذروته» لتحميصة غامقة. الرقم على الكيس لا معنى له إلا مع التحميص والمعالجة.\",\"What the app does with this\":\"ماذا يفعل التطبيق بهذا\",\"Your rest window is computed from roast and process, the freshness stage nudges grind and temperature, and the widget counts the days for you. Enter the roast date once — the chain runs itself.\":\"نافذة الراحة تُحسب من التحميص والمعالجة، ومرحلة النضارة تعدّل الطحنة والحرارة، والودجت يعدّ الأيام عنك. أدخل تاريخ التحميص مرة واحدة — والسلسلة تعمل وحدها.\",\"Same temp\":\"حرارة ثابتة\",\"Hot → cooler\":\"حار ← أبرد\",\"Cool → hotter\":\"بارد ← أسخن\",\"None\":\"بدون\",\"Fellow Aiden\":\"فيلو أيدن\",\"xBloom\":\"إكس بلوم\",\"Paste an import code (CWS1...)\":\"الصق رمز استيراد (...CWS1)\",\"Import brew\":\"استورد الوصفة\",\"Skip\":\"تخطّي\",\"Pause\":\"إيقاف مؤقت\",\"Resume\":\"استئناف\",\"Reset\":\"إعادة\",\"Close\":\"إغلاق\",\"Swirl\":\"التدوير (Swirl)\",\"Hold the brewer or server and give it a gentle circular shake — like swirling juice in a glass — to level the bed and even out extraction. No spoon: stirring is a different, stronger move.\":\"أمسك القمع أو الوعاء ودوّره بحركة دائرية خفيفة — بحركة دائرية خفيفة حتى تستوي طبقة القهوة — عشان تستوي طبقة القهوة ويتساوى الاستخلاص. بدون ملعقة: التقليب بالملعقة حركة ثانية أقوى.\",\"How each process is made\":\"أنواع المعالجة وكيف تُصنع\",\"Natural (dry)\":\"طبيعية (مجففة)\",\"The fruit is stripped off the seed, the beans ferment in water tanks to loosen the last sticky layer, then they are washed clean and dried. You taste the bean itself: clean, clear, brighter acidity.\":\"يُشال قشر الثمرة عن البذرة، وتنقع الحبوب في الماء حتى تنفصل الطبقة اللزجة، وبعدها تنغسل وتتجفف، وبعدها تُغسل وتُجفف. تذوق فيها الحبة نفسها: نظيفة وواضحة وحموضتها أعلى.\",\"The skin comes off but some of the sticky fruit layer (the honey) stays on the bean while it dries. Halfway between washed and natural: more sweetness and body than washed, cleaner than natural.\":\"تُشال القشرة لكن يظل جزء من الطبقة اللزجة (العسل) على الحبة وهي تجف. نص الطريق بين المغسولة والطبيعية: حلاوة وقوام أكثر من المغسولة، وأنظف من الطبيعية.\",\"The whole cherry is dried in the sun with the fruit still on, then hulled. The bean absorbs fruit sugars for days — fruity, heavy, wine-like sweetness, and a more fragile bed when you brew.\":\"تُجفف الثمرة كاملة تحت الشمس والفاكهة عليها، وبعدها تُقشر. الحبوب تمتص جزءًا من سكريات الفاكهة وهي تجف — فاكهية وثقيلة وحلاوتها تشبه النبيذ، وطبقتها أهش وقت التحضير.\",\"Cherries ferment in sealed, oxygen-free tanks before drying. The controlled fermentation creates bold, unusual flavours — funky, boozy, intense. A little goes a long way; brew it gently.\":\"تتخمّر الثمار في خزانات مقفلة بدون أكسجين قبل التجفيف. التخمير المتحكم فيه يعطي نكهات جريئة وغير مألوفة — قوية ومركّزة. نكهاتها قوية، لذلك غالبًا تحتاج تحضير هادئ واستخلاص متوازن.\",\"Clicks from zero — espresso lands around 13–15, pour-over roughly double that.\":\"نقرات من الصفر — الإسبريسو نحو 13–15، والتقطير قرابة الضعف.\",\"Café workhorse — filter sits around 7–10 on the 1–16 dial; every machine drifts, anchor to taste.\":\"مطحنة المقاهي — الترشيح بين 7 و10 على قرص 1–16؛ كل آلة تختلف قليلًا فاعتمد على التذوّق.\",\"12-position ring with wide steps — expect a real jump between numbers.\":\"قرص 12 وضعية بخطوات واسعة — توقّع فرقًا واضحًا بين رقم وآخر.\",\"16 positions across four zones — pour-over lives in the middle zones.\":\"16 وضعية على أربع مناطق — التقطير في المناطق الوسطى.\",\"18-position dial with wide steps — dial by taste.\":\"قرص 18 وضعية بخطوات واسعة — اضبط بالتذوّق.\",\"rotations\":\"دورة\",\"Internal dial under the burr, 30 clicks per rotation — count from zero.\":\"قرص داخلي تحت الشفرات، 30 نقرة لكل دورة — عُدّ من الصفر.\",\"External dial J-series — J-Max 90 clicks/turn, J-Ultra 100; numbers land close, adjust by taste.\":\"قرص خارجي لسلسلة J — جي-ماكس 90 نقرة/دورة وجي-ألترا 100؛ الأرقام متقاربة، عدّل بالتذوّق.\",\"External dial, 12.5µm/click, 60 clicks per turn.\":\"قرص خارجي، 12.5 ميكرون/نقرة، 60 نقرة لكل دورة.\",\"Red Clix axle: each stock click becomes two — numbers run about double a standard C40.\":\"محور ريد كليكس: كل نقرة أصلية تصبح نقرتين — الأرقام تقارب ضعف C40 القياسي.\",\"Gen 1 cuts a touch coarser than Gen 2 at the same number.\":\"الجيل الأول يطحن أخشن قليلًا من الجيل الثاني عند الرقم نفسه.\",\"Stepless numbered dial — espresso sits around 2–3, filter mid-dial.\":\"قرص مرقّم بلا درجات — الإسبريسو نحو 2–3، والفلتر في منتصف القرص.\",\"80 levels, 18.75µm each — set in the app or on the dial.\":\"80 مستوى، 18.75 ميكرون لكل مستوى — يُضبط من التطبيق أو القرص.\",\"Numbers 1–15 with clicks between — pour-over sits mid-scale.\":\"أرقام 1–15 مع نقرات بينها — التقطير في منتصف المقياس.\",\"Espresso-first grinder — pour-over lives at the very top of the macro ring.\":\"مطحنة إسبريسو أولًا — التقطير عند أعلى حلقة الضبط الكبرى.\",\"around the filter mark on the gauge\":\"قرب علامة الفلتر على المؤشر\",\"just coarser than your espresso point\":\"أخشن قليلًا من نقطة الإسبريسو لديك\",\"the filter end of the worm dial\":\"طرف الفلتر من القرص الدودي\",\"around your filter reference\":\"قرب رقمك المرجعي للفلتر\",\"around the filter zone of the dial\":\"قرب منطقة الفلتر على القرص\",\"g\":\"غ\",\"Everyday Balanced\":\"يومي متوازن\",\"Fruity · Kasuya 4:6\":\"فاكهي · كاسويا 4:6\",\"Balanced · Kasuya 4:6\":\"متوازن · كاسويا 4:6\",\"Classic · Hoffmann\":\"كلاسيكي · هوفمان\",\"Sweeter · Kasuya 4:6\":\"حلاوة · كاسويا 4:6\",\"Osamah Alawwam\":\"أسامة العوّام\",\"Osamah Alawwam · Roasting House owner\":\"أسامة العوّام · مالك بيت التحميص\",\"Osamah Alawwam method — a generous, slow first pour to about 63%, then two short finishing pulses. Runs cooler with a slightly richer ratio for a sweet, full cup. Recipe by Osamah Alawwam (Roasting House owner).\":\"طريقة أسامة العوّام — صبة أولى كبيرة وبطيئة إلى قرابة 63%، وبعدها صبتان قصيرتان وانتهينا. حرارة أبرد شوي ونسبة أغنى، والنتيجة فنجان حلو وممتلئ. الوصفة لأسامة العوّام (مالك بيت التحميص).\",\"Slow, steady spiral — take your time, about 25 seconds.\":\"حركة لولبية بطيئة وثابتة — خذ وقتك، نحو 25 ثانية.\",\"Short, gentle pulse.\":\"نبضة قصيرة لطيفة.\",\"Top up to full, then a gentle final swirl.\":\"كمل باقي الصبة، ثم تدويرة أخيرة لطيفة.\",\"Pour\":\"صبة\",\"One steady pour straight to full — simple and even. Give it a gentle swirl to settle.\":\"صبة واحدة ثابتة للآخر — بسيطة ومتساوية. دوّرها تدويرة خفيفة عشان تستقر.\",\"Hoffmann iced\":\"هوفمان بارد\",\"Kasuya 4:6 iced\":\"كاسويا 4:6 بارد\",\"50/50 flash\":\"بارد 50/50\",\"balanced\":\"متوازن\",\"fruity\":\"فاكهي\",\"sweet\":\"حلاوة\",\"immersion\":\"غمر\",\"Steep\":\"نقع\",\"Press\":\"ضغط\",\"Release\":\"تحرير\",\"Saturate every ground, then swirl gently.\":\"رطّب كل القهوة المطحونة ثم دوّر الوعاء بلطف.\",\"Steady spirals up to 60%. Let it settle a moment before the next pour.\":\"حركة لولبية ثابتة حتى 60%. اتركها تستقر لحظة قبل الصبة التالية.\",\"Bigger first pour leans fruity. Swirl.\":\"صبة أولى أكبر تميل للفاكهية. دوّر الوعاء.\",\"Smaller first pour leans sweeter. Swirl.\":\"صبة أولى أصغر تميل للحلاوة. دوّر الوعاء.\",\"A smaller second pour completes the 40% — the big first pour tips it toward acidity.\":\"صبة ثانية أصغر تُكمل الـ40% — الصبة الأولى الكبيرة ترجّح الحموضة.\",\"A bigger second pour completes the 40% — the small first pour tips it toward sweetness.\":\"صبة ثانية أكبر تُكمل الـ40% — الصبة الأولى الصغيرة ترجّح الحلاوة.\",\"Final pour to full volume.\":\"الصبة الأخيرة — باقي كمية الماء.\",\"Strength-building pour.\":\"صبة لبناء القوة.\",\"Add water, stir 3×\":\"أضف الماء، حرّك 3 مرات\",\"Steep ~60s\":\"انقع ~60 ثانية\",\"Press slowly over ~30s\":\"اضغط ببطء خلال ~30 ثانية\",\"Valve closed; bloom and swirl\":\"الصمام مقفول؛ رطّب ودوّر الوعاء\",\"Steep until ~1:45\":\"انقع حتى ~1:45\",\"Open the valve to drain\":\"افتح الصمام للتصريف\",\"e.g. peach, jasmine, honey\":\"مثل: خوخ، ياسمين، عسل\",\"clicks\":\"نقرة\",\"turns\":\"دورة\",\" (by feel)\":\" (بالتقدير)\",\"No saved bags yet.<br>Dial one in, then tap “Tasted great ✓” or “Save this bag”.\":\"لا توجد أكياس محفوظة بعد.<br>اضبط واحدًا، ثم اضغط “طعمها رائع ✓” أو “احفظ هذه الوصفة”.\",\"Light roasts cling to flavour — swirl after the bloom and after each pour, and pour from a little higher.\":\"التحميص الفاتح يمسك نكهته — دوّر الوعاء بعد الترطيب وبعد كل صبة، واسكب من شوي أعلى.\",\"Swirl gently after the bloom and once at the end. Keep pours calm and central.\":\"دوّر الوعاء بلطف بعد الترطيب ومرة في الآخر، وخل الصب هادئًا وفي النص.\",\"Go gentle: low, soft pours and a single light swirl. This roast turns bitter if stirred hard.\":\"على راحتك: صبات واطية وناعمة وتدويرة وحدة خفيفة. هذا التحميص يصير مرًّا بسرعة لو حرّكته بقوة.\",\"Washed: Brew straight for clarity.\":\"مغسولة: حضّرها على طول، بتعطيك وضوحًا.\",\"Honey: Standard pours; sweetness sits in the middle.\":\"عسلية: صبات عادية؛ الحلاوة في النص.\",\"Natural: Gentler pours — the bed is fragile and degasses fast.\":\"طبيعية (مجففة): خفّف صباتك — الطبقة هشة وتطلع غازًا بسرعة.\",\"Anaerobic: Pull it back: cooler or coarser so the funk doesn't dominate.\":\"لا هوائية: هدّيها: أبرد أو أخشن عشان ما تطغى نكهة التخمير.\",\"Aromatics are delicate — don't over-agitate; let the floral top notes survive.\":\"عطرياتها ناعمة — لا تكثر التحريك، خل النكهات الزهرية تعيش.\",\"Can take a slightly finer grind to pull more of that blackcurrant depth.\":\"تتحمل طحنة أنعم شوي عشان يبان عمق الكشمش الأسود.\",\"Forgiving and balanced — a great bag to benchmark your dial-in on.\":\"متسامحة ومتوازنة — كيس ممتاز تضبط عليه معايرتك.\",\"Soft and forgiving — a clean, balanced everyday cup; often organic and washed.\":\"ناعمة ومتسامحة — فنجان يومي نظيف ومتوازن، وغالبًا عضوية ومغسولة.\",\"Dense, low-acid flavour; keep temp moderate or it turns ashy.\":\"نكهتها كثيفة وحموضتها قليلة؛ خل الحرارة وسط وإلا طلعت رمادية.\",\"Treat it gently: low agitation, clean even pours. Don't bully a Gesha.\":\"عاملها بلطف: تحريك قليل وصبات نظيفة متساوية. الجيشا ما ينفع تقسى عليها.\",\"Jazan Khawlani is usually natural-processed and heritage-grown — treat like a rich natural: gentle pours, and don't over-extract the spice.\":\"البن الخولاني (جازان وعسير والباحة) غالبًا معالجته طبيعية وزراعته تراثية على 800–2500م — عامله كطبيعية غنية: صبات لطيفة، ولا تسحب توابله زيادة.\",\"Usually roasted darker — lean coarser and cooler with gentle pours.\":\"غالبًا محمّص أغمق — روح أخشن وأبرد مع صبات لطيفة.\",\"Usually robusta — bold and low-acid, and it turns bitter easily. Grind coarser, brew cooler, and pour gently. Specialty Vietnamese arabica (from Da Lat) is milder — treat it more like a regular origin.\":\"غالبًا روبوستا — جريء وقليل الحموضة، ويميل للمرارة بسرعة. اطحن أخشن، وحضّر أبرد، وصُب بلطف. أمّا أرابيكا فيتنام المتخصصة (من دا لات) فأخفّ — عاملها مثل أي منشأ عادي.\",\"jasmine, citrus, stone fruit, tea-like body\":\"ياسمين، حمضيات، فاكهة ذات نواة، قوام شبيه بالشاي\",\"blackcurrant, tomato, syrupy body, vivid acidity\":\"كشمش أسود، طماطم، قوام كالشراب، حموضة نابضة\",\"caramel, red apple, balanced sweetness\":\"كراميل، تفاح أحمر، حلاوة متوازنة\",\"mild chocolate, nuts, caramel, soft citrus, gentle acidity\":\"شوكولاتة خفيفة، مكسّرات، كراميل، حمضيات ناعمة، حموضة لطيفة\",\"chocolate, peanut, heavy body, low acidity\":\"شوكولاتة، فول سوداني، قوام ثقيل، حموضة منخفضة\",\"cocoa, orange, structured acidity\":\"كاكاو، برتقال، حموضة مبنيّة\",\"honeyed sweetness, citrus, clean finish\":\"حلاوة عسلية، حمضيات، نهاية نظيفة\",\"red fruit, floral, silky\":\"فاكهة حمراء، زهري، حريري\",\"jasmine, bergamot, tropical — delicate & rare\":\"ياسمين، برغموت، استوائي — رقيقة ونادرة\",\"wild, boozy, dried fruit, warm spice\":\"جامحة، كحولية، فاكهة مجففة، توابل دافئة\",\"dried fruit, dark chocolate, spice, winey, full body\":\"فاكهة مجففة، شوكولاتة داكنة، توابل، طابع نبيذي، قوام ممتلئ\",\"earthy, herbal, cedar, big body, low acidity\":\"ترابي، عشبي، أرز، قوام كبير، حموضة منخفضة\",\"dark chocolate, roasted nut, cocoa bitterness, heavy body, very low acidity\":\"شوكولاتة داكنة، مكسرات محمّصة، مرارة كاكاو، قوام ثقيل، حموضة منخفضة جدًا\",\"caramel, stone fruit, mild\":\"كراميل، فاكهة ذات نواة، معتدلة\",\"chocolate, red apple, soft\":\"شوكولاتة، تفاح أحمر، ناعمة\",\"spice, cedar, low acidity (often monsooned)\":\"توابل، أرز، حموضة منخفضة (غالبًا مُعالجة بالمونسون)\",\"follow the descriptors printed on the bag\":\"اتبع الأوصاف المطبوعة على الكيس\",\"built for clarity across its components\":\"مصمّمة للوضوح عبر مكوّناتها\",\"Designed for this method — brew to the roast on the bag, and keep pours even since mixed densities extract at different rates.\":\"مصممة لهالطريقة — حضّر على التحميص المكتوب على الكيس، وخل صبك متساويًا لأن الخلطة فيها كثافات مختلفة تستخلص بسرعات مختلفة.\",\"usually darker, denser; chocolate & nut\":\"عادةً أغمق وأكثف؛ شوكولاتة ومكسّرات\",\"Roasted for pressure, not pour-over. Go coarser and cooler and pour gently.\":\"محمّصة للإسبريسو مو للتقطير. روح أخشن وأبرد واسكب بلطف.\",\"comfortable, chocolatey, forgiving\":\"مريحة، شوكولاتية، متسامحة\",\"Easy-going and hard to wreck — a good everyday dial-in.\":\"سهلة وما تنخرب بسهولة — معايرة يومية مريحة.\",\"Conical and fast-flowing — the all-rounder, clarity-forward.\":\"مخروطي وسريع النزول — يناسب كل شيء، ويبرز الوضوح.\",\"Flat bed with three small holes — forgiving and even. Pour in gentle pulses, keeping the water level low.\":\"قاعدة مسطحة بثلاث فتحات — متسامح ومتساوٍ. اسكب دفعات خفيفة وخل مستوى الماء واطيًا.\",\"Thick filter slows the flow and adds clarity — grind a touch coarser and run water a touch hotter.\":\"فلتره سميك يبطئ النزول ويصفّي الفنجان — خشّن شوي وارفع الحرارة شوي.\",\"Immersion then press: short contact, finer grind, less water. Cooler water suits it.\":\"غمر وضغط: تلامس قصير وطحنة أنعم وماء أقل. يناسبه ماء أبرد.\",\"Immersion–dripper hybrid: steep with the valve closed, then open to release. A coarser grind suits the steep.\":\"غمر وتقطير معًا: انقع والصمام مقفول وبعدها افتحه. الطحنة الأخشن تناسب النقع.\",\"Fine\":\"ناعم\",\"Medium-fine\":\"ناعم–متوسط\",\"Medium\":\"متوسط\",\"Medium-coarse\":\"متوسط–خشن\",\"Coarse\":\"خشن\",\"like caster sugar\":\"كالسكر الناعم\",\"like table salt\":\"كملح الطعام\",\"like fine sand\":\"كالرمل الناعم\",\"like granulated sugar\":\"كالسكر الحبيبي\",\"like coarse sand\":\"كالرمل الخشن\",\"like raw sea salt\":\"كملح البحر الخام\",\"like kosher salt\":\"كالملح الخشن\",\"Burrs loosen with use — match the texture, not just the number.\":\"شفرات الطاحونة ترتخي مع الاستخدام — طابق الملمس لا الرقم وحده.\",\"Still degassing\":\"لا يزال يُطلق الغاز\",\"Peak window\":\"نافذة النضج\",\"Past peak\":\"بعد النضج\",\"Tired\":\"مُتعَب\",\"Healthy draw-down.\":\"تصريف صحّي.\",\"Ran fast — usually grind too coarse or channeling (expect weak/sour).\":\"نزل الماء بسرعة — غالبًا الطحن أخشن من اللازم أو تكوّنت قنوات (توقّع فنجانًا خفيفًا أو حامضًا).\",\"Stalled — usually grind too fine or over-agitated (expect bitter/muddy).\":\"توقّف النزول — غالبًا الطحن أنعم من اللازم أو التحريك زائد (توقّع مرارة أو عكارة).\",\"Immersion holds water differently — retention is less diagnostic here.\":\"التخمير بالغمر يحتجز الماء بشكل مختلف — الاحتباس أقل دلالة هنا.\",\"Hoffmann two-pour — quick but steady: two close pours (60% then 40%) meant to run almost back-to-back. The rests are the bloom and the drawdown, not between pours. Pour with intent if you are new. Recipe by James Hoffmann.\":\"طريقة هوفمان بصبتين — سريعة من طبعها: صبتان وراء بعض تقريبًا (60% ثم 40%)، والراحة كلها في الترطيب ونزول الماء، مو بين الصبات. لو أنت جديد اسكب بثبات وبس. الوصفة لجيمس هوفمان.\",\"4:6 method, bigger first pour — five small, relaxed pours with a rest between each. Leans fruity — more acidity and clarity. Recipe by Tetsu Kasuya.\":\"طريقة 4:6 بصبة أولى أكبر — خمس صبات صغيرة على راحتك، وبين كل وحدة والثانية استراحة. تطلع فاكهية أكثر ووضوحها أعلى. الوصفة لتيتسو كاسويا.\",\"4:6 method, smaller first pour — same relaxed five-pulse rhythm, weighted toward sweetness and body. Recipe by Tetsu Kasuya.\":\"طريقة 4:6 بصبة أولى أصغر — نفس الإيقاع المريح بخمس صبات، بس تميل للحلاوة والقوام. الوصفة لتيتسو كاسويا.\",\"AeroPress immersion — steep, then press. Forgiving and quick; the timing isn't fussy.\":\"غمر إيروبريس — انقع واضغط وانتهينا. متسامح وسريع، والتوقيت مو مشكلة.\",\"Switch immersion–drip — steep with the valve shut, then open to release. Relaxed and very forgiving.\":\"سويتش غمر وتقطير — انقع والصمام مقفول، وبعدها افتحه ينزل. مريح ومتسامح مرّة.\",\"Bigger dose deepens the bed, so the grind is nudged coarser to keep extraction even. If it still tastes strong or bitter, go coarser still.\":\"قهوة أكثر تعني طبقة أعمق، عشان كذا خشّنا الطحنة شوي حتى يظل الاستخلاص متساويًا. لو ظل الطعم ثقيلًا أو مرًّا، خشّن أكثر.\",\"Smaller dose means a shallower bed, so the grind is nudged finer. If it tastes thin or weak, go finer still.\":\"قهوة أقل تعني طبقة أخف، عشان كذا نعّمنا الطحنة شوي. لو طلع الطعم خفيفًا، نعّم أكثر.\",\"Aim medium, like table salt, then correct by taste.\":\"استهدف الوسط، كملح الطعام، ثم صحّح بالتذوّق.\",\"Internal dial under the burr — tighten to zero, count counter-clockwise. 40 clicks per turn, ~18µm each. Never grind below 16 clicks.\":\"القرص الداخلي تحت الرحى — اربط حتى الصفر ثم عُد عكس عقارب الساعة. ٤٠ نقرة للدورة، ~١٨ ميكرون لكل نقرة. لا تطحن تحت ١٦ نقرة.\",\"Big dial, ~25µm per number — pour-over lives around 7–12; start at 9 and dial by taste.\":\"قرص كبير، ~٢٥ ميكرون لكل رقم — التقطير بين ٧ و١٢؛ ابدأ من ٩ واضبط بالتذوق.\",\"A drop of RDT water kills static. Count clicks from fully closed.\":\"بخ الماء على القهوة قبل الطحن يزيل الكهرباء الساكنة. عُدّ النقرات من الإغلاق التام.\",\"External numbered dial, ~30 clicks per rotation; count from zero.\":\"قرص خارجي مرقّم، ~30 نقرة لكل دورة؛ عُدّ من الصفر.\",\"Numbered dial, 90 clicks/turn. Read whole turns plus clicks.\":\"قرص مرقّم، 90 نقرة/دورة. اقرأ الدورات الكاملة مع النقرات.\",\"Pour-over-tuned burrs — small moves make a big difference.\":\"أسنان مضبوطة للتقطير — الحركات الصغيرة تُحدث فرقًا كبيرًا.\",\"Clicks from zero (closed).\":\"نقرات من الصفر (مغلق).\",\"Clicks from zero; the X burrs feel a touch finer.\":\"نقرات من الصفر؛ أسنان X تبدو أنعم قليلًا.\",\"Count clicks from fully closed. MIBRU chart: espresso 6-10 — start drip ~15-17 and dial by taste.\":\"عدّ النقرات من الإغلاق التام. جدول ميبرو: إسبريسو 6–10 — للتقطير ابدأ ~15–17 واضبط بالتذوق.\",\"87 levels, espresso fine to french coarse — MIBRU says the middle suits drip; start ~44.\":\"87 درجة من ناعمة الإسبريسو إلى خشونة الفرنش — ميبرو توصي بالمنتصف للتقطير؛ ابدأ ~44.\",\"External dial, 8µm/click, 60 clicks per turn.\":\"قرص خارجي، 8 ميكرون/نقرة، 60 نقرة لكل دورة.\",\"Stepless — set near the filter mark, then nudge by taste.\":\"بلا درجات — اضبط قرب علامة الفلتر ثم عدّل بالتذوّق.\",\"Clicks from closed; less precise, so taste and adjust.\":\"نقرات من المغلق؛ أقل دقّة، لذا تذوّق وعدّل.\",\"No real scale — aim medium-fine and accept some unevenness.\":\"لا مقياس فعلي — استهدف ناعم–متوسط واقبل بعض التفاوت.\",\"Dial 1–40. Weigh beans in; expect a little retention.\":\"قرص 1–40. اوزن الحبوب؛ توقّع احتباسًا بسيطًا.\",\"ESP gearing runs finer, so pour-over sits higher on the dial.\":\"تروس ESP أنعم، لذا يقع التقطير أعلى على القرص.\",\"Dial 1–40; cleaner grind than the Encore.\":\"قرص 1–40؛ طحن أنظف من الإنكور.\",\"Setting 1–11 with thirds. Single-dose, very low retention.\":\"ضبط 1–11 بالأثلاث. جرعة مفردة، احتباس منخفض جدًا.\",\"Wider range than the Ode; three clicks between each number for fine moves.\":\"مدى أوسع من الأود؛ استخدم علامات الأثلاث للحركات الدقيقة.\",\"Reference numbers (not absolute). Single-dose, near-zero retention.\":\"أرقام مرجعية (ليست مطلقة). جرعة مفردة، احتباس قرب الصفر.\",\"Outer dial 1–60 plus inner fine adjust. Purge a little first.\":\"قرص خارجي 1–60 مع ضبط داخلي دقيق. طهّر قليلًا أولًا.\",\"Numbered dial; the filter range sits mid-scale.\":\"قرص مرقّم؛ مدى الفلتر في وسط المقياس.\",\"Stepless dial with markings; single-dose friendly.\":\"قرص بلا درجات مع علامات؛ مناسب للجرعة المفردة.\",\"Single-dose, stepless — set by reference. RDT helps with static.\":\"جرعة مفردة، بلا درجات — اضبط بالمرجع. بخ الماء قبل الطحن يساعد ضد الكهرباء الساكنة.\",\"Stepless and geared fine — make small moves.\":\"بلا درجات وتروس دقيقة — حرّكها بخطوات صغيرة.\",\"Stepless single-doser — log a reference number per coffee.\":\"جرعة مفردة بلا درجات — سجّل رقمًا مرجعيًا لكل قهوة.\",\"1 · Fresh coffee\":\"1 · قهوة طازجة\",\"Whole beans roughly 1–4 weeks off roast, ground right before you brew. Stale or pre-ground coffee caps how good the cup can get, no matter your technique.\":\"استخدم حبوب كاملة مر عليها أسبوع إلى أربعة أسابيع من التحميص، واطحنها قبل التحضير مباشرة. القهوة القديمة أو المطحونة من قبل تحدّ من مستوى الفنجان مهما كانت مهارتك.\",\"2 · A scale\":\"2 · ميزان\",\"Weighing your coffee and water is the most important step for a consistent result. 0.1 g resolution is ideal. Handy fact: 1 ml of water weighs 1 g — the millilitres in the recipe are exactly what your scale shows.\":\"وزن القهوة والماء أهم نقطة في ثبات النتيجة. ميزان بدقة 0.1 غ أكثر من كافي. ومعلومة تسهّل عليك: 1 مل ماء = 1 غرام، فالمليلترات في الوصفة هي نفس الرقم اللي يطلع لك على الميزان.\",\"3 · An even grind\":\"3 · طحن متساوٍ\",\"A burr grinder (not a blade) grinds evenly. Grind size is your main dial: finer pulls more (risking bitter), coarser pulls less (risking sour).\":\"مطحنة ببُرّات (Burr) وليست شفرة مثل الخلاط (وليست شفرة تلفّ مثل الخلاط) تعطيك طحنة متساوية. حجم الطحن أهم شيء بيدك: كلما نعّمت زاد الاستخلاص (وقد تظهر مرارة)، وكلما خشّنت قلّ (وقد تظهر حموضة).\",\"4 · Good water, just off boil\":\"4 · ماء نقي بعد الغليان مباشرة\",\"Water is about 98% of the cup, so filtered or soft water helps a lot. Just off the boil for most roasts; a little cooler for dark.\":\"الماء يشكّل حوالي 98% من فنجانك، فالماء المفلتر يفرق كثيرًا. استخدم الماء بعد ما يغلي مباشرة مع أغلب التحميصات، وإذا كان التحميص غامق انتظر 20–30 ثانية، وأبرد قليلًا للتحميص الغامق.\",\"5 · Even pouring\":\"5 · صبّ متساوٍ\",\"Wet all the grounds, then pour gently and evenly in circles. Sloppy pours channel water and extract unevenly.\":\"بلّل كل القهوة المطحونة أولًا، ثم اسكب بهدوء وبحركات دائرية متساوية. الصبّ العشوائي يخلي الماء يمشي في قنوات داخل القهوة ويعطيك استخلاصًا غير متساوٍ.\",\"Extraction\":\"الاستخلاص\",\"How much flavour you have dissolved out of the grounds. Too little tastes sour; too much tastes bitter; the middle is sweet and balanced.\":\"كم نكهة سحب الماء من القهوة. القليل يطلع حامضًا، والكثير يطلع مرًّا، والمنطقة الوسطى هي الحلاوة والتوازن.\",\"Extraction yield\":\"نسبة الاستخلاص\",\"The percentage of the coffee mass that dissolved (target roughly 18–22%). Only truly known with a refractometer.\":\"النسبة المئوية من وزن القهوة التي ذابت فعلًا في الماء (الهدف حوالي 18–22%). لا تُقاس بدقة إلا بجهاز الرفراكتوميتر.\",\"Bloom\":\"الترطيب\",\"The first small pour that wets the grounds and lets fresh coffee release trapped CO₂ before the main pour.\":\"أول صبة صغيرة تبلّل القهوة وتسمح للغاز المحبوس بالخروج قبل الصبات الأساسية.\",\"Ratio\":\"النسبة\",\"Coffee to water, e.g. 1:16.7 means 16.7 g water per 1 g coffee. More water is weaker and cleaner; less is stronger and heavier.\":\"نسبة القهوة إلى الماء: 1:16.7 يعني 16.7 غ ماء لكل غرام قهوة. ماء أكثر يعطيك فنجانًا أخف وأنظف، وماء أقل يعطيك أقوى وأثقل.\",\"Agitation\":\"التحريك\",\"Stirring, swirling, and pour force. More agitation speeds extraction, but overdone it turns harsh.\":\"أي تقليب أو تدوير أو صبّ قوي. التحريك يسرّع الاستخلاص، لكن إذا زاد عن حدّه طلع الطعم خشنًا.\",\"Channelling\":\"تكوّن القنوات\",\"Water finding a fast path through cracks in the bed, so some grounds over-extract while others barely brew. Even pours prevent it.\":\"عندما يجد الماء طريقًا سريعًا عبر شق في طبقة القهوة، فيُستخلص جزء أكثر من اللازم وجزء آخر بالكاد يلمسه الماء. الصبّ المتساوي يمنع هذا.\",\"Draw-down\":\"التصريف\",\"How long the water takes to drain after your last pour. Fast usually means too coarse; slow or stalled means too fine.\":\"الوقت الذي يحتاجه الماء لينزل بعد آخر صبة. إذا خلص التصريف بسرعة فغالبًا الطحن خشن، وإذا تأخر كثير فالغالب إنه ناعم زيادة، ولو تأخر أو توقف فهي ناعمة زيادة.\",\"Degassing\":\"إطلاق الغاز\",\"Fresh-roasted coffee releasing CO₂ for days after roast. Lots of gas makes a big bloom and can read sour.\":\"القهوة الطازجة تظل تطلق غاز ثاني أكسيد الكربون أيامًا بعد التحميص. كلما كانت القهوة أطزج، كان خروج الغاز أكثر أثناء الترطيب وقد يعطي طعمًا حامضًا.\",\"TDS / strength\":\"المواد الذائبة / القوة\",\"Total dissolved solids — how concentrated the brew is. Measured with a refractometer; the Strength setting is the everyday lever.\":\"يعني تركيز القهوة في الفنجان. يُقاس بجهاز الرفراكتوميتر، أما يوميًا فإعداد القوة في التطبيق يكفيك.\",\"Flash / Japanese iced\":\"فلاش / المثلّج الياباني\",\"Brewing hot straight onto ice to chill instantly and keep the aromatics. Different from cold brew.\":\"تحضّر القهوة ساخنة وتنزل مباشرة على الثلج، فتبرد فورًا وتحتفظ بعطرياتها. يختلف تمامًا عن الكولد برو.\",\"Cold brew\":\"تخمير بارد\",\"Steeping grounds in cold water for many hours. Low acidity and smooth, but it loses the lively, aromatic notes.\":\"نقع القهوة في ماء بارد لساعات طويلة. النتيجة ناعمة وقليلة الحموضة، لكنها تكون أقل في الروائح والنكهات الزاهية مقارنة بالقهوة المحضرة ساخنة.\",\"Essential\":\"أساسي\",\"A scale (0.1 g), a burr grinder, and fresh coffee. These three decide most of your cup.\":\"ميزان بدقة 0.1 غ، ومطحنة بشفرات طحن، وقهوة طازجة — هذه الثلاثة تصنع معظم الفنجان.\",\"Helps a lot\":\"يساعد كثيرًا\",\"A gooseneck kettle for pour control, plus a dripper and filters you like (V60, Kalita Wave, Chemex...).\":\"غلاية بعنق طويل تتحكم فيها بالصبّ، وقمع وفلاتر تناسبك (V60، كاليتا، كيمكس...).\",\"Nice, not needed\":\"جميل، لكنه غير ضروري\",\"A temperature-control kettle, a timer (your phone is fine), and a refractometer (only if you want to measure — you can brew great coffee without one).\":\"غلاية بتحكم في الحرارة، ومؤقّت (جوالك يكفي)، ورفراكتوميتر إن كنت من محبي الأرقام — تقدر تحضّر قهوة ممتازة بدونها كلها.\",\"Honest advice\":\"نصيحة صادقة\",\"An expensive dripper will not fix a bad grinder. If you are going to spend, spend on the grinder first.\":\"القمع الغالي لن يصلّح مطحنة سيئة — إذا كنت ستصرف، فاصرف على المطحنة أولًا.\"\n};\nfunction tr(s){if(lang!==\"ar\")return s;return (Object.prototype.hasOwnProperty.call(TR,s))?TR[s]:s;}\nfunction P(en,ar){return (lang===\"ar\")?ar:en;}\nfunction tlabel(t){var L={sour:P(\"Sour\",\"حامض\"),bitter:P(\"Bitter\",\"مرّ\"),weak:P(\"Weak\",\"ضعيف\"),strong:P(\"Too strong\",\"قوي جدًا\"),flat:P(\"Flat\",\"باهت\"),finish:P(\"Finish time\",\"وقت النهاية\"),nonotes:P(\"Notes missing\",\"النكهات غائبة\"),great:P(\"Great ✓\",\"رائع ✓\")};return L[t]||t;}\nfunction actLabel(a){if(!a)return \"\";if(lang!==\"ar\")return a;return({\"→ finer\":\"→ أنعم\",\"→ coarser\":\"→ أخشن\",\"→ +2°C\":\"→ +2°م\",\"→ -2°C\":\"→ -2°م\",\"→ stronger\":\"→ أقوى\",\"→ lighter\":\"→ أخف\",\"✓\":\"✓\"})[a]||a;}\nfunction plab(l){if(lang!==\"ar\")return l;var m=/^Pour ([0-9]+)$/.exec(l);if(m)return \"صبة \"+m[1];return tr(l);}\n/*__SAVED__*/\nvar SAVED=(typeof window!==\"undefined\"&&window.SAVED)?window.SAVED:null;if(!SAVED){try{var _ls=localStorage.getItem(\"cws-data\");if(_ls)SAVED=JSON.parse(_ls);}catch(e){}}\nconst state={machine:\"none\",tempProfile:\"flat\",grinder:\"comandante\",brewer:\"v60\",kind:\"single\",roast:\"medium\",process:\"washed\",origin:\"ethiopia\",blendStyle:\"filter\",days:14,dose:15,strength:\"balanced\",goal:\"everyday\",bagNotes:\"\",serve:\"hot\",icedStyle:\"hoffmann\",roastDate:\"\",grindAdj:0,tempAdj:0};STATE_DEFAULTS=JSON.parse(JSON.stringify(state));\nvar LIBRARY=(SAVED&&(SAVED.library||SAVED.presets))?(SAVED.library||SAVED.presets):[];var JOURNEY=(SAVED&&SAVED.journey)?SAVED.journey:[];if(SAVED&&SAVED.lang)lang=SAVED.lang;var CALIB=(SAVED&&SAVED.calib)?SAVED.calib:0;var GRINDOFF=(SAVED&&SAVED.grindoff)?SAVED.grindoff:{};var MYGRINDERS=(SAVED&&SAVED.mygrinders)?SAVED.mygrinders:[];var FAVG=(SAVED&&SAVED.favg)?SAVED.favg:[];\nvar view=\"build\",taste=null,pendingVerdict=\"\",flow=null,activeBagId=null,whyOpen=false,tasteHelpOpen=false,flowHelpOpen=false,gcalOpen=false,gsetup=null,delConfirm=null,streak={sym:null,n:0},lastAction=\"\";\nfunction persist(){try{window.SAVE_DATA=JSON.stringify({library:LIBRARY,lang:lang,journey:JOURNEY,calib:CALIB,grindoff:GRINDOFF,mygrinders:MYGRINDERS,favg:FAVG})}catch(e){}try{localStorage.setItem(\"cws-data\",window.SAVE_DATA)}catch(e){}}\nfunction escName(s){return String(s).split(\"&\").join(\"&amp;\").split(\"<\").join(\"&lt;\").split(\">\").join(\"&gt;\").split('\"').join(\"&quot;\")}\nfunction defaultName(){var c=state.kind===\"single\"?((ORIGINS.find(function(o){return o.id===state.origin})||{}).label):((BLENDS.find(function(b){return b.id===state.blendStyle})||{}).label);return (c||\"Setup\")+\" · \"+state.dose+\"g\"}\nconst LIM={days:{min:0,max:90,step:1,dec:false},dose:{min:8,max:100,step:0.1,dec:true}};\nconst DAY=86400000;const pad2=(n)=>String(n).padStart(2,\"0\");\nfunction isoFromDays(d){const t=new Date();t.setHours(12,0,0,0);const x=new Date(t.getTime()-d*DAY);return x.getFullYear()+\"-\"+pad2(x.getMonth()+1)+\"-\"+pad2(x.getDate())}\nfunction daysFromIso(iso){if(!iso)return state.days;const p=iso.split(\"-\");const t=new Date();t.setHours(12,0,0,0);const x=new Date(+p[0],(+p[1])-1,+p[2],12,0,0,0);return clamp(Math.round((t-x)/DAY),0,90)}\nif(!state.roastDate)state.roastDate=isoFromDays(state.days);\nconst inputs=document.getElementById(\"inputs\"),card=document.getElementById(\"card\");\nconst esc=(s)=>String(s);\nfunction seg(key,arr,accent){return '<div class=\"seg'+(accent?' '+accent:'')+'\">'+arr.map(o=>'<button class=\"seg-btn'+(state[key]===o.id?' active':'')+'\" data-key=\"'+key+'\" data-id=\"'+o.id+'\">'+esc(tr(o.label))+'</button>').join('')+'</div>'}\nfunction sel(key,arr){return '<select class=\"sel\" data-key=\"'+key+'\">'+arr.map(o=>'<option value=\"'+o.id+'\"'+(state[key]===o.id?' selected':'')+'>'+esc(tr(o.label))+'</option>').join('')+'</select>'}\nfunction sortedOrigins(){return ORIGINS.slice().sort(function(a,b){if(a.id===\"other\")return 1;if(b.id===\"other\")return -1;return tr(a.label).localeCompare(tr(b.label),lang===\"ar\"?\"ar\":\"en\");});}\nfunction grinderSel(){const man=GRINDERS.filter(g=>g.type===\"manual\"),el=GRINDERS.filter(g=>g.type===\"electric\");const op=(g)=>'<option value=\"'+g.id+'\"'+(state.grinder===g.id?' selected':'')+'>'+tr(g.label)+'</option>';var mine=(MYGRINDERS&&MYGRINDERS.length)?'<optgroup label=\"'+tr(\"My grinders\")+'\">'+MYGRINDERS.map(op).join('')+'</optgroup>':'';var favList=allGrinders().filter(function(g){return FAVG.indexOf(g.id)>=0;});var favs=favList.length?'<optgroup label=\"'+P(\"★ Favourites\",\"★ المفضلة\")+'\">'+favList.map(op).join('')+'</optgroup>':'';var selHtml='<select class=\"sel\" data-key=\"grinder\">'+favs+mine+'<optgroup label=\"'+tr(\"Manual\")+'\">'+man.map(op).join('')+'</optgroup><optgroup label=\"'+tr(\"Electric\")+'\">'+el.map(op).join('')+'</optgroup></select>';var isFav=FAVG.indexOf(state.grinder)>=0;var favBtn='<button class=\"grinder-fav'+(isFav?' on':'')+'\" data-favgrinder=\"'+state.grinder+'\" title=\"'+P(\"Pin to favourites\",\"تثبيت في المفضلة\")+'\">'+(isFav?'★':'☆')+'</button>';var delX=(state.grinder&&state.grinder.indexOf('my-')===0)?'<button class=\"grinder-x\" data-delgrinder=\"'+state.grinder+'\" title=\"'+P(\"Remove\",\"حذف\")+'\">'+(delConfirm===state.grinder?P(\"Delete?\",\"حذف؟\"):'✕')+'</button>':'';return '<div class=\"grinder-row\">'+selHtml+favBtn+delX+'</div>'+'<button class=\"setupgrinder\" data-setupgrinder=\"1\">'+P(\"⚙ Set up my grinder\",\"⚙ إعداد مطحنتي\")+'</button>'}\nfunction step(key,suf){var l=LIM[key],sp=l.step||1,im=l.dec?\"decimal\":\"numeric\";return '<div class=\"step\"><button class=\"step-btn\" data-key=\"'+key+'\" data-d=\"'+(-sp)+'\">–</button><div class=\"numbox\"><input class=\"num\" data-key=\"'+key+'\" inputmode=\"'+im+'\" value=\"'+state[key]+'\"><span class=\"suf\">'+suf+'</span></div><button class=\"step-btn\" data-key=\"'+key+'\" data-d=\"'+sp+'\">+</button></div>'}\nfunction doseStep(){return '<div class=\"step\"><button class=\"step-btn\" data-key=\"dose\" data-d=\"-1\">–</button><button class=\"step-btn small\" data-key=\"dose\" data-d=\"-0.1\">–.1</button><div class=\"numbox\"><input class=\"num\" data-key=\"dose\" inputmode=\"decimal\" value=\"'+state.dose+'\"></div><button class=\"step-btn small\" data-key=\"dose\" data-d=\"0.1\">+.1</button><button class=\"step-btn\" data-key=\"dose\" data-d=\"1\">+</button></div>'}\nfunction field(label,inner){return '<div class=\"field\"><div class=\"flabel\">'+tr(label)+'</div>'+inner+'</div>'}\nfunction renderInputs(){\n  const r=buildRecipe(state);const fc={fresh:\"#6FB0AE\",ideal:\"#3E8E8E\",aging:\"#D2792E\",stale:\"#B5543A\"}[r.freshId];\n  const fl={fresh:\"Still degassing\",ideal:\"Peak window\",aging:\"Past peak\",stale:\"Tired\"}[r.freshId];\n  let html=\"\";\n  if((BREWERS.find(function(b){return b.id===state.brewer})||{}).kind===\"pour\"){\n    html+=field(\"Serve\",seg(\"serve\",[{id:\"hot\",label:\"Hot\"},{id:\"iced\",label:\"Iced (flash)\"}],\"teal\"));\n  }\n  html+=field(\"Grinder\",grinderSel());\n  html+=field(\"Brewer\",seg(\"brewer\",BREWERS));\n  html+=field(\"Coffee type\",seg(\"kind\",[{id:\"single\",label:\"Single origin\"},{id:\"blend\",label:\"Blend\"}],\"teal\"));\n  if(state.kind===\"single\"){html+=field(\"Origin / variety\",sel(\"origin\",sortedOrigins()));html+=field(\"Process\",seg(\"process\",PROCESSES))}\n  else{html+=field(\"Blend style\",sel(\"blendStyle\",BLENDS))}\n  html+=field(\"Tasting notes — from the bag (optional)\",'<input type=\"text\" class=\"txt\" data-key=\"bagnotes\" placeholder=\"'+tr(\"e.g. peach, jasmine, honey\")+'\" value=\"'+(state.bagNotes||\"\").split('\"').join(\"&quot;\")+'\">');\n  html+=field(\"Roast level\",seg(\"roast\",ROASTS));\n  html+=field(\"Roast date\",'<input type=\"date\" class=\"dateinp\" data-key=\"roastdate\" value=\"'+state.roastDate+'\">');\n  html+=field(\"Days since roast\",step(\"days\",\"\")+'<div class=\"fresh-dot\" style=\"color:'+fc+'\">● '+tr(fl)+'</div>');\n  html+=field(\"Dose (g)\",doseStep()+'<div class=\"hint\">→ '+r.totalWater+P('ml','مل')+' @ '+r.ratioStr+'</div>');\n  html+=field(\"Strength\",seg(\"strength\",STRENGTHS,\"teal\"));\n  if(state.serve===\"iced\"&&(BREWERS.find(function(b){return b.id===state.brewer})||{}).kind===\"pour\"){html+=field(\"Iced style\",seg(\"icedStyle\",[{id:\"hoffmann\",label:\"Hoffmann\"},{id:\"foursix\",label:\"Kasuya 4:6\"},{id:\"fifty\",label:\"50 / 50\"}]));}else{html+=field(\"Brew Style\",seg(\"goal\",GOALS,\"teal\"));}\n  inputs.innerHTML=html;\n}\nfunction machinePanel(){\n  var rec=buildRecipe(Object.assign({},state,{brewer:\"v60\"}));\n  function mrow(k,v){return '<div class=\"mrow\"><span class=\"mk\">'+k+'</span><span class=\"mv\">'+v+'</span></div>';}\n  function tAt(i,n){if(state.tempProfile===\"flat\"||n<2)return rec.temp;var span=(state.tempProfile===\"desc\"?1:-1);var off=span*(1-2*i/(n-1));return Math.max(82,Math.min(100,Math.round((rec.temp+off)*2)/2));}\n  function tFmt(v){return (v%1===0?String(v):v.toFixed(1))+\" °C\";}\n  var bloomX=Math.round(rec.pours[0].cum/rec.dose);\n  var bloomDur=(rec.pours.length>1?Math.min(45,rec.pours[1].t-10):30);\n  var pulses=rec.pours.slice(1);\n  var gaps=[];for(var i=2;i<rec.pours.length;i++){gaps.push(Math.max(5,rec.pours[i].t-rec.pours[i-1].t-25));}\n  var tb=gaps.length?Math.round(gaps.reduce(function(a,b){return a+b},0)/gaps.length):15;\n  var equal=pulses.length?pulses.every(function(p){return Math.abs(p.pour-pulses[0].pour)<=8}):true;\n  var mstyle=rec.method.split(\" · \").slice(1).join(\" · \")||rec.method;var h='<div class=\"mach-hint\">'+P(\"All values below are calculated from your Build page inputs (bean, roast, dose, grinder, brew style, strength).\",\"جميع القيم أدناه محسوبة من مدخلاتك في صفحة التحضير (البن، التحميص، الكمية، المطحنة، أسلوب التحضير، القوة).\")+'</div><div class=\"mach-head\">'+rec.coffee+' · '+rec.dose+P(\"g\",\"غ\")+' · '+mstyle+'</div>';\n  h+='<div class=\"mach-sel\">'+seg(\"machine\",[{id:\"aiden\",label:\"Fellow Aiden\"},{id:\"xbloom\",label:\"xBloom\"}],\"teal\")+'</div>';h+='<div class=\"mach-sel\">'+seg(\"tempProfile\",[{id:\"flat\",label:\"Same temp\"},{id:\"desc\",label:\"Hot → cooler\"},{id:\"asc\",label:\"Cool → hotter\"}],\"teal\")+'</div>';h+='<div class=\"mach-hint\">'+(state.tempProfile===\"desc\"?P(\"Hot → cooler: hot early water pushes aromatics and acidity while the grounds are most soluble; cooler late pours tame the bitter, astringent end. Suits florals and light roasts.\",\"حار ← أبرد: الماء الساخن أولًا يُبرز العطريات والحموضة والحبوب في أقصى ذوبانها؛ والصبات الأخيرة الأبرد تلجم المرارة والقبض في النهاية. تناسب الزهور والتحميص الفاتح.\"):state.tempProfile===\"asc\"?P(\"Cool → hotter: the slurry cools and extraction slows as the brew goes on — hotter late pours compensate, pushing sweetness and body through the finish. Suits sweetness-chasing and darker cups.\",\"بارد ← أسخن: حرارة المزيج تنخفض ويبطؤ الاستخلاص مع تقدم التحضير — فالصبات الأخيرة الأسخن تعوّض وتدفع الحلاوة والقوام حتى النهاية. تناسب ملاحقة الحلاوة والأكواب الأغمق.\"):P(\"One temperature for every pour — the safe default. The profiles are a practitioners’ technique with a subtle effect: the average stays your recipe temp; only the shape changes.\",\"حرارة واحدة لكل الصبات — الافتراضي الآمن. الملفّات الأخرى تقنية ممارسين بأثر دقيق: المتوسط يبقى حرارة وصفتك، والشكل فقط يتغير.\"))+'</div>';\n  var b=\"\";\n  if(state.machine!==\"xbloom\"){\n    b+='<div class=\"mtitle\">'+P(\"FELLOW AIDEN — EDIT PROFILE → ADVANCED\",\"فيلو أيدن — تعديل البروفايل ← متقدم\")+'</div>';b+=mrow(P(\"Brew Style\",\"أسلوب التحضير\"),tr(GOALS.find(function(x){return x.id===state.goal}).label));b+=mrow(P(\"Strength\",\"القوة\"),tr(STRENGTHS.find(function(x){return x.id===state.strength}).label));\n    b+=mrow(P(\"Grind — your grinder\",\"الطحنة — بمطحنتك\"),String(rec.grindNumber));b+=mrow(P(\"Temperature\",\"الحرارة\"),P(\"Mixed\",\"متغيّرة\"));\n    b+=mrow(P(\"Ratio\",\"النسبة\"),\"1:\"+Math.round(rec.totalWater/rec.dose));\n    b+=mrow(P(\"Cold Brew\",\"التحضير البارد\"),P(\"Unchecked\",\"بدون تحديد\"));\n    b+='<div class=\"msec\">'+P(\"Bloom\",\"الترطيب\")+'</div>';\n    b+=mrow(P(\"Enabled\",\"مفعّل\"),\"☑\");\n    b+=mrow(P(\"Ratio\",\"النسبة\"),\"1:\"+bloomX);\n    b+=mrow(P(\"Duration\",\"المدة\"),bloomDur+P(\"s\",\" ث\"));\n    b+=mrow(P(\"Temperature\",\"الحرارة\"),tFmt(tAt(0,pulses.length+1)));\n    b+='<div class=\"msec\">'+P(\"Single Serve Pulses\",\"صبات الفنجان الواحد\")+'</div>';\n    b+=mrow(P(\"Number\",\"العدد\"),String(pulses.length));\n    b+=mrow(P(\"Time Between\",\"الوقت بين الصبات\"),tb+P(\"s\",\" ث\"));\n    for(var j=0;j<pulses.length;j++){b+=mrow(P(\"Pulse \"+(j+1)+\" Temp\",\"حرارة الصبة \"+(j+1)),tFmt(tAt(j+1,pulses.length+1)));}\n    b+='<div class=\"msec\">'+P(\"Batch Pulses\",\"صبات الدفعة\")+'</div>';\n    b+=mrow(P(\"Same as Single Serve\",\"نفس إعدادات الفنجان الواحد\"),\"→\");\n    b+='<div class=\"mnote\">'+(GOALS.find(function(x){return x.id===state.goal}).method===\"fourSix\"?P(\"Note: on Aiden, Fruity and Sweeter produce the same profile — their difference is first-pour size, which equal pulses erase. \",\"ملاحظة: على أيدن، فاكهي وحلاوة يعطيان نفس البروفايل — فرقهما في حجم الصبة الأولى، والصبات المتساوية تلغيه. \"):\"\")+P(\"Then save changes. Aiden pours equal pulses\",\"ثم احفظ التغييرات. أيدن يصب الصبات بأحجام متساوية\")+(equal?\"\":P(\" — this recipe uses uneven pours, so the cup will be close but not identical.\",\" — هذه الوصفة صباتها غير متساوية، فالنتيجة ستكون قريبة لا مطابقة.\"))+P(\" Grind with your own grinder using the Build page number.\",\" اطحن بمطحنتك بالرقم الموضح في صفحة التحضير.\")+'</div>';\n  }else{\n    b+='<div class=\"mtitle\">'+P(\"XBLOOM — RECIPES — CREATE RECIPE\",\"إكس بلوم — الوصفات — إنشاء وصفة\")+'</div>';b+=mrow(P(\"Brew Style\",\"أسلوب التحضير\"),tr(GOALS.find(function(x){return x.id===state.goal}).label));b+=mrow(P(\"Strength\",\"القوة\"),tr(STRENGTHS.find(function(x){return x.id===state.strength}).label));\n    b+='<div class=\"msec\">'+P(\"Coffee\",\"القهوة\")+'</div>';\n    b+=mrow(P(\"Grinder\",\"المطحنة\"),P(\"ON\",\"تشغيل\"));\n    b+=mrow(P(\"Brewer\",\"القمع\"),\"Omni\");\n    b+=mrow(P(\"Dose\",\"الكمية\"),rec.dose+P(\"g\",\"غ\")+(rec.dose>16?P(\" — max ~16g\",\" — الحد ~16غ\"):\"\"));\n    b+=mrow(P(\"Coffee : Water Ratio\",\"نسبة القهوة للماء\"),\"1:\"+Math.round(rec.totalWater/rec.dose)+\" (\"+rec.totalWater+P(\"ml\",\"مل\")+\")\");\n    b+=mrow(P(\"Grind Size\",\"درجة الطحن\"),P(\"start ~55, dial by taste\",\"ابدأ ~55 واضبط بالتذوق\"));\n    b+=mrow(P(\"Grinder Speed\",\"سرعة المطحنة\"),\"120 RPM\");\n    var fr=3.5;\n    for(var q=0;q<rec.pours.length;q++){\n      var pp=rec.pours[q];var nxt=rec.pours[q+1];\n      var dur=pp.pour>0?pp.pour/fr:pp.cum/fr;\n      var pause=nxt?Math.max(0,Math.round(nxt.t-pp.t-dur)):5;\n      b+='<div class=\"msec\">'+(q===0?P(\"Bloom\",\"الترطيب\"):plab(pp.label))+'</div>';\n      b+=mrow(P(\"Volume\",\"الحجم\"),(pp.pour>0?pp.pour:pp.cum)+P(\"ml\",\"مل\"));\n      b+=mrow(P(\"Temperature\",\"الحرارة\"),tFmt(tAt(q,rec.pours.length)));\n      b+=mrow(P(\"Flow rate\",\"معدل التدفق\"),fr+\" ml/s\");\n      b+=mrow(P(\"Pausing\",\"التوقف بعدها\"),pause+P(\"s\",\" ث\"));\n      b+=mrow(P(\"Pattern\",\"نمط الصب\"),q===0?P(\"Centered\",\"مركزي\"):P(\"Spiral\",\"لولبي\"));\n    }\n    b+=mrow(P(\"Agitation before / after\",\"التحريك قبل / بعد\"),\"OFF / OFF\");\n    b+=mrow(P(\"Bypass\",\"الماء الجانبي\"),\"—\");\n    b+='<div class=\"mnote\">'+P(\"Then Save. Pausing values are derived from this recipe rhythm at 3.5 ml/s. xBloom grind scale is its own — dial by taste, not by your grinder number.\",\"ثم احفظ. قيم التوقف محسوبة من إيقاع هذه الوصفة عند 3.5 مل/ث. مقياس طحن إكس بلوم خاص به — اضبط بالتذوق لا برقم مطحنتك.\")+'</div>';\n  }\n  return h+'<div class=\"grind machine\">'+b+'</div>'+'<button class=\"sharebtn\" data-machcard=\"1\">'+P(\"🖼 Share machine card\",\"🖼 شارك بطاقة الآلة\")+'</button>';\n}\nfunction shareMachineCard(){try{\n  var htmlStr=machinePanel();var ar=(lang===\"ar\");\n  var re=new RegExp('<div class=\"(mtitle|msec|mnote|mach-head)\">([^<]*)</div>|<div class=\"mrow\"><span class=\"mk\">([^<]*)</span><span class=\"mv\">([^<]*)</span></div>',\"g\");\n  var items=[];var mm;while((mm=re.exec(htmlStr))){if(mm[1]){items.push({t:mm[1],a:mm[2]});}else{items.push({t:\"row\",k:mm[3],v:mm[4]});}}\n  var W=1080,cv=document.createElement(\"canvas\");var x0=cv.getContext(\"2d\");\n  function wrap(ctx,txt,maxW){var words=String(txt).split(\" \");var lines=[];var cur=\"\";for(var i=0;i<words.length;i++){var t=cur?cur+\" \"+words[i]:words[i];if(ctx.measureText(t).width>maxW&&cur){lines.push(cur);cur=words[i];}else{cur=t;}}if(cur)lines.push(cur);return lines;}\n  x0.font=\"500 30px Noto Sans Arabic, sans-serif\";\n  var H=250;items.forEach(function(it){if(it.t===\"row\")H+=56;else if(it.t===\"msec\")H+=72;else if(it.t===\"mtitle\")H+=60;else if(it.t===\"mach-head\")H+=80;else if(it.t===\"mnote\")H+=wrap(x0,it.a,W-180).length*42+36;});H+=110;\n  cv.width=W;cv.height=H;var x=cv.getContext(\"2d\");\n  x.fillStyle=\"#17120E\";x.fillRect(0,0,W,H);\n  x.fillStyle=\"#D2792E\";x.font=\"600 32px JetBrains Mono, monospace\";x.textAlign=\"center\";x.fillText(\"COFFEE WAY STANDARD\",W/2,90);\n  var y=170;\n  items.forEach(function(it){\n    if(it.t===\"mach-head\"){x.fillStyle=\"#F4EEE3\";x.font=\"700 52px Space Grotesk, Noto Sans Arabic, sans-serif\";x.textAlign=\"center\";x.fillText(it.a,W/2,y);y+=80;}\n    else if(it.t===\"mtitle\"){x.fillStyle=\"#E89A4B\";x.font=\"600 30px JetBrains Mono, monospace\";x.textAlign=\"center\";x.fillText(it.a,W/2,y);y+=60;}\n    else if(it.t===\"msec\"){y+=16;x.fillStyle=\"#3E8E8E\";x.font=\"600 28px JetBrains Mono, monospace\";x.textAlign=ar?\"right\":\"left\";x.fillText(it.a.toUpperCase(),ar?W-90:90,y);y+=56;}\n    else if(it.t===\"row\"){x.fillStyle=\"#7A6A57\";x.font=\"500 32px Noto Sans Arabic, sans-serif\";x.textAlign=ar?\"right\":\"left\";x.fillText(it.k,ar?W-90:90,y);x.fillStyle=\"#F4EEE3\";x.font=\"600 32px Noto Sans Arabic, sans-serif\";x.textAlign=ar?\"left\":\"right\";x.fillText(it.v,ar?90:W-90,y);y+=56;}\n    else if(it.t===\"mnote\"){y+=8;x.fillStyle=\"#A28F78\";x.font=\"500 30px Noto Sans Arabic, sans-serif\";x.textAlign=ar?\"right\":\"left\";var ls=wrap(x,it.a,W-180);for(var li=0;li<ls.length;li++){x.fillText(ls[li],ar?W-90:90,y);y+=42;}y+=28;}\n  });\n    x.fillStyle=\"#5A4E40\";x.textAlign=\"center\";x.font=\"500 28px Noto Sans Arabic, sans-serif\";x.fillText(P(\"Coffee Way Standard · by Abdulmajeed Alwahieb\",\"Coffee Way Standard · إعداد عبدالمجيد الوهيب\"),W/2,H-56);\n  var url=cv.toDataURL(\"image/png\");cv.width=1;cv.height=1;var ov=document.getElementById(\"cardOverlay\");\n  ov.innerHTML=\"<div class=co-in><img src=\"+url+\"><div class=co-hint>\"+P(\"Long-press the image to save or share\",\"اضغط مطوّلًا على الصورة للحفظ أو المشاركة\")+\"</div><button class=co-close id=coClose2>\"+tr(\"Close\")+\"</button></div>\";\n  ov.style.display=\"flex\";document.getElementById(\"coClose2\").addEventListener(\"click\",function(){ov.style.display=\"none\";ov.innerHTML=\"\";});\n}catch(e){showToast(P(\"Could not build the card\",\"تعذّر إنشاء البطاقة\"));}}\nfunction renderMachine(){if(state.machine===\"none\")state.machine=\"aiden\";document.getElementById(\"machineView\").innerHTML=machinePanel();}\nfunction grindFingerprint(rec){\n  try{\n  var gid=state.grinder;var nums=[];\n  LIBRARY.forEach(function(bag){(bag.history||[]).forEach(function(h){if(h.grinder===gid&&h.verdict===\"great\"){var v=parseFloat(h.grind);if(!isNaN(v))nums.push(v);}});});\n  if(nums.length<2)return \"\";\n  nums.sort(function(a,b){return a-b});\n  var med=nums[Math.floor(nums.length/2)];\n  var lo=nums[0],hi=nums[nums.length-1];\n  var gname=(GRINDERS.find(function(x){return x.id===gid})||{}).label||\"\";\n  var range=(lo===hi)?String(med):(lo+\"–\"+hi);\n  return '<div class=\"gfp\"><div class=\"gfp-h\">'+P(\"⚑ Your \"+gname+\" fingerprint\",\"⚑ بصمة \"+gname+\" لديك\")+'</div><div class=\"gfp-b\">'+P(\"Your great brews on this grinder landed around \",\"تحضيراتك الناجحة على هذه المطحنة تمركزت حول \")+'<b>'+range+'</b>'+P(\" (from \"+nums.length+\" great brews). Trust this over the book number — it’s calibrated to your burrs.\",\"، من \"+nums.length+\" تحضيرات. ثق بهذا أكثر من رقم الكتاب — فهو معاير لشفراتك.\")+'</div></div>';\n  }catch(e){return \"\";}\n}\nfunction calibLine(rec){\n  var bag=activeBagId&&findBag(activeBagId);if(!bag||!bag.history)return \"\";\n  var greats=bag.history.filter(function(h){return h.verdict===\"great\"&&h.ft>30});\n  if(greats.length>=3){\n    var fts=greats.map(function(h){return h.ft}).sort(function(a,b){return a-b});\n    var med=fts[Math.floor(fts.length/2)];\n    return '<div class=\"calib\">'+P(\"⚑ Your calibrated finish for this bag: \",\"⚑ نطاقك المُعاير لهذه العلبة: \")+fmt(Math.max(60,med-15))+\"–\"+fmt(med+15)+P(\" (from \",\" (من \")+greats.length+P(\" great brews — replaces the book estimate)\",\" تحضيرات ناجحة — يتقدّم على تقدير المصادر)\")+'</div>';\n  }\n  var g2=bag.history.filter(function(h){return h.verdict===\"great\"});\n  if(g2.length>=2){var last=g2[0];return '<div class=\"calib\">'+P(\"⚑ Best logged cup: grind \",\"⚑ أفضل كوب مسجّل: طحنة \")+last.grind+\" · \"+last.temp+\"°C</div>\";}\n  return \"\";\n}\nfunction cardInner(rec){\n  const maxCum=rec.pours.length?rec.pours[rec.pours.length-1].cum:1;\n  var WU=P(\"ml\",\"مل\");var baseRec=((state.grindAdj||0)!==0||(state.tempAdj||0)!==0)?buildRecipe(Object.assign({},state,{grindAdj:0,tempAdj:0})):null;\n  var gDelta=\"\";if(baseRec&&String(baseRec.grindNumber)!==String(rec.grindNumber)){var bn=parseFloat(baseRec.grindNumber),cn=parseFloat(rec.grindNumber);gDelta='<div class=\"adj\">'+((!isNaN(bn)&&!isNaN(cn))?(bn+\" → \"+cn):(baseRec.grindNumber+\" → \"+rec.grindNumber))+' · '+P(\"your dial-in\",\"معايرتك\")+'</div>';}\n  var tDelta=(baseRec&&baseRec.temp!==rec.temp)?('<div class=\"adj\">'+baseRec.temp+'° → '+rec.temp+'° · '+P(\"your dial-in\",\"معايرتك\")+'</div>'):\"\";\n  const ro=(k,v,u,c)=>'<div><div class=\"rk\">'+tr(k)+'</div><div class=\"rv\" style=\"color:'+c+'\">'+v+'</div>'+(u?'<div class=\"ru\">'+u+'</div>':'')+'</div>';\n  const pr=rec.pours.map((p,i)=>'<div class=\"row\"><div class=\"time\">'+fmt(p.t)+'</div><div class=\"ncol\"><div class=\"dot\"></div>'+(i<rec.pours.length-1?'<div class=\"vline\"></div>':'')+'</div><div class=\"content\"><div class=\"rtop\"><span class=\"plabel\">'+plab(p.label)+'</span><span class=\"amt\">'+(p.noAmt?'':(p.pour>0?'+'+p.pour+WU+' <span class=\"cum\">→ '+p.cum+WU+'</span>':'<span class=\"cum\">'+p.cum+WU+'</span>'))+'</span></div><div class=\"barwrap\"><div class=\"bar\" style=\"width:'+(p.cum/maxCum*100)+'%\"></div></div><div class=\"pnote\">'+tr(p.note)+'</div></div></div>').join('');\n  const nt=rec.notes.map(n=>'<div class=\"note\"><div class=\"nlabel\">'+tr(n.label)+'</div><div class=\"ntext\">'+tr(n.text)+'</div></div>').join('');\n  var _lvl=rec.grindSize.level;var _pct=(_lvl/6*100);\n  var _scaleLabs=P(\"FINE\",\"ناعم\")+'<span style=\"float:'+(lang===\"ar\"?\"left\":\"right\")+'\">'+P(\"COARSE\",\"خشن\")+'</span>';\n  var _ticks='';for(var _i=0;_i<7;_i++){var _on=(_i===_lvl);var _d=(3+_i*1.6).toFixed(1);_ticks+='<div class=\"gtick'+(_on?' on':'')+'\"><i style=\"width:'+_d+'px;height:'+_d+'px\"></i></div>';}\n  const gsize='<div class=\"gscale\">'\n    +'<div class=\"gscale-head\"><b>'+tr(rec.grindSize.label)+'</b><span class=\"gscale-ref\">'+tr(rec.grindSize.ref)+'</span></div>'\n    +'<div class=\"gscale-track\">'+_ticks+'<div class=\"gscale-marker\" style=\"'+(lang===\"ar\"?\"right\":\"left\")+':'+_pct+'%\"></div></div>'\n    +'<div class=\"gscale-ends\">'+_scaleLabs+'</div>'\n    +'<div class=\"gscale-note\">'+P(\"The number is a starting point — burrs vary and wear with use. Trust the texture: match your grounds to the reference, not the dial.\",\"الرقم نقطة انطلاق — المطاحن تختلف وتتآكل مع الوقت. ثق بالملمس: طابق طحنتك مع المرجع، لا الرقم.\")+'</div>'\n    +'</div>';\n  var whyB='<div class=\"why\"><button class=\"why-toggle\" data-why=\"1\">'+tr(\"Why this recipe?\")+' '+(whyOpen?\"▲\":\"▼\")+'</button>'+(whyOpen?'<div class=\"why-body\"><div class=\"why-line\">'+whyRecipe(rec,state)+'</div><div class=\"why-line why-origin\">'+originWhy(state)+'</div></div>':'')+'</div>';\n  return '<div class=\"card\">'\n    +(rec.iced?'<div class=\"icedstrip\">'+P('❄ Pour '+rec.brewWater+'ml hot onto '+rec.iceWeight+'g ice → '+rec.totalWater+'ml chilled','❄ اسكب '+rec.brewWater+'مل ساخن على '+rec.iceWeight+'غ ثلج ← '+rec.totalWater+'مل بارد')+'</div>':'')\n    +whyB\n    +'<div class=\"grind\"><div class=\"glabel\">'+tr(\"Grind\")+' — '+rec.grinderLabel+'</div><div class=\"gnum\">'+rec.grindNumber+'</div>'+gDelta+grindCalHtml(rec)+gsize+(rec.grindWf?'<div class=\"gwf\">'+tr(rec.grindWf)+'</div>':'')+'<div class=\"gtip\">'+tr(\"Burrs loosen with use — match the texture, not just the number.\")+'</div></div>'\n    +'<div class=\"brewhead\"><div class=\"bh-name\">'+rec.coffee+'</div><div class=\"bh-sub\">'+rec.method+(rec.dose?P(' · '+rec.dose+'g',' · '+rec.dose+'غ'):'')+'</div></div>'+'<div class=\"readouts\">'+ro(\"Temp\",rec.temp,P(\"°C / \"+cToF(rec.temp)+\"°F\",\"°م / \"+cToF(rec.temp)+\"°ف\")+(tDelta?\"§ADJ§\":\"\"),\"#D2792E\").split(\"§ADJ§\").join(tDelta)+(rec.iced?ro(\"Hot water\",rec.brewWater,P(\"ml\",\"مل\"),\"#3E8E8E\")+ro(\"Ice\",rec.iceWeight,tr(\"g\"),\"#6FB0AE\"):ro(\"Water\",rec.totalWater,P(\"ml\",\"مل\"),\"#3E8E8E\"))+ro(\"Dose\",rec.dose,tr(\"g\"),\"#2A2018\")+ro(\"Ratio\",rec.ratioStr,\"\",\"#2A2018\")+ro(\"Est. in cup\",rec.incupEst,P(\"ml · ~\"+rec.retainedEst+\"ml held\",\"مل · ~\"+rec.retainedEst+\"مل محتجز\"),\"#2A2018\")+ro(\"Brew time\",rec.finishRange,\"\",\"#2A2018\")+'</div>'\n    +calibLine(rec)+grindFingerprint(rec)+(rec.freshness?'<div class=\"fresh\">'+rec.freshness+'</div>':'')\n    +'<div class=\"sect\">'+tr(\"Pour timeline\")+'</div><button class=\"starttimer\" data-timer=\"1\">'+tr(\"▶ Start pour timer\")+'</button>'+pr+'<button class=\"sharebtn\" data-share=\"1\">'+P(\"⇪ Share this brew\",\"⇪ شارك هذه الوصفة\")+'</button><button class=\"sharebtn\" data-sharecard=\"1\">'+P(\"🖼 Share as image card\",\"🖼 شارك كبطاقة صورة\")+'</button>'\n    +'<div class=\"notes\">'+nt+'</div>'+coachHtml(rec)+'</div>';\n}\nfunction whyRecipe(rec,st){\n  var roast=ROASTS.find(function(x){return x.id===st.roast})||{};var parts=[];\n  if(st.roast===\"light\"||st.roast===\"med-light\")parts.push(P(\"Light-ish roast, so near-boiling water (\"+rec.temp+\"°C) and a finer grind to pull enough out of dense, lightly-roasted beans.\",\"تحميصها فاتح، عشان كذا الماء قريب من الغليان (\"+rec.temp+\"°م) والطحنة أنعم عشان نستخلص ما يكفي من حبوب كثيفة تحميصها خفيف.\"));\n  else if(st.roast===\"dark\"||st.roast===\"med-dark\")parts.push(P((roast.label||\"Darker\")+\" roast, so cooler water (\"+rec.temp+\"°C) and a coarser grind so it does not turn bitter.\",tr(roast.label||\"Darker\")+\" تحميص، عشان كذا الماء أبرد (\"+rec.temp+\"°م) والطحنة أخشن عشان ما تطلع مرّة.\"));\n  else parts.push(P(\"Medium roast, so middle-of-the-road water (\"+rec.temp+\"°C) and grind.\",\"تحميص متوسط، فالماء والطحنة في الوسط (\"+rec.temp+\"°م).\"));\n  if(rec.freshId===\"fresh\")parts.push(P(\"Beans are still gassy (\"+st.days+\"d), so expect a big bloom and a slightly muted cup.\",\"الحبوب ما زال فيها غاز (\"+st.days+\" يوم)، فتوقّع فورانًا كبيرًا ونكهات ما اكتملت بعد.\"));\n  else if(rec.freshId===\"aging\")parts.push(P(\"Aging (\"+st.days+\"d): the app applied +1°C and one step finer versus this bag at its peak.\",\"في مرحلة التعب (\"+st.days+\" يوم): طبّق التطبيق +١° ودرجة أنعم مقارنة بالكيس في قمته.\"));\n  else if(rec.freshId===\"stale\")parts.push(P(\"Past its peak (\"+st.days+\"d): the app applied +2°C and two steps finer versus this bag at its peak.\",\"تعدّى ذروته (\"+st.days+\" يوم): طبّق التطبيق +٢° ودرجتين أنعم مقارنة بالكيس في قمته.\"));\n  if(st.kind===\"single\"){var p=PROCESSES.find(function(x){return x.id===st.process})||{};if(p.id===\"natural\"||p.id===\"anaerobic\"||p.id===\"coferment\")parts.push(P(\"It is \"+(p.label||\"\").toLowerCase()+\", so gentler pours — the bed is fragile and gassy.\",\"إنها \"+tr(p.label||\"\")+\"، فخلّ صباتك ألطف — الطبقة هشة ومليانة غاز.\"));else if(p.id===\"washed\")parts.push(P(\"Washed, so brew straight for clarity.\",\"مغسولة، فحضّرها على طول — بتعطيك وضوحًا.\"));}\n  else{var b=BLENDS.find(function(x){return x.id===st.blendStyle})||{};if(b.notch||b.temp)parts.push(P((b.label||\"Blend\")+\", nudged coarser and cooler since it is denser and darker-leaning.\",tr(b.label||\"Blend\")+\"، خشّناها وبرّدناها شوي لأنها أكثف وتميل للغامق.\"));}\n  if(rec.iced)parts.push(P(\"Served iced: brewed hot then flash-chilled over ice, ground a touch finer to survive the melt.\",\"تقدَّم باردة: تنحضر حارة وتنزل على الثلج فورًا، ومطحونة أنعم شوي عشان تصمد مع ذوبان الثلج.\"));\n  return parts.join(\" \");\n}\nfunction originWhy(st){\n  if(st.kind===\"blend\"){var b=BLENDS.find(function(x){return x.id===st.blendStyle})||{};return P(\"This is a blend, not a single origin — the only origin-style lever is “\"+(b.label||\"\")+\"”, which \"+((b.notch||b.temp)?\"nudges the grind and temp a little\":\"does not change the numbers\")+\". The actual flavour depends on the roaster mix, so lean on the bag notes.\",\"هذي خلطة مو منشأ واحد — الشيء الوحيد الشبيه بالمنشأ هنا هو “\"+tr(b.label||\"\")+\"”، وهو \"+((b.notch||b.temp)?\"يعدّل الطحنة والحرارة شوي\":\"ما يغيّر الأرقام\")+\". النكهة الحقيقية على خلطة المحمّص، فاعتمد على إيحاءات الكيس.\");}\n  var o=ORIGINS.find(function(x){return x.id===st.origin})||{};var roast=(ROASTS.find(function(x){return x.id===st.roast})||{}).label||\"\";\n  var ch=[];if(o.notch)ch.push(P(o.notch<0?\"ground a touch finer\":\"ground a touch coarser\",o.notch<0?\"مطحونة أنعم شوي\":\"مطحونة أخشن شوي\"));if(o.temp)ch.push(P(o.temp<0?\"brewed a touch cooler\":\"brewed a touch hotter\",o.temp<0?\"محضّرة أبرد شوي\":\"محضّرة أسخن شوي\"));\n  var lead=ch.length?P(o.label+\" is one of the few origins that shifts the recipe: it is \"+ch.join(\" and \")+\" than a default \"+roast+\" coffee.\",tr(o.label)+\" من المناشئ القليلة اللي تغيّر الوصفة: فهي \"+ch.join(\" و\")+\" مقارنة بأي قهوة \"+tr(roast)+\" عادية.\"):P(o.label+\" does not change the recipe numbers — it is the same as any \"+roast+\" coffee. Origin mostly shapes flavour and how gently to brew, not grind or temp.\",tr(o.label)+\" ما تغيّر أرقام الوصفة — مثلها مثل أي قهوة \"+tr(roast)+\". المنشأ يحدد النكهة وطريقة تعاملك معها، مو الطحنة أو الحرارة.\");\n  var tip=o.tip?(\" \"+tr(o.tip)):(o.notes?(P(\" Expect \",\" توقّع \")+tr(o.notes)+\".\"):\"\");\n  return lead+tip;\n}\nfunction coachAdvice(t,st,rec,flw){\n  var light=(st.roast===\"light\"||st.roast===\"med-light\"),dark=(st.roast===\"med-dark\"||st.roast===\"dark\");\n  var temp=rec.temp,hotMax=temp>=99,coolMin=temp<=88,fresh=rec.freshId,days=st.days,bag=(st.bagNotes||\"\").trim();\n  var A={title:\"\",moves:[],age:\"\"};\n  if(t===\"sour\"){A.title=P(\"Sour / sharp = under-extracted\",\"حامض / حاد = استخلاص ناقص\");\n    A.moves.push(hotMax?P(\"Water is already near max — make the change at the grinder: go one step finer.\",\"الماء وصل حده الأعلى — عدّل من المطحنة: درجة وحدة أنعم.\"):P(\"Go one step finer, and/or raise the water 1–2°C (you are at \"+temp+\"°C).\",\"اطحن درجة أنعم، أو ارفع حرارة الماء 1–2°م (أنت الحين عند \"+temp+\"°م).\"));\n    if(flw===\"fast\")A.moves.push(P(\"Your draw-down ran fast — that confirms under-extraction. Go finer, and pour more evenly to stop channeling.\",\"الماء نزل بسرعة — وهذا يؤكد الاستخلاص الناقص. اطحن أنعم واسكب بتساوٍ أكثر عشان ما تصير قنوات.\"));\n    if(dark)A.moves.push(P(\"Sour on a dark roast is unusual — check the water is truly hot and you are not pouring too fast.\",\"حموضة في تحميص غامق شيء غريب — تأكد أن الماء حار فعلًا وأنك ما تسكب بسرعة.\"));\n    if(fresh===\"fresh\")A.age=P(\"It is still early (\"+days+\"d). Fresh coffee off-gasses CO₂ that pushes water away and reads sour — a few more days of rest helps as much as grinding finer.\",\"ما زال الوقت مبكرًا (\"+days+\" يوم). القهوة الطازجة تطلع غازًا يدفع الماء ويبين حامضًا — كم يوم راحة تفيد بقدر الطحنة الأنعم.\");\n  }else if(t===\"bitter\"){A.title=P(\"Bitter / harsh = over-extracted\",\"مرّ / خشن = استخلاص زائد\");\n    A.moves.push((coolMin||dark)?P(\"Your temp is already low — fix it at the grinder: go one step coarser and keep the brew a little shorter. Do not drop temp further.\",\"حرارتك واطية أصلًا — عدّل من المطحنة: درجة أخشن وخلّ التحضير أقصر شوي. لا تنزل الحرارة أكثر.\"):P(\"Go one step coarser, and/or drop the water 1–2°C (you are at \"+temp+\"°C).\",\"اطحن درجة أخشن، أو نزّل حرارة الماء 1–2°م (أنت الحين عند \"+temp+\"°م).\"));\n    if(flw===\"stall\")A.moves.push(P(\"Your draw-down stalled — that confirms over-extraction. Go coarser to speed the flow.\",\"الماء وقف عن النزول — وهذا يؤكد الاستخلاص الزائد. اطحن أخشن عشان يمشي الماء.\"));\n    A.moves.push(P(\"Keep pours even and do not agitate the bed too hard.\",\"خلّ صبك متساويًا ولا تحرّك الطبقة بقوة.\"));\n    if(fresh===\"stale\")A.age=P(\"Past-peak coffee can read bitter-without-sweetness — some of that is age, not extraction. Coarser helps, but do not chase it.\",\"القهوة اللي عدّت نضجها ممكن تطلع مرّة بلا حلاوة — جزء منها عمر مو استخلاص. الأخشن يساعد بس لا تلاحقه.\");\n  }else if(t===\"weak\"){A.title=P(\"Weak / watery = under-strength\",\"ضعيف / مائي = نقص قوة\");\n    A.moves.push(P(\"Pick ONE next brew: grind one step finer (more flavour, same beans), or raise the dose 1–2 g (more strength).\",\"اختر شيئًا واحدًا للتحضير الجاي: درجة أنعم (نكهة أكثر بنفس الحبوب)، أو زد القهوة 1–2 غ (قوة أكثر).\"));\n    if(flw===\"fast\")A.moves.push(P(\"The fast draw-down fits — a finer grind will hold the water longer and build body.\",\"نزول الماء السريع يأكد الشيء نفسه — طحنة أنعم بتمسك الماء أطول وتبني القوام.\"));\n    A.moves.push(P(\"Hollow and thin → grind finer. Clean but light → dose up.\",\"فاضي ورقيق ← اطحن أنعم. نظيف بس خفيف ← زد القهوة.\"));\n    if(fresh===\"stale\")A.age=P(\"Old beans give less, too — at \"+days+\"d a bit more dose and a finer grind both help.\",\"الحبوب القديمة تعطي أقل — عند \"+days+\" يوم، قهوة أكثر شوي وطحنة أنعم كلها تساعد.\");\n  }else if(t===\"strong\"){A.title=P(\"Too strong / muddy = over-strength\",\"قوي جدًا / عكِر = زيادة قوة\");\n    A.moves.push(P(\"Pick ONE: set Strength → Lighter (higher ratio), drop the dose 1–2 g, or go one step coarser.\",\"اختر شيئًا واحدًا: القوة ← أخف (ماء أكثر)، أو قلّل القهوة 1–2 غ، أو اطحن درجة أخشن.\"));\n    if(flw===\"stall\")A.moves.push(P(\"The stalled draw-down fits — coarser will speed flow and ease the over-extraction.\",\"توقف النزول يأكدها — الأخشن يمشّي الماء ويخفف الاستخلاص الزائد.\"));\n    A.moves.push(P(\"Muddiness is usually too fine or too much agitation — coarser + gentler pours clean it up.\",\"العكارة غالبًا طحنة ناعمة زيادة أو تحريك زائد — خشّن واسكب ألطف وبتصفى.\"));\n  }else if(t===\"flat\"){A.title=P(\"Flat / no clarity = muddled extraction\",\"باهت / بلا وضوح = استخلاص مشوّش\");\n    A.moves.push(P(\"Aim for even extraction: consistent grind, a level bed, gentle even pours. A step coarser and pouring a little higher lifts definition.\",\"هدفك استخلاص متساوٍ: طحنة ثابتة وطبقة مستوية وصب لطيف متساوٍ. درجة أخشن وصب من شوي أعلى يرفعان الوضوح.\"));\n    if(flw===\"stall\")A.moves.push(P(\"A stalled, uneven bed muddies clarity — coarser and gentler pours help.\",\"الطبقة الواقفة غير المتساوية تعكّر الوضوح — خشّن واسكب ألطف.\"));\n    if(fresh===\"stale\"||fresh===\"aging\")A.age=P(\"Flatness is the classic sign of age — aromatics fade first. Past \"+days+\" days, technique recovers only so much.\",\"البهتان أوضح علامات العمر — العطريات تروح أول. بعد \"+days+\" يوم، مهارتك ترجع لك جزءًا بسيطًا بس.\");\n    else if(fresh===\"fresh\")A.age=P(\"Very fresh coffee can muddle from CO₂ — a few days of rest sharpens clarity.\",\"القهوة الطازجة مرّة ممكن يشوشها الغاز — كم يوم راحة يصفّي الوضوح.\");\n  }else if(t===\"nonotes\"){A.title=P(\"Did not taste the notes\",\"لم تتذوّق النكهات\");\n    if(bag)A.moves.push(P(\"Delicate notes (\"+bag+\") get buried by over-extraction and heat. Go one step coarser, drop 1–2°C, and pour gently to protect the aromatics.\",\"النكهات الرقيقة (\"+bag+\") تندفن مع الحرارة والاستخلاص الزائد. درجة أخشن، ونزّل 1–2°م، واسكب بلطف عشان العطريات.\"));\n    else A.moves.push(P(\"Add the bag notes above and I can target this. Generally, clarity comes from even extraction — consistent grind, gentle even pours, not too hot.\",\"أضف إيحاءات القهوة فوق وأقدر أستهدفها. عمومًا الوضوح يجي من استخلاص متساوٍ — طحنة ثابتة وصب لطيف وماء مو حار زيادة.\"));\n    if(light)A.moves.push(P(\"Light roasts hold the most delicate notes but need a clean, even extraction to show them.\",\"التحميص الفاتح فيه أرقّ النكهات، بس يبي استخلاصًا نظيفًا متساويًا عشان تبان.\"));\n    if(fresh===\"aging\"||fresh===\"stale\")A.age=P(\"At \"+days+\" days past roast, the lightest aromatics fade first — some of those notes may simply be gone. That is age, not your technique.\",\"عند \"+days+\" يوم من التحميص، أخف العطريات تروح أول — يمكن بعض النكهات راحت فعلًا. هذا عمر القهوة مو تقنيتك.\");\n  }\n  A.why=(lang===\"ar\"?{sour:\"حامض = استخلاص ناقص: سحبت الأحماض الحية بس ما سحبت السكريات والقوام اللي توازنها، فطلع الطعم حادًا.\",bitter:\"مرّ = استخلاص زائد: بعد نقطة التوازن يبدأ الماء يسحب مركّبات خشنة وجافة.\",weak:\"ضعيف = قوة ناقصة: ذاب شيء قليل من القهوة في الماء، فطلع الطعم خفيفًا.\",strong:\"قوي جدًا = ذاب أكثر من اللازم، أو ببساطة قهوة زيادة — مركّز وأحيانًا عكر.\",flat:\"باهت = استخلاص غير متساوٍ: لا شيء يبرز، غالبًا طبقة غير متساوية أو حبوب تعبانة.\",nonotes:\"غياب النكهات غالبًا معناه أن العطريات الرقيقة اندفنت (حرارة أو استخلاص زائد) أو راحت مع العمر.\"}:{sour:\"Sour = under-extracted: you have pulled the bright acids but not the sugars and body that balance them, so it reads sharp.\",bitter:\"Bitter = over-extracted: past the sweet spot, water starts stripping harsh, drying compounds.\",weak:\"Weak = under-strength: too little coffee actually dissolved into the water, so it tastes thin.\",strong:\"Too strong = too much dissolved, or simply too much coffee — intense and sometimes muddy.\",flat:\"Flat = uneven or dulled extraction: nothing stands out, often an uneven bed or tired beans.\",nonotes:\"Missing the notes usually means the delicate aromatics got buried (too hot / over-extracted) or have faded with age.\"})[t]||\"\";\n  if(rec.iced){if(t===\"weak\")A.moves.push(P(\"Over ice, watery usually means too much ice or the grind is too coarse — cut the ice (try 40%) or go finer before adding dose.\",\"مع الثلج، الطعم المائي غالبًا ثلج زيادة أو طحنة أخشن — قلّل الثلج (جرب 40%) أو اطحن أنعم قبل ما تزيد القهوة.\"));else if(t===\"strong\")A.moves.push(P(\"Too intense cold — more ice (50/50) or a coarser grind eases it.\",\"مركّز مرّة وهو بارد — زد الثلج (50/50) أو خشّن الطحنة.\"));else if(t===\"sour\")A.moves.push(P(\"Cold sharpens acidity — go finer/hotter as usual, or use less ice if it is too tart.\",\"البرودة تبرز الحموضة — اطحن أنعم أو سخّن أكثر كالعادة، أو قلّل الثلج لو كان لاذعًا.\"));else if(t===\"bitter\")A.moves.push(P(\"Harsh when cold — a coarser grind or a touch more ice softens it.\",\"خشن وهو بارد — طحنة أخشن أو ثلج أكثر شوي ينعّمه.\"));}\n  return A;\n}\nfunction coachApply(sym,st,rec){\n  var g=GRINDERS.find(function(x){return x.id===((({\"1z-jmax\":\"1z-j\",\"1z-jultra\":\"1z-j\"})[st.grinder])||st.grinder)})||{};var notch=rec.notch,temp=rec.temp;\n  var finerB=grindLimit(g,notch,-1),coarserB=grindLimit(g,notch,1),canHot=temp<100,canCool=temp>82;\n  var STR=[\"light\",\"balanced\",\"strong\"],si=STR.indexOf(st.strength);\n  var jn=0;for(var ji=JOURNEY.length-1;ji>=0&&JOURNEY[ji].taste===sym;ji--)jn++;var over=Math.max((streak.sym===sym)?streak.n:0,jn);var healthy=(flow===\"ok\");var lastJ=JOURNEY.length?JOURNEY[JOURNEY.length-1]:null;var overshoot=lastJ&&((sym===\"sour\"&&lastJ.taste===\"bitter\"&&(lastJ.action===\"→ coarser\"||lastJ.action===\"→ -2°C\"))||(sym===\"bitter\"&&lastJ.taste===\"sour\"&&(lastJ.action===\"→ finer\"||lastJ.action===\"→ +2°C\")));var osNote=overshoot?P(\"Last change overshot (\"+tlabel(lastJ.taste)+\" \"+lastJ.action+\" → now \"+tlabel(sym)+\"). Correcting gently rather than swinging back.\",\"تعديلنا السابق تعدّى الهدف (\"+tlabel(lastJ.taste)+\" \"+actLabel(lastJ.action)+\" ← الآن \"+tlabel(sym)+\"). نصحّح بخطوة صغيرة بدل الرجوع الكامل.\"):\"\";\n  function A(label,note,action,fn){return{label:label,note:note||\"\",action:action,act:fn};}\n  if(sym===\"sour\"){\n    if(overshoot){if((lastJ.action===\"→ coarser\")&&canHot)return A(P(\"Apply · raise temp 1–2°C\",\"طبّق · ارفع الحرارة 1–2°م\"),osNote,\"→ +2°C\",function(){st.tempAdj=(st.tempAdj||0)+2;});if((lastJ.action===\"→ -2°C\")&&!finerB)return A(P(\"Apply · grind one step finer\",\"طبّق · اطحن درجة أنعم\"),osNote,\"→ finer\",function(){st.grindAdj=(st.grindAdj||0)-1;});}\n    if(healthy&&canHot)return A(P(\"Apply · raise temp 2°C\",\"طبّق · ارفع الحرارة 2°م\"),P(\"Draw-down was healthy, so flow is fine — temperature is the more surgical fix than grinding.\",\"نزول الماء كان سليمًا، يعني التدفق تمام — الحرارة هنا أدق من الطحنة.\"),\"→ +2°C\",function(){st.tempAdj=(st.tempAdj||0)+2;});\n    if(!finerB&&over<2)return A(P(\"Apply · grind one step finer\",\"طبّق · اطحن درجة أنعم\"),\"\",\"→ finer\",function(){st.grindAdj=(st.grindAdj||0)-1;});\n    if(canHot)return A(P(\"Apply · raise temp 2°C\",\"طبّق · ارفع الحرارة 2°م\"),finerB?P(\"Grind is already at its finest — using temperature instead.\",\"الطحنة عند أنعم حد — بنستخدم الحرارة بدالها.\"):P(\"Grind has done its part — trying temperature now.\",\"الطحنة سوّت اللي عليها — نجرب الحرارة الحين.\"),\"→ +2°C\",function(){st.tempAdj=(st.tempAdj||0)+2;});\n    return{note:P(\"You are at the limits of grind and temperature. If it is still sour, the cause is likely pour technique (channeling) or beans that need more rest — not the settings.\",\"وصلنا حدود الطحنة والحرارة. لو ما زالت حامضة، الغالب السبب طريقة الصب (قنوات) أو حبوب تبي راحة أطول — مو الإعدادات.\")};\n  }\n  if(sym===\"bitter\"){\n    if(overshoot){if((lastJ.action===\"→ finer\")&&canCool)return A(P(\"Apply · drop temp 1–2°C\",\"طبّق · اخفض الحرارة 1–2°م\"),osNote,\"→ -2°C\",function(){st.tempAdj=(st.tempAdj||0)-2;});if((lastJ.action===\"→ +2°C\")&&!coarserB)return A(P(\"Apply · grind one step coarser\",\"طبّق · اطحن درجة أخشن\"),osNote,\"→ coarser\",function(){st.grindAdj=(st.grindAdj||0)+1;});}\n    if(healthy&&canCool)return A(P(\"Apply · drop temp 2°C\",\"طبّق · اخفض الحرارة 2°م\"),P(\"Draw-down was healthy, so flow is fine — temperature is the more surgical fix than grinding.\",\"نزول الماء كان سليمًا، يعني التدفق تمام — الحرارة هنا أدق من الطحنة.\"),\"→ -2°C\",function(){st.tempAdj=(st.tempAdj||0)-2;});\n    if(!coarserB&&over<2)return A(P(\"Apply · grind one step coarser\",\"طبّق · اطحن درجة أخشن\"),\"\",\"→ coarser\",function(){st.grindAdj=(st.grindAdj||0)+1;});\n    if(canCool)return A(P(\"Apply · drop temp 2°C\",\"طبّق · اخفض الحرارة 2°م\"),coarserB?P(\"Grind is already at its coarsest — using temperature instead.\",\"الطحنة عند أخشن حد — بنستخدم الحرارة بدالها.\"):P(\"Grind has done its part — trying temperature now.\",\"الطحنة سوّت اللي عليها — نجرب الحرارة الحين.\"),\"→ -2°C\",function(){st.tempAdj=(st.tempAdj||0)-2;});\n    return{note:P(\"You are at the limits of grind and temperature. If it is still bitter, look at pour technique (too much agitation) or an over-dark roast — not the settings.\",\"وصلنا حدود الطحنة والحرارة. لو ما زالت مرّة، شف طريقة الصب (تحريك زائد) أو تحميص غامق زيادة — مو الإعدادات.\")};\n  }\n  if(sym===\"weak\"){\n    if(!finerB&&over<2)return A(P(\"Apply · grind one step finer\",\"طبّق · اطحن درجة أنعم\"),P(\"Builds body and flavour without changing the beans.\",\"يبني القوام والنكهة بدون ما تغيّر الحبوب.\"),\"→ finer\",function(){st.grindAdj=(st.grindAdj||0)-1;});\n    if(si<2)return A(P(\"Apply · Strength → stronger\",\"طبّق · القوة ← أقوى\"),P(\"More coffee per gram of water for more strength.\",\"قهوة أكثر لكل غرام ماء = قوة أكبر.\"),\"→ stronger\",function(){st.strength=STR[Math.min(2,si+1)];});\n    return{note:P(\"Grind and strength are maxed. To go stronger still, raise the dose a little on the build screen.\",\"الطحنة والقوة وصلتا الحد. لو تبي أقوى، زد القهوة شوي من شاشة التحضير.\")};\n  }\n  if(sym===\"strong\"){\n    if(si>0)return A(P(\"Apply · Strength → lighter\",\"طبّق · القوة ← أخف\"),P(\"More water per gram to ease the intensity.\",\"ماء أكثر لكل غرام = تركيز أخف.\"),\"→ lighter\",function(){st.strength=STR[Math.max(0,si-1)];});\n    if(!coarserB)return A(P(\"Apply · grind one step coarser\",\"طبّق · اطحن درجة أخشن\"),\"\",\"→ coarser\",function(){st.grindAdj=(st.grindAdj||0)+1;});\n    return{note:P(\"Already at the lightest strength and a coarse grind — drop the dose on the build screen to go further.\",\"أنت عند أخف قوة وأخشن طحنة — قلّل القهوة من شاشة التحضير لو تبي أكثر.\")};\n  }\n  if(sym===\"flat\"){\n    if(!coarserB&&over<2)return A(P(\"Apply · grind one step coarser\",\"طبّق · اطحن درجة أخشن\"),P(\"Coarser plus gentler, even pours lifts definition and clarity.\",\"الأخشن مع صبّ ألطف وأكثر تساويًا يرفع الوضوح.\"),\"→ coarser\",function(){st.grindAdj=(st.grindAdj||0)+1;});\n    return{note:P(\"Flatness past this point is usually technique or bean age, not the settings — pour evenly and check the roast date.\",\"البهتان بعد هذا الحد عادةً تقنية أو عمر الحبوب لا الإعدادات — اسكب بتساوٍ وتحقق من تاريخ التحميص.\")};\n  }\n  if(sym===\"nonotes\"){\n    if(canCool)return A(P(\"Apply · drop temp 2°C\",\"طبّق · اخفض الحرارة 2°م\"),P(\"Cooler water protects delicate aromatics. Pour gently too.\",\"الماء الأبرد يحمي العطريات الرقيقة. واسكب بلطف بعد.\"),\"→ -2°C\",function(){st.tempAdj=(st.tempAdj||0)-2;});\n    return{note:P(\"Temperature is as low as it goes. Missing notes here is usually pour technique, or the beans having faded with age.\",\"الحرارة عند أدنى حد. غياب النكهات هنا غالبًا طريقة الصب، أو حبوب راح وقتها.\")};\n  }\n  return null;\n}\nfunction tasteHelp(){\n  var pair='<div class=\"thelp-pair\">'+\n    '<div class=\"thelp-card sour\"><div class=\"thelp-term\">'+P(\"Sour / sharp\",\"حامض / حاد\")+'</div><div class=\"thelp-taste\">'+P(\"Usually tastes sharp and tangy — like biting underripe fruit or a squeeze of lemon.\",\"غالبًا حاد ولاذع — مثل قضمة فاكهة ما نضجت أو عصرة ليمون.\")+'</div><div class=\"thelp-fix\">'+P(\"Under-extracted → wants MORE (finer / hotter).\",\"استخلاص ناقص ← يبي أكثر (أنعم / أسخن).\")+'</div></div>'+\n    '<div class=\"thelp-vs\">'+P(\"vs\",\"مقابل\")+'</div>'+\n    '<div class=\"thelp-card bitter\"><div class=\"thelp-term\">'+P(\"Bitter / harsh\",\"مرّ / خشن\")+'</div><div class=\"thelp-taste\">'+P(\"Usually tastes harsh and drying — like burnt toast or dark cocoa, lingering at the back of the throat.\",\"غالبًا خشن وجاف — مثل خبز محروق أو كاكاو غامق، يعلق آخر الحلق.\")+'</div><div class=\"thelp-fix\">'+P(\"Over-extracted → wants LESS (coarser / cooler).\",\"استخلاص زائد ← يبي أقل (أخشن / أبرد).\")+'</div></div>'+\n    '</div>';\n  var rows=[\n    [P(\"Weak / watery\",\"ضعيف / مائي\"),P(\"Thin, not much flavour — like tea that did not steep long enough. Needs more coffee dissolved.\",\"خفيف ونكهته قليلة — مثل شاي ما انتقع كفاية. يبي قهوة ذايبة أكثر.\")],\n    [P(\"Too strong\",\"قوي جدًا\"),P(\"Intense and heavy, sometimes muddy — too much dissolved. Needs easing back.\",\"مركّز وثقيل، وأحيانًا عكر — ذاب أكثر من اللازم. يبي تخفيفًا.\")],\n    [P(\"Flat / no clarity\",\"باهت / بلا وضوح\"),P(\"Nothing stands out — no liveliness, no clear notes. Often uneven extraction or tired beans.\",\"لا شيء يبرز — لا حيوية ولا نكهات واضحة. غالبًا استخلاص غير متساوٍ أو حبوب تعبانة.\")],\n    [P(\"Notes missing\",\"النكهات غائبة\"),P(\"The bag flavours are not coming through — usually buried by heat / over-extraction, or faded with age.\",\"إيحاءات الكيس ما تبين — غالبًا مدفونة بالحرارة أو الاستخلاص الزائد، أو راحت مع العمر.\")]\n  ].map(function(r){return '<div class=\"thelp-row\"><b>'+r[0]+'</b> — '+r[1]+'</div>';}).join('');\n  var foot='<div class=\"thelp-foot\">'+P(\"“Usually tastes like” — taste is personal; these are common descriptions, not hard rules.\",\"«غالبًا طعمها كذا» — التذوق شخصي؛ هذي أوصاف شائعة مو قواعد ثابتة.\")+'</div>';\n  return '<div class=\"thelp\">'+pair+'<div class=\"thelp-rest\">'+rows+'</div>'+foot+'</div>';\n}\nfunction flowHelp(){\n  var rows=[\n    [P(\"Fast\",\"سريع\"),P(\"Water drained quickly after your last pour. Usually grind too coarse (or channeling) → often reads weak or sour.\",\"الماء نزل بسرعة بعد آخر صبة. غالبًا الطحنة أخشن من اللازم (أو صارت قنوات) ← يطلع ضعيفًا أو حامضًا.\")],\n    [P(\"Healthy\",\"صحّي\"),P(\"Drained in a steady, even time — the bed extracted evenly. This is the target.\",\"نزل بوقت ثابت ومتساوٍ — الطبقة استخلصت بتساوٍ. هذا هو الهدف.\")],\n    [P(\"Stalled\",\"متوقّف\"),P(\"Water pooled and drained slowly. Usually grind too fine (or over-agitated) → often reads bitter or muddy.\",\"الماء تجمّع ونزل ببطء. غالبًا الطحنة أنعم من اللازم (أو تحريك زائد) ← يطلع مرًّا أو عكرًا.\")]\n  ].map(function(r){return '<div class=\"thelp-row\"><b>'+r[0]+'</b> — '+r[1]+'</div>';}).join('');\n  var foot='<div class=\"thelp-foot\">'+P(\"Draw-down is the time water takes to drain after the final pour — a quick read on whether your grind is in the right zone.\",\"التصريف هو الوقت اللي ياخذه الماء عشان ينزل بعد آخر صبة — مؤشر سريع يقول لك إن طحنتك بالنطاق الصح.\")+'</div>';\n  return '<div class=\"thelp\"><div class=\"thelp-rest\">'+rows+'</div>'+foot+'</div>';\n}\nvar NL=String.fromCharCode(10);\nfunction shareText(rec){\n  var L=[];\n  L.push(\"☕ \"+rec.coffee+\" — \"+rec.method);\n  L.push(rec.dose+P(\"g\",\"غ\")+\" \"+P(\"coffee\",\"قهوة\")+\" · \"+rec.totalWater+P(\"ml\",\"مل\")+\" \"+P(\"water\",\"ماء\")+\" · \"+rec.ratioStr);\n  L.push(rec.temp+P(\"°C\",\"°م\")+\" · \"+tr(\"Grind\")+\": \"+rec.grindNumber+(rec.grinderLabel?(\" (\"+rec.grinderLabel+\")\"):\"\"));\n  if(rec.iced)L.push(P(\"❄ \"+rec.brewWater+\"ml hot onto \"+rec.iceWeight+\"g ice\",\"❄ \"+rec.brewWater+\"مل ساخن على \"+rec.iceWeight+\"غ ثلج\"));\n  L.push(\"\");\n  rec.pours.forEach(function(p){L.push(fmt(p.t)+\"  \"+plab(p.label)+\" → \"+p.cum+P(\"ml\",\"مل\"));});\n  L.push(P(\"Finish \",\"النهاية \")+rec.finishRange);\n  L.push(\"\");\n  L.push(\"— Coffee Way Standard · Abdulmajeed Alwahieb\");\n  try{var codeStr=compactCode();L.push(\"\");L.push(P(\"Import code (paste in the app):\",\"رمز الاستيراد (الصقه في التطبيق):\"));L.push(codeStr);}catch(e){}\n  return L.join(NL);\n}\nfunction showToast(msg){var t=document.getElementById(\"toast\");t.textContent=msg;t.classList.add(\"show\");setTimeout(function(){t.classList.remove(\"show\");},1800);}\nfunction copyFallback(txt){var ta=document.createElement(\"textarea\");ta.value=txt;ta.style.position=\"fixed\";ta.style.opacity=\"0\";document.body.appendChild(ta);ta.focus();ta.select();var ok=false;try{ok=document.execCommand(\"copy\");}catch(e){}document.body.removeChild(ta);showToast(ok?P(\"Copied ✓\",\"تم النسخ ✓\"):P(\"Could not copy\",\"تعذّر النسخ\"));}\nfunction shareCard(){try{var rec=buildRecipe(state);var W=1080,H=1350,cv=document.createElement(\"canvas\");cv.width=W;cv.height=H;var x=cv.getContext(\"2d\");var ar=(lang===\"ar\");\nx.fillStyle=\"#17120E\";x.fillRect(0,0,W,H);\nx.fillStyle=\"#D2792E\";x.font=\"600 34px JetBrains Mono, monospace\";x.textAlign=\"center\";x.fillText(\"COFFEE WAY STANDARD\",W/2,110);\nx.fillStyle=\"#F4EEE3\";x.font=\"700 84px Space Grotesk, Noto Sans Arabic, sans-serif\";x.fillText(rec.coffee,W/2,240);\nx.fillStyle=\"#A28F78\";x.font=\"500 40px Noto Sans Arabic, sans-serif\";x.fillText(rec.method,W/2,310);\nvar rows=[[P(\"Dose\",\"الجرعة\"),rec.dose+P(\"g\",\"غ\")],[P(\"Water\",\"الماء\"),rec.totalWater+P(\"ml\",\"مل\")],[P(\"Ratio\",\"النسبة\"),rec.ratioStr],[P(\"Temp\",\"الحرارة\"),rec.temp+P(\"°C\",\"°م\")],[tr(\"Grind\"),String(rec.grindNumber)]];\nx.font=\"600 44px Noto Sans Arabic, sans-serif\";var y=430;\nfor(var i=0;i<rows.length;i++){x.fillStyle=\"#7A6A57\";x.textAlign=ar?\"right\":\"left\";x.fillText(rows[i][0],ar?W-90:90,y);x.fillStyle=\"#F4EEE3\";x.textAlign=ar?\"left\":\"right\";x.fillText(rows[i][1],ar?90:W-90,y);y+=78;}\nx.strokeStyle=\"#3a2f24\";x.beginPath();x.moveTo(90,y-30);x.lineTo(W-90,y-30);x.stroke();\nx.font=\"500 42px Noto Sans Arabic, sans-serif\";y+=30;\nfor(var j=0;j<rec.pours.length;j++){var p=rec.pours[j];x.fillStyle=\"#D2792E\";x.textAlign=ar?\"right\":\"left\";x.fillText(fmt(p.t),ar?W-90:90,y);x.fillStyle=\"#F4EEE3\";x.fillText(plab(p.label),ar?W-250:250,y);x.fillStyle=\"#3E8E8E\";x.textAlign=ar?\"left\":\"right\";x.fillText(P(\"to \",\"حتى \")+p.cum+P(\"ml\",\"مل\"),ar?90:W-90,y);y+=70;}\nx.fillStyle=\"#7A6A57\";x.textAlign=ar?\"right\":\"left\";x.font=\"500 40px Noto Sans Arabic, sans-serif\";x.fillText(P(\"Finish \",\"النهاية \")+rec.finishRange,ar?W-90:90,y+10);\nx.fillStyle=\"#5A4E40\";x.textAlign=\"center\";x.font=\"500 30px Noto Sans Arabic, sans-serif\";x.fillText(P(\"Coffee Way Standard · by Abdulmajeed Alwahieb\",\"Coffee Way Standard · إعداد عبدالمجيد الوهيب\"),W/2,H-70);\nvar url=cv.toDataURL(\"image/png\");cv.width=1;cv.height=1;var ov=document.getElementById(\"cardOverlay\");ov.innerHTML=\"<div class=co-in><img src=\"+url+\"><div class=co-hint>\"+P(\"Long-press the image to save or share\",\"اضغط مطوّلًا على الصورة للحفظ أو المشاركة\")+\"</div><button class=co-close id=coClose>\"+tr(\"Close\")+\"</button></div>\";ov.style.display=\"flex\";document.getElementById(\"coClose\").addEventListener(\"click\",function(){ov.style.display=\"none\";ov.innerHTML=\"\";});\n}catch(e){showToast(P(\"Could not build the card\",\"تعذّر إنشاء البطاقة\"));}}\nfunction doShare(){var txt=shareText(buildRecipe(state));\n  if(navigator.share){try{navigator.share({text:txt});return;}catch(e){}}\n  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(txt).then(function(){showToast(P(\"Copied ✓\",\"تم النسخ ✓\"));},function(){copyFallback(txt);});return;}\n  copyFallback(txt);\n}\nfunction actHuman(a){var M={\"→ finer\":P(\"one step finer\",\"أنعم بدرجة\"),\"→ coarser\":P(\"one step coarser\",\"أخشن بدرجة\"),\"→ +2°C\":P(\"2°C hotter\",\"أسخن بدرجتين\"),\"→ -2°C\":P(\"2°C cooler\",\"أبرد بدرجتين\"),\"→ stronger\":P(\"a stronger ratio\",\"نسبة أقوى\"),\"→ lighter\":P(\"a lighter ratio\",\"نسبة أخف\")};return M[a]||actLabel(a);}\nfunction trailStatus(){var n=JOURNEY.length;if(!n)return \"\";var last=JOURNEY[n-1];if(last.taste===\"great\")return P(\"Dialed in after \"+n+\" step\"+(n>1?\"s\":\"\")+\" ✓ — this is your recipe.\",\"ضبطناها بعد \"+n+\" خطوة ✓ — هذي وصفتك.\");return P(\"Step \"+(n+1)+\": brew with the change (\"+actHuman(last.action)+\"), then report the taste above.\",\"الخطوة \"+(n+1)+\": حضّر بعد التعديل (\"+actHuman(last.action)+\")، ثم قيّم الطعم بالأعلى.\");}\nfunction trailHtml(){if(!activeBagId)return \"\";if(!JOURNEY.length)return \"\";var rows=JOURNEY.map(function(j,i){return '<div class=\"jrow'+(j.taste===\"great\"?\" jgreat\":\"\")+'\"><span class=\"jn\">'+(i+1)+'</span><span class=\"jt\">'+tlabel(j.taste)+'</span><span class=\"ja\">'+actLabel(j.action)+'</span><span class=\"jm\">'+(j.grind!=null?(lang===\"ar\"?String(j.grind).split(\"clicks\").join(\"نقرة\").split(\"turns\").join(\"دورة\"):j.grind):\"\")+(j.grind!=null?\" · \":\"\")+j.temp+'°</span></div>';}).join(\"\");return '<div class=\"jtrail\"><div class=\"jhead\"><span>'+P(\"Dial-in trail\",\"مسار المعايرة\")+'</span><button class=\"jundo\" data-jundo=\"1\">'+P(\"undo last\",\"تراجع\")+'</button><button class=\"jreset\" data-jreset=\"1\">'+P(\"reset\",\"تصفير\")+'</button></div><div class=\"jstatus\">'+trailStatus()+'</div>'+rows+'</div>';}\nfunction coachHtml(rec){\n  var ts=[[\"sour\",\"Sour / sharp\"],[\"bitter\",\"Bitter / harsh\"],[\"weak\",\"Weak / watery\"],[\"strong\",\"Too strong\"],[\"flat\",\"Flat / no clarity\"],[\"nonotes\",\"Notes missing\"],[\"great\",\"Tasted great ✓\"]];\n  var chips=ts.map(function(tp){var cls=\"taste\"+(tp[0]===\"great\"?\" great\":\"\")+(taste===tp[0]?\" active\":\"\");return '<button class=\"'+cls+'\" data-taste=\"'+tp[0]+'\">'+tr(tp[1])+'</button>'}).join('');\n  var hint=\"\";\n  if(taste&&taste!==\"great\"){var a=coachAdvice(taste,state,rec,flow);var ap=coachApply(taste,state,rec);var apHtml=ap?((ap.act?'<button class=\"applybtn\" data-apply=\"1\">'+ap.label+'</button>':'')+(ap.note?'<div class=\"chint-note\">'+ap.note+'</div>':'')):'';hint='<div class=\"chint\"><div class=\"chint-title\">'+a.title+'</div>'+(a.why?'<div class=\"chint-why\">'+a.why+'</div>':'')+a.moves.map(function(m){return '<div class=\"chint-move\">'+m+'</div>'}).join('')+(a.age?'<div class=\"chint-age\">'+a.age+'</div>':'')+apHtml+'</div>';}\n  return '<div class=\"coach\"><div class=\"coach-q\">'+tr(\"How did it taste? Tap to dial in the next brew\")+' <button class=\"thelp-btn\" data-tastehelp=\"1\">?</button></div>'+(tasteHelpOpen?tasteHelp():'')+'<div class=\"tastes\">'+chips+'</div>'+hint+trailHtml()+'</div>';\n}\nfunction renderCard(){card.innerHTML=cardInner(buildRecipe(state))}\nfunction today(){return new Date().toISOString().slice(0,10)}\nfunction parseFin(v){v=String(v||\"\").trim();if(!v)return 0;var mm=/^([0-9]+):([0-5][0-9])$/.exec(v);if(mm)return +mm[1]*60+ +mm[2];if(!/^[0-9]+$/.test(v))return 0;if(v.length<=2)return +v*60;var ss=+v.slice(-2),mn=+v.slice(0,-2);return ss<60?mn*60+ss:0;}\nfunction snapshot(){return JSON.parse(JSON.stringify(state))}\nvar STATE_DEFAULTS;\nfunction compactCode(){var snap=snapshot();var d={brewer:snap.brewer,roast:snap.roast};for(var k in snap){if(!STATE_DEFAULTS||JSON.stringify(snap[k])!==JSON.stringify(STATE_DEFAULTS[k]))d[k]=snap[k];}return \"CWS1.\"+btoa(unescape(encodeURIComponent(JSON.stringify(d))));}\nfunction summaryOf(rec){return rec.grindNumber+\" · \"+rec.temp+\"°C · \"+rec.totalWater+\"g · \"+rec.ratioStr}\nvar TASTE_LABELS={sour:\"Sour\",bitter:\"Bitter\",weak:\"Weak\",strong:\"Too strong\",flat:\"Flat\",nonotes:\"Notes missing\"};\nfunction retentionCalc(rec){var pe=document.getElementById(\"poured\"),ce=document.getElementById(\"cupOut\");var pv=parseFloat(pe&&pe.value);if(isNaN(pv))pv=rec.totalWater;var ov=parseFloat(ce&&ce.value);if(isNaN(ov))return{poured:pv,measured:false};if(ov>pv)return{poured:pv,measured:true,invalid:true,out:ov};var retained=Math.round(pv-ov),pct=Math.round(ov/pv*100),r=retained/rec.dose,fl=null,verdict=\"\";if(rec.immersion){verdict=\"Immersion holds water differently — retention is less diagnostic here.\";fl=null;}else if(r<1.3){verdict=\"Ran fast — usually grind too coarse or channeling (expect weak/sour).\";fl=\"fast\";}else if(r>2.7){verdict=\"Stalled — usually grind too fine or over-agitated (expect bitter/muddy).\";fl=\"stall\";}else{verdict=\"Healthy draw-down.\";fl=\"ok\";}return{poured:pv,measured:true,retained:retained,pct:pct,r:r,verdict:verdict,flow:fl,out:ov};}\nfunction recordTimerFinish(){var secs=Math.round(tElapsed);if(secs<30)return;var ft=document.getElementById('finTime');if(ft){ft.value=fmt(secs);}renderAfterBrew();var rc=document.getElementById('retResult');showToast(P('Recorded your brew time: ','سُجّل وقت تحضيرك: ')+fmt(secs));}\nfunction renderAfterBrew(){var rec=buildRecipe(state);var p=document.getElementById(\"poured\");if(p&&!p.value)p.placeholder=String(rec.totalWater);var info=retentionCalc(rec);var prevFt=(document.getElementById(\"finTime\")||{}).value||\"\";var html='<div class=\"ab-f\" style=\"margin-bottom:12px\"><label class=\"ab-l\">'+P(\"Finish time — just type digits: 425 = 4:25\",\"وقت النهاية — اكتب الأرقام فقط: 425 = 4:25\")+'</label><input id=\"finTime\" class=\"txt\" inputmode=\"numeric\" placeholder=\"3:25\" value=\"'+escName(prevFt)+'\"></div>'+P('<div class=\"ab-exp\">Target: ~'+rec.incupEst+'ml in cup (~'+rec.retainedEst+'ml held by the grounds).</div>','<div class=\"ab-exp\">الهدف: ~'+rec.incupEst+'مل في الفنجان (~'+rec.retainedEst+'مل تحتجزها القهوة المطحونة).</div>');if(info.measured){if(info.invalid){html+=P('<div class=\"ab-verdict stall\">That cannot be right — coffee in the cup ('+info.out+'ml) is more than the water poured ('+info.poured+'ml). Fill in Water poured with what you actually used (total water, including any ice), then re-check.</div>','<div class=\"ab-verdict stall\">هذا غير ممكن — القهوة في الفنجان ('+info.out+'مل) أكثر من الماء المصبوب ('+info.poured+'مل). أدخِل الماء المصبوب بما استخدمته فعلًا (إجمالي الماء مع أي ثلج) ثم أعد الفحص.</div>');}else{html+=P('<div class=\"ab-you\">You: '+info.out+'ml in cup · '+info.pct+'% · '+info.retained+'ml held</div>','<div class=\"ab-you\">أنت: '+info.out+'مل في الفنجان · '+info.pct+'% · '+info.retained+'مل محتجز</div>')+'<div class=\"ab-verdict '+(info.flow||\"\")+'\">'+tr(info.verdict)+(info.verdict?' <button class=\"thelp-btn\" data-flowhelp=\"1\">?</button>':'')+'</div>'+(flowHelpOpen&&info.verdict?flowHelp():'');}}var rr=document.getElementById(\"retResult\");if(rr)rr.innerHTML=html;flow=(info.measured&&!info.invalid)?info.flow:null;var ftEl=document.getElementById(\"finTime\");var ftRaw=(ftEl&&ftEl.value||\"\").trim();if(ftRaw){var fsec=parseFin(ftRaw)||NaN;if(!isNaN(fsec)&&fsec>30){var fv=(fsec<rec.finishLo-15)?\"fast\":((fsec>rec.finishHi+30)?\"stall\":\"ok\");flow=fv;var rr2=document.getElementById(\"retResult\");if(rr2){rr2.innerHTML+=P('<div class=\"ab-you\">Your finish '+fmt(fsec)+' — '+(fv===\"ok\"?\"inside the window.\":(fv===\"fast\"?\"faster than target — grind is too coarse. Try 1–2 steps finer.\":\"slower than target — grind is too fine. Try 1–2 steps coarser.\"))+'</div>','<div class=\"ab-you\">نهايتك '+fmt(fsec)+' — '+(fv===\"ok\"?\"داخل النطاق.\":(fv===\"fast\"?\"أسرع من الهدف — الطحنة خشنة. جرّب درجة أو درجتين أنعم.\":\"أبطأ من الهدف — الطحنة ناعمة. جرّب درجة أو درجتين أخشن.\"))+'</div>');if(fv!==\"ok\"){rr2.innerHTML+='<button class=\"finapply\" data-finapply=\"'+fv+'\">'+P(fv===\"fast\"?\"Log this — go 1 step finer\":\"Log this — go 1 step coarser\",fv===\"fast\"?\"سجّل هذا — درجة أنعم\":\"سجّل هذا — درجة أخشن\")+'</button>';}}}}}\nfunction brewEntry(rec,verdict,action){var info=retentionCalc(rec);var ftEl=document.getElementById(\"finTime\");var ftv=(ftEl&&ftEl.value||\"\").trim();var ftSec=parseFin(ftv);var ret=(info.measured&&!info.invalid)?(info.pct+\"% in cup\"+(info.flow&&info.flow!==\"ok\"?\" · \"+({fast:\"ran fast\",stall:\"stalled\"}[info.flow]||\"\"):\"\")):\"\";return{date:today(),grind:rec.grindNumber,grinder:state.grinder,temp:rec.temp,ratio:rec.ratioStr,taste:(taste?TASTE_LABELS[taste]:\"\"),verdict:verdict||\"\",action:action||\"\",retention:ret,ft:(ftSec>30?ftSec:0),freshAt:rec.freshId};}\nfunction findBag(id){for(var i=0;i<LIBRARY.length;i++){if(LIBRARY[i].id===id)return LIBRARY[i];}return null;}\nfunction saveNew(name,verdict){var rec=buildRecipe(state);if(verdict){JOURNEY.push({ts:Date.now(),date:today(),taste:\"great\",flow:flow,grind:rec.grindNumber,temp:rec.temp,ratio:rec.ratioStr,action:\"✓\"});if(JOURNEY.length>30)JOURNEY.shift();}var e={id:Date.now(),name:(name&&name.trim())||defaultName(),state:snapshot(),summary:summaryOf(rec),savedAt:today(),verdict:verdict||\"\",freshMin:rec.freshMin,freshMax:rec.freshMax,history:[brewEntry(rec,verdict)],journey:JOURNEY.slice()};LIBRARY.unshift(e);activeBagId=e.id;if(LIBRARY.length>60)LIBRARY.pop();persist();}\nfunction logBrew(name,verdict){var e=findBag(activeBagId);if(!e){saveNew(name,verdict);return;}var rec=buildRecipe(state);if(verdict){JOURNEY.push({ts:Date.now(),date:today(),taste:\"great\",flow:flow,grind:rec.grindNumber,temp:rec.temp,ratio:rec.ratioStr,action:\"✓\"});if(JOURNEY.length>30)JOURNEY.shift();}e.journey=JOURNEY.slice();if(name&&name.trim())e.name=name.trim();e.state=snapshot();e.freshMin=rec.freshMin;e.freshMax=rec.freshMax;e.summary=summaryOf(rec);e.savedAt=today();if(verdict)e.verdict=verdict;e.history=e.history||[];e.history.unshift(brewEntry(rec,verdict));if(e.history.length>20)e.history.pop();persist();}\nfunction openSaveForm(v){pendingVerdict=v;var nm=defaultName();var e=findBag(activeBagId);if(e)nm=e.name;saveName.value=nm;saveForm.classList.add(\"open\");try{saveName.focus()}catch(err){}}\nfunction clearAfterBrew(){var p=document.getElementById(\"poured\"),c=document.getElementById(\"cupOut\");if(p)p.value=\"\";if(c)c.value=\"\";flow=null;}\nvar toTopBtn=document.getElementById(\"toTop\");window.addEventListener(\"scroll\",function(){var y=window.pageYOffset||document.documentElement.scrollTop||0;if(y>500)toTopBtn.classList.add(\"show\");else toTopBtn.classList.remove(\"show\");},{passive:true});toTopBtn.addEventListener(\"click\",function(){try{window.scrollTo({top:0,behavior:\"smooth\"})}catch(e){window.scrollTo(0,0)}});\nvar buildView=document.getElementById(\"buildView\"),libraryView=document.getElementById(\"libraryView\"),learnView=document.getElementById(\"learnView\");\nvar saveForm=document.getElementById(\"saveForm\"),saveName=document.getElementById(\"saveName\");\nfunction applyStatic(){document.body.className=(lang===\"ar\")?\"ar\":\"\";var _te=document.getElementById(\"tEyebrow\");if(_te)_te.textContent=tr(\"Pour timer\");var _tp2=document.getElementById(\"tPause\");if(_tp2)_tp2.textContent=tr(\"Pause\");var _tr2=document.getElementById(\"tReset\");if(_tr2)_tr2.textContent=tr(\"Reset\");var _ts2=document.getElementById(\"tSkip\");if(_ts2)_ts2.textContent=tr(\"Skip\");var _tc2=document.getElementById(\"tClose\");if(_tc2)_tc2.textContent=tr(\"Close\");var _by=document.getElementById(\"byline\");if(_by){_by.innerHTML=P(\"Created by Abdulmajeed Mohammed Alwahieb\",\"إعداد عبدالمجيد محمد الوهيّب\")+' <span class=\"vertag\">v'+APP_VERSION+'</span>';}var t=document.querySelector(\"#afterBrew .ab-title\");if(t)t.textContent=tr(\"After the brew · weigh your cup (optional)\");var labs=document.querySelectorAll(\"#afterBrew .ab-l\");if(labs[0])labs[0].textContent=tr(\"Water poured (ml)\");if(labs[1])labs[1].textContent=tr(\"Coffee in cup (ml)\");var co=document.getElementById(\"cupOut\");if(co)co.placeholder=tr(\"weigh it\");var sn=document.getElementById(\"saveName\");if(sn)sn.placeholder=tr(\"name this bag\");var sc=document.getElementById(\"saveConfirm\");if(sc)sc.textContent=tr(\"Save\");}\nfunction updateNav(){var n=document.getElementById(\"nav\");var langBtn='<button class=\"navbtn\" data-lang=\"1\">'+(lang===\"ar\"?\"EN\":\"عربي\")+'</button>';var saved=(lang===\"ar\")?(\"★ المحفوظة (\"+LIBRARY.length+\")\"):(\"★ Saved (\"+LIBRARY.length+\")\");var body=(view===\"build\")?('<button class=\"navbtn\" data-nav=\"library\">'+saved+'</button><button class=\"navbtn\" data-nav=\"machine\">'+tr(\"Machine\")+'</button><button class=\"navbtn\" data-nav=\"learn\">'+tr(\"Learn\")+'</button>'):('<button class=\"navbtn\" data-nav=\"build\">'+tr(\"← Build\")+'</button>');n.innerHTML=langBtn+body;}\nfunction updateSaveBar(){var t=document.getElementById(\"saveToggle\"),ah=document.getElementById(\"activeHint\");var e=findBag(activeBagId);if(e){t.textContent=(lang===\"ar\")?(\"＋ سجّل هذا التحضير في \"+e.name):(\"＋ Log this brew to \"+e.name);ah.innerHTML=((lang===\"ar\")?\"تعمل على \":\"Working on \")+'<b>'+escName(e.name)+'</b> · <button id=\"newBag\" class=\"linkbtn\">'+tr(\"start a new bag\")+'</button>';ah.style.display=\"block\";}else{t.textContent=tr(\"★ Save this bag\");ah.style.display=\"none\";}}\nfunction libFresh(en){try{var rd=en.state&&en.state.roastDate;if(!rd||!en.freshMin)return \"\";var days=Math.floor((Date.now()-Date.parse(rd))/86400000);var st,cl;if(days<en.freshMin){st=P(\"resting — too fresh\",\"لسه طازج\");cl=\"#3E8E8E\";}else if(days<=en.freshMax){st=P(\"at its peak ✓\",\"في القمة ✓\");cl=\"#7BB661\";}else if(days<=en.freshMax+21){st=P(\"getting tired\",\"بدأ يتعب\");cl=\"#E89A4B\";}else{st=P(\"past its peak\",\"تعدّى ذروته\");cl=\"#C0563B\";}return '<div class=\"lib-fresh\" style=\"color:'+cl+'\">'+P(\"Day \",\"يوم \")+days+\" · \"+st+'</div>';}catch(e){return \"\";}}\nfunction renderLibrary(){var h='<div class=\"libtitle\">'+tr(\"Your bags\")+'</div>';h+='<div class=\"impwrap\"><input id=\"impCode\" class=\"txt\" placeholder=\"'+tr(\"Paste an import code (CWS1...)\")+'\"><button id=\"impBtn\" class=\"impbtn\">'+tr(\"Import brew\")+'</button></div>';if(!LIBRARY.length){h+='<div class=\"libempty\">'+tr(\"No saved bags yet.<br>Dial one in, then tap “Tasted great ✓” or “Save this bag”.\")+'</div>';}else{h+=LIBRARY.map(function(en,i){var H=(en.history||[]).slice(0,6);var hist=H.map(function(hh,j){var older=H[j+1];var outcome=tr(hh.taste||hh.verdict||\"logged\");var gtxt=String(hh.grind!==undefined?hh.grind:(hh.summary||\"\"));if(older&&older.grind!==undefined&&hh.grind!==undefined&&String(older.grind)!==String(hh.grind)){var _n=parseFloat(hh.grind),_o=parseFloat(older.grind);gtxt=(!isNaN(_n)&&!isNaN(_o))?String(gtxt).replace(String(_n),_o+\"→\"+_n):gtxt;}var line='<span class=\"hist-grind\">'+escName(gtxt)+'</span> → '+escName(outcome);if(hh.action)line+=' <span class=\"hist-act\">'+escName(actLabel(hh.action))+'</span>';if(hh.retention)line+=' · '+escName(hh.retention);if(hh.freshAt==='aging')line+=' · '+P('aging','بدأ يتعب');else if(hh.freshAt==='stale')line+=' · '+P('past peak','تعدّى ذروته');var extras=[];if(hh.grind!==undefined){if(older&&older.temp!==undefined&&hh.temp!==older.temp)extras.push(older.temp+\"→\"+hh.temp+\"°C\");if(older&&older.ratio!==undefined&&hh.ratio!==older.ratio)extras.push(older.ratio+\" → \"+hh.ratio);}if(extras.length)line+=' · <span class=\"hist-chg\">'+escName(extras.join(\" · \"))+'</span>';return '<div class=\"hist\"><span class=\"hist-date\">'+hh.date+'</span> '+line+'</div>';}).join('');return '<div class=\"lib-entry'+(en.id===activeBagId?' active':'')+'\"><div class=\"lib-row\"><div><div class=\"lib-name\">'+escName(en.name)+'</div><div class=\"lib-sum\">'+escName(en.summary||\"\")+(en.savedAt?' · '+en.savedAt:'')+'</div>'+libFresh(en)+'</div>'+(en.verdict?'<div class=\"lib-badge\">'+escName(en.verdict)+'</div>':'')+'</div>'+(hist?'<div class=\"hist-wrap\">'+hist+'</div>':'')+'<div class=\"lib-actions\"><button class=\"lib-load\" data-libload=\"'+i+'\">'+tr(\"Load\")+'</button><button class=\"lib-del\" data-libdel=\"'+i+'\">✕</button></div></div>'}).join('');}libraryView.innerHTML=h;}\nvar FUND=[\n{t:\"1 · Fresh coffee\",d:\"Whole beans roughly 1–4 weeks off roast, ground right before you brew. Stale or pre-ground coffee caps how good the cup can get, no matter your technique.\"},\n{t:\"2 · A scale\",d:\"Weighing your coffee and water is the most important step for a consistent result. 0.1 g resolution is ideal. Handy fact: 1 ml of water weighs 1 g — the millilitres in the recipe are exactly what your scale shows.\"},\n{t:\"3 · An even grind\",d:\"A burr grinder (not a blade) grinds evenly. Grind size is your main dial: finer pulls more (risking bitter), coarser pulls less (risking sour).\"},\n{t:\"4 · Good water, just off boil\",d:\"Water is about 98% of the cup, so filtered or soft water helps a lot. Just off the boil for most roasts; a little cooler for dark.\"},\n{t:\"5 · Even pouring\",d:\"Wet all the grounds, then pour gently and evenly in circles. Sloppy pours channel water and extract unevenly.\"}\n];\nvar CHAIN=[\n{t:\"Origin sets the bean\",d:\"Altitude and variety decide density and character. Roasters pick the roast level to flatter it: bright, dense coffees (Ethiopia, Kenya) usually go lighter to protect florals; softer, nutty ones (Brazil) take medium-dark gracefully. That is why you rarely meet a dark Gesha.\"},\n{t:\"Roast sets the clock\",d:\"Darker roasts are more porous and release their CO2 faster — they peak earlier and fade sooner. Light roasts trap gas in dense structure: they need longer rest and stay good longer. Process nudges the same clock — naturals usually want a few extra days.\"},\n{t:\"The date tells you where you are\",d:\"Day 20 can mean at its peak for a light washed coffee and past it for a dark roast. The number on the bag only means something combined with the roast and process.\"},\n{t:\"What the app does with this\",d:\"Your rest window is computed from roast and process, the freshness stage nudges grind and temperature, and the widget counts the days for you. Enter the roast date once — the chain runs itself.\"}\n];\nvar PROCX=[{t:\"Wet-hulled (Giling Basah)\",d:\"Sumatra’s method: the parchment is stripped while the bean is still wet and soft, then dried bare. It trades acidity for weight — earthy, herbal, syrupy cups. If the bag says Sumatra and tastes like a forest floor in the best way, this is why.\"},{t:\"Decaf\",d:\"Caffeine is removed before roasting (Swiss Water, CO2, or EA methods). The processing leaves beans porous and fast-extracting, so decaf turns bitter easily — the app brews it a degree cooler, and coarser is the first fix if it still bites.\"},{t:\"Co-fermented / Infused\",d:\"Co-fermented: fruit, spices, or specific yeasts are added to the fermentation tank so the flavor develops inside the seed. Infused: flavor is added after processing. Both give loud, unmistakable aromatics — and honest roasters disclose which one you are holding. Brewed slightly cooler so the added notes stay pleasant instead of harsh.\"}];\nvar BREWTIME=[\n{t:\"What it is\",d:\"The total time from the first drop of water to an empty, drained bed. You never control it directly — it is the result of your grind, your dose, and how you pour.\"},\n{t:\"Why it matters\",d:\"Water needs enough contact time to dissolve the sweetness out of the coffee. Brew time is the clearest sign of whether that contact actually happened.\"},\n{t:\"Way too fast\",d:\"Water raced through without extracting enough — expect a weak, sour, thin cup. Usual causes: grind too coarse, or channeling from uneven pouring.\"},\n{t:\"Way too slow\",d:\"Water sat on the coffee too long and kept stripping harsh compounds — expect bitter, dry, muddy. Usual causes: grind too fine, too much agitation, or a clogged filter.\"},\n{t:\"Fix the cause, not the clock\",d:\"You do not fix time directly — adjust the grind and time follows. Finishing near the expected time with an even bed is the real target.\"},\n{t:\"Taste is the judge\",d:\"A rough guide: within about 30 seconds of the recipe finish time is normal. If the time looked off but the cup tastes great — trust the cup. Time is a guide, taste decides.\"}\n];\nvar PROC=[{t:\"Washed\",d:\"The fruit is stripped off the seed, the beans ferment in water tanks to loosen the last sticky layer, then they are washed clean and dried. You taste the bean itself: clean, clear, brighter acidity.\"},{t:\"Honey\",d:\"The skin comes off but some of the sticky fruit layer (the honey) stays on the bean while it dries. Halfway between washed and natural: more sweetness and body than washed, cleaner than natural.\"},{t:\"Natural (dry)\",d:\"The whole cherry is dried in the sun with the fruit still on, then hulled. The bean absorbs fruit sugars for days — fruity, heavy, wine-like sweetness, and a more fragile bed when you brew.\"},{t:\"Anaerobic\",d:\"Cherries ferment in sealed, oxygen-free tanks before drying. The controlled fermentation creates bold, unusual flavours — funky, boozy, intense. A little goes a long way; brew it gently.\"}];\nvar GLOSS=[\n{t:\"Extraction\",d:\"How much flavour you have dissolved out of the grounds. Too little tastes sour; too much tastes bitter; the middle is sweet and balanced.\"},\n{t:\"Extraction yield\",d:\"The percentage of the coffee mass that dissolved (target roughly 18–22%). Only truly known with a refractometer.\"},\n{t:\"Bloom\",d:\"The first small pour that wets the grounds and lets fresh coffee release trapped CO₂ before the main pour.\"},\n{t:\"Ratio\",d:\"Coffee to water, e.g. 1:16.7 means 16.7 g water per 1 g coffee. More water is weaker and cleaner; less is stronger and heavier.\"},\n{t:\"Agitation\",d:\"Stirring, swirling, and pour force. More agitation speeds extraction, but overdone it turns harsh.\"},\n{t:\"Swirl\",d:\"Hold the brewer or server and give it a gentle circular shake — like swirling juice in a glass — to level the bed and even out extraction. No spoon: stirring is a different, stronger move.\"},{t:\"Channelling\",d:\"Water finding a fast path through cracks in the bed, so some grounds over-extract while others barely brew. Even pours prevent it.\"},\n{t:\"Draw-down\",d:\"How long the water takes to drain after your last pour. Fast usually means too coarse; slow or stalled means too fine.\"},\n{t:\"Degassing\",d:\"Fresh-roasted coffee releasing CO₂ for days after roast. Lots of gas makes a big bloom and can read sour.\"},\n{t:\"TDS / strength\",d:\"Total dissolved solids — how concentrated the brew is. Measured with a refractometer; the Strength setting is the everyday lever.\"},\n{t:\"Flash / Japanese iced\",d:\"Brewing hot straight onto ice to chill instantly and keep the aromatics. Different from cold brew.\"},\n{t:\"Cold brew\",d:\"Steeping grounds in cold water for many hours. Low acidity and smooth, but it loses the lively, aromatic notes.\"}\n];\nvar KIT=[\n{t:\"Essential\",d:\"A scale (0.1 g), a burr grinder, and fresh coffee. These three decide most of your cup.\"},\n{t:\"Helps a lot\",d:\"A gooseneck kettle for pour control, plus a dripper and filters you like (V60, Kalita Wave, Chemex...).\"},\n{t:\"Nice, not needed\",d:\"A temperature-control kettle, a timer (your phone is fine), and a refractometer (only if you want to measure — you can brew great coffee without one).\"},\n{t:\"Honest advice\",d:\"An expensive dripper will not fix a bad grinder. If you are going to spend, spend on the grinder first.\"}\n];\nfunction learnSection(title,items){return '<div class=\"learn-sec\"><div class=\"learn-h\">'+tr(title)+'</div>'+items.map(function(it,ix){return '<div class=\"learn-item'+(ix===0?' pull':'')+'\"><div class=\"learn-t\">'+tr(it.t)+'</div><div class=\"learn-d\">'+tr(it.d)+'</div></div>'}).join('')+'</div>';}\nfunction grindMethodsData(){return [{n:P(\"Espresso\",\"إسبريسو\"),um:350},{n:P(\"Moka pot\",\"موكا\"),um:450},{n:P(\"AeroPress\",\"إيروبريس\"),um:550},{n:P(\"V60 / Pour-over\",\"V60 / تقطير\"),um:750},{n:P(\"Chemex\",\"كيمكس\"),um:950},{n:P(\"French press\",\"فرنش برس\"),um:1200},{n:P(\"Cold brew\",\"كولد برو\"),um:1500}];}\nfunction grindStripHtml(){var ms=grindMethodsData();var cells=\"\";ms.slice().reverse().forEach(function(m){var mm=m.um/1000;var d=2.2+(m.um/1500)*5.5;var W=46,H=96;var n=Math.min(110,Math.max(20,Math.round(W*H/(d*d*7))));var dots=\"\";var seed=m.um;for(var i=0;i<n;i++){seed=(seed*9301+49297)%233280;var r1=seed/233280;seed=(seed*9301+49297)%233280;var r2=seed/233280;seed=(seed*9301+49297)%233280;var r3=seed/233280;var s2=d*(0.75+r3*0.6);var x=r1*90+2,y=r2*90+2;dots+='<span class=\"gsd\" style=\"width:'+s2.toFixed(1)+'px;height:'+s2.toFixed(1)+'px;left:'+x+'%;top:'+y+'%\"></span>';}cells+='<div class=\"gstrip-col\"><div class=\"gstrip-patch\">'+dots+'</div><div class=\"gstrip-l\">'+m.n+'</div><div class=\"gstrip-u\">'+m.um+'µ</div></div>';});return '<div class=\"gref\"><div class=\"gref-head\">'+P(\"GRIND REFERENCE\",\"مرجع الطحن\")+' · '+P(\"WHAT YOURS SHOULD LOOK LIKE\",\"كيف يجب أن تبدو\")+'</div><div class=\"gstrip\">'+cells+'</div><div class=\"gstrip-ends\"><span>◄ '+P(\"COARSE\",\"خشن\")+'</span><span>'+P(\"FINE\",\"ناعم\")+' ►</span></div></div>';}\nfunction renderLearn(){learnView.innerHTML='<div class=\"libtitle\">'+tr(\"Learn\")+'</div><div class=\"libsub\">'+tr(\"The basics that matter.\")+'</div>'+learnSection(\"The five that matter most\",FUND)+learnSection(\"Origin, roast, and the date — one chain\",CHAIN)+learnSection(\"Why brew time matters\",BREWTIME)+learnSection(\"How each process is made\",PROC.concat(PROCX))+learnSection(\"Glossary\",GLOSS)+learnSection(\"What you actually need\",KIT)+grindStripHtml();}\nfunction renderAll(){if(state.roastDate)state.days=daysFromIso(state.roastDate);var mv=document.getElementById(\"machineView\");mv.style.display=\"none\";if(view===\"build\"){buildView.style.display=\"\";libraryView.style.display=\"none\";learnView.style.display=\"none\";renderInputs();renderCard();renderAfterBrew();updateSaveBar()}else if(view===\"machine\"){buildView.style.display=\"none\";libraryView.style.display=\"none\";learnView.style.display=\"none\";mv.style.display=\"\";renderMachine()}else if(view===\"library\"){buildView.style.display=\"none\";libraryView.style.display=\"\";learnView.style.display=\"none\";renderLibrary()}else{buildView.style.display=\"none\";libraryView.style.display=\"none\";learnView.style.display=\"\";renderLearn()}updateNav();applyStatic();persist()}\n\ndocument.getElementById(\"nav\").addEventListener(\"click\",function(e){var lb=e.target.closest(\"[data-lang]\");if(lb){lang=(lang===\"ar\")?\"en\":\"ar\";renderAll();return;}var b=e.target.closest(\"[data-nav]\");if(!b)return;view=b.dataset.nav;taste=null;renderAll();});\ndocument.getElementById(\"saveToggle\").addEventListener(\"click\",function(){openSaveForm(\"\")});\ndocument.getElementById(\"saveConfirm\").addEventListener(\"click\",function(){if(activeBagId&&findBag(activeBagId))logBrew(saveName.value,pendingVerdict);else saveNew(saveName.value,pendingVerdict);saveForm.classList.remove(\"open\");saveName.value=\"\";renderAll()});\ndocument.getElementById(\"saveCancel\").addEventListener(\"click\",function(){saveForm.classList.remove(\"open\")});\ndocument.getElementById(\"saveBar\").addEventListener(\"click\",function(e){if(e.target&&e.target.id===\"newBag\"){activeBagId=null;JOURNEY=[];persist();clearAfterBrew();renderAll();}});\ndocument.getElementById(\"poured\").addEventListener(\"input\",function(){renderAfterBrew();renderCard()});\ndocument.getElementById(\"cupOut\").addEventListener(\"input\",function(){renderAfterBrew();renderCard()});\ndocument.getElementById(\"afterBrew\").addEventListener(\"input\",function(e){if(e.target&&e.target.id===\"finTime\"){var v=e.target.value.replace(/[^0-9]/g,\"\");if(v.length>=3&&v.length<=4){var ss=v.slice(-2);if(+ss<60)e.target.value=v.slice(0,-2)+\":\"+ss;}}});\ndocument.getElementById(\"afterBrew\").addEventListener(\"change\",function(e){if(e.target&&e.target.id===\"finTime\"){renderAfterBrew();}});\n\ndocument.getElementById(\"machineView\").addEventListener(\"click\",function(e){if(e.target.closest(\"[data-machcard]\")){shareMachineCard();return;}var sb=e.target.closest(\".seg-btn\");if(sb&&(sb.dataset.key===\"machine\"||sb.dataset.key===\"tempProfile\")){state[sb.dataset.key]=sb.dataset.id;persist();renderMachine();}});\ndocument.getElementById(\"retResult\").addEventListener(\"click\",function(e){if(e.target.closest(\"[data-flowhelp]\")){flowHelpOpen=!flowHelpOpen;renderAfterBrew();return;}var fap=e.target.closest(\"[data-finapply]\");if(fap){var dir=fap.dataset.finapply;var rec=buildRecipe(state);JOURNEY.push({ts:Date.now(),date:today(),taste:\"finish\",action:(dir===\"fast\"?\"→ finer\":\"→ coarser\"),grind:rec.grindNumber,temp:rec.temp});var bgf=activeBagId?findBag(activeBagId):null;if(bgf){if(!bgf.journey)bgf.journey=[];bgf.journey.push(JOURNEY[JOURNEY.length-1]);}persist();renderCard();renderAfterBrew();return;}});\ncard.addEventListener(\"click\",function(e){if(e.target.closest(\"[data-why]\")){whyOpen=!whyOpen;renderCard();return}if(e.target.closest(\"[data-tastehelp]\")){tasteHelpOpen=!tasteHelpOpen;renderCard();return}if(e.target.closest(\"[data-setupgrinder]\")){openGsetup();return}if(e.target.closest(\"[data-gcalopen]\")){gcalOpen=true;renderCard();var gi=document.getElementById(\"gcalInput\");if(gi)gi.focus();return}if(e.target.closest(\"[data-gcalreset]\")){var g0=grinderById(state.grinder);if(g0){delete GRINDOFF[g0.id];persist();}gcalOpen=false;renderCard();return}if(e.target.closest(\"[data-gcalsave]\")){var g1=grinderById(state.grinder);var gi2=document.getElementById(\"gcalInput\");if(g1&&gi2){var rawTyped=parseFloat(gi2.value);if(!isNaN(rawTyped)){var typed=rawTyped;if(g1.micro){var wholeT=Math.floor(rawTyped);var clk=Math.round((rawTyped-wholeT)*10);if(clk>=g1.micro){wholeT+=1;clk=0;}typed=wholeT+clk/g1.micro;}var savedOff=GRINDOFF[g1.id];delete GRINDOFF[g1.id];var freshBook=buildRecipe(Object.assign({},state)).grindNumeric;if(savedOff!==undefined)GRINDOFF[g1.id]=savedOff;var newOff=Math.round((typed-freshBook)*1000)/1000;GRINDOFF[g1.id]=newOff;persist();}}gcalOpen=false;renderCard();return}if(e.target.closest(\"[data-sharecard]\")){shareCard();return}if(e.target.closest(\"[data-share]\")){doShare();return}var fap=e.target.closest(\"[data-finapply]\");if(fap){var dir=fap.dataset.finapply;var rec=buildRecipe(state);JOURNEY.push({ts:Date.now(),date:today(),taste:\"finish\",action:(dir===\"fast\"?\"→ finer\":\"→ coarser\"),grind:rec.grindNumber,temp:rec.temp});var bgf=activeBagId?findBag(activeBagId):null;if(bgf){if(!bgf.journey)bgf.journey=[];bgf.journey.push(JOURNEY[JOURNEY.length-1]);}persist();renderCard();return}if(e.target.closest(\"[data-jundo]\")){if(JOURNEY.length){JOURNEY.pop();var bgu=activeBagId?findBag(activeBagId):null;if(bgu&&bgu.journey&&bgu.journey.length)bgu.journey.pop();if(bgu&&bgu.history&&bgu.history.length)bgu.history.shift();persist();renderCard();}return}if(e.target.closest(\"[data-jreset]\")){JOURNEY=[];var bg=activeBagId?findBag(activeBagId):null;if(bg)bg.journey=[];persist();renderCard();return}if(e.target.closest(\"[data-flowhelp]\")){flowHelpOpen=!flowHelpOpen;renderAfterBrew();return}if(e.target.closest(\"[data-timer]\")){startTimer();return}if(e.target.closest(\"[data-apply]\")){var rec=buildRecipe(state);var ap=coachApply(taste,state,rec);if(ap&&ap.act){var bag=activeBagId?findBag(activeBagId):null;if(bag){bag.history=bag.history||[];bag.history.unshift(brewEntry(rec,\"\",ap.action));if(bag.history.length>20)bag.history.pop();}JOURNEY.push({ts:Date.now(),date:today(),taste:taste,flow:flow,grind:rec.grindNumber,temp:rec.temp,ratio:rec.ratioStr,action:ap.action});if(JOURNEY.length>30)JOURNEY.shift();if(bag)bag.journey=JOURNEY.slice();persist();ap.act();streak=(streak.sym===taste)?{sym:taste,n:streak.n+1}:{sym:taste,n:1};lastAction=ap.action;taste=null;renderAll();}return;}var tb=e.target.closest(\"[data-taste]\");if(tb){var v=tb.dataset.taste;if(v===\"great\"){openSaveForm(\"Dialed in ✓\");return}if(v!==taste)streak={sym:null,n:0};taste=(taste===v)?null:v;renderCard();return}});\nlibraryView.addEventListener(\"click\",function(e){if(e.target&&e.target.id===\"impBtn\"){var fld=document.getElementById(\"impCode\");var raw=((fld&&fld.value)||\"\");var pos=raw.indexOf(\"CWS1.\");if(pos<0){showToast(P(\"No valid code found\",\"لم يُعثر على رمز صالح\"));return;}var b64=raw.slice(pos+5).split(/[^A-Za-z0-9+/=]/)[0];try{var imp=JSON.parse(decodeURIComponent(escape(atob(b64))));if(!imp||!imp.brewer||!imp.roast)throw 0;if(STATE_DEFAULTS)Object.assign(state,STATE_DEFAULTS);Object.assign(state,imp);if(state.roastDate)state.days=daysFromIso(state.roastDate);activeBagId=null;JOURNEY=[];persist();view=\"build\";renderAll();showToast(P(\"Brew imported — review, then save it\",\"تم الاستيراد — راجع الوصفة ثم احفظها\"));}catch(err){showToast(P(\"Could not read that code\",\"تعذّرت قراءة الرمز\"));}return;}var ld=e.target.closest(\"[data-libload]\");if(ld){var en=LIBRARY[+ld.dataset.libload];if(en){try{Object.assign(state,JSON.parse(JSON.stringify(en.state)))}catch(e2){}if(!state.roastDate)state.roastDate=isoFromDays(state.days||14);activeBagId=en.id;JOURNEY=(en.journey||[]).slice();persist();}taste=null;streak={sym:null,n:0};lastAction=\"\";clearAfterBrew();view=\"build\";renderAll();return}var dd=e.target.closest(\"[data-libdel]\");if(dd){var di=+dd.dataset.libdel;if(LIBRARY[di]&&LIBRARY[di].id===activeBagId)activeBagId=null;LIBRARY.splice(di,1);persist();renderLibrary();updateNav();return}});\ndocument.getElementById(\"gsetupOverlay\").addEventListener(\"click\",function(e){if(!gsetup)return;if(e.target.closest(\"[data-gsclose]\")){closeGsetup();return}if(e.target.closest(\"[data-gsbasics]\")){var nm=document.getElementById(\"gsName\"),un=document.getElementById(\"gsUnit\"),mi=document.getElementById(\"gsMin\"),ma=document.getElementById(\"gsMax\");gsetup.name=(nm&&nm.value.trim())||\"\";if(!gsetup.name){alert(P(\"Give your grinder a name first.\",\"اكتب اسم المطحنة أولاً.\"));return;}gsetup.unit=un?un.value:\"clicks\";gsetup.min=mi?mi.value.trim():\"\";gsetup.max=ma?ma.value.trim():\"\";var vmn=parseFloat(gsetup.min),vmx=parseFloat(gsetup.max);if(isNaN(vmn)||isNaN(vmx)||!(vmx>vmn)){alert(P(\"Enter the lowest and highest numbers on your grinder (highest must be bigger).\",\"أدخل أقل وأعلى رقم على مطحنتك (الأعلى لازم أكبر).\"));return;}gsetup.step=\"depth\";renderGsetup();return}var gb=e.target.closest(\"[data-gsback]\");if(gb){gsetup.step=gb.dataset.gsback;renderGsetup();return}var gd=e.target.closest(\"[data-gsdepth]\");if(gd){gsetup.depth=gd.dataset.gsdepth;gsetup.step=\"test\";renderGsetup();return}var gst=e.target.closest(\"[data-gstaste]\");if(gst){var setsX=document.querySelectorAll(\"[data-gsset]\");for(var sx=0;sx<setsX.length;sx++){var rawx=parseFloat(setsX[sx].value);gsetup[setsX[sx].dataset.gsset]=isNaN(rawx)?\"\":String(gsClamp(rawx));}var parts=gst.dataset.gstaste.split(\"|\");gsetup[parts[0]]=parts[1];renderGsetup();return}if(e.target.closest(\"[data-gsfinish]\")){var sets=document.querySelectorAll(\"[data-gsset]\");for(var si=0;si<sets.length;si++){var rawv=parseFloat(sets[si].value);gsetup[sets[si].dataset.gsset]=isNaN(rawv)?\"\":String(gsClamp(rawv));}var miss=false;if(gsetup.depth===\"thorough\"){if(!gsetup.coarseTaste||!gsetup.fineTaste||isNaN(parseFloat(gsetup.coarseSet))||isNaN(parseFloat(gsetup.fineSet)))miss=true;}else{if(!gsetup.oneTaste||isNaN(parseFloat(gsetup.oneSet)))miss=true;}if(miss){alert(P(\"Enter the number you dialed and tap how each cup tasted first.\",\"أدخل الرقم اللي ضبطت عليه واضغط كيف طعم كل كوب أولاً.\"));return;}gsetupFinish();return}var grt=e.target.closest(\"[data-gsretry]\");if(grt){var pr=grt.dataset.gsretry.split(\"|\");gsetup.coarseSet=pr[0];gsetup.fineSet=pr[1];gsetup.coarseTaste=\"\";gsetup.fineTaste=\"\";gsetup.step=\"test\";renderGsetup();return}if(e.target.closest(\"[data-gsclear]\")){gsetup.coarseTaste=\"\";gsetup.fineTaste=\"\";gsetup.oneTaste=\"\";gsetup.step=\"test\";renderGsetup();return}if(e.target.closest(\"[data-gssave]\")){gsetupSave();return}});\ninputs.addEventListener(\"click\",(e)=>{if(e.target.closest(\"[data-setupgrinder]\")){openGsetup();return}var fgb=e.target.closest(\"[data-favgrinder]\");if(fgb){var fid=fgb.dataset.favgrinder;var ix=FAVG.indexOf(fid);if(ix>=0)FAVG.splice(ix,1);else FAVG.push(fid);persist();renderInputs();return}var dgb=e.target.closest(\"[data-delgrinder]\");if(dgb){var did=dgb.dataset.delgrinder;if(delConfirm===did){MYGRINDERS=MYGRINDERS.filter(function(x){return x.id!==did;});if(GRINDOFF[did])delete GRINDOFF[did];var fx=FAVG.indexOf(did);if(fx>=0)FAVG.splice(fx,1);delConfirm=null;state.grinder=\"comandante\";persist();renderAll();}else{delConfirm=did;renderInputs();}return}const b=e.target.closest(\"[data-id]\");if(b){state[b.dataset.key]=b.dataset.id;delConfirm=null;renderAll();return}const s=e.target.closest(\"[data-d]\");if(s){const k=s.dataset.key,l=LIM[k];let nv=clamp(state[k]+(+s.dataset.d),l.min,l.max);if(l.dec)nv=Math.round(nv*10)/10;state[k]=nv;if(k===\"days\")state.roastDate=isoFromDays(nv);renderAll();return}});\ninputs.addEventListener(\"change\",(e)=>{const d=e.target.closest(\".dateinp\");if(d){state.roastDate=d.value;state.days=daysFromIso(d.value);renderAll();return}const s=e.target.closest(\"select[data-key]\");if(s){state[s.dataset.key]=s.value;renderAll()}});\ninputs.addEventListener(\"input\",(e)=>{const tx=e.target.closest(\"input.txt\");if(tx){state.bagNotes=tx.value;renderCard();return}const n=e.target.closest(\"input.num\");if(n){const k=n.dataset.key,l=LIM[k];if(l.dec){var raw=n.value.replace(/[^0-9.]/g,\"\");var parts=raw.split(\".\");var clean=parts.length>1?parts[0]+\".\"+parts.slice(1).join(\"\").slice(0,1):parts[0];var v=parseFloat(clean);if(!isNaN(v)){state[k]=v;renderCard()}}else{var iv=parseInt(n.value.replace(/[^0-9]/g,\"\"),10);if(!isNaN(iv)){state[k]=iv;if(k===\"days\")state.roastDate=isoFromDays(iv);renderCard()}}}});\ninputs.addEventListener(\"focusout\",(e)=>{const n=e.target.closest(\"input.num\");if(n){const k=n.dataset.key,l=LIM[k];let v=clamp(state[k],l.min,l.max);if(l.dec)v=Math.round(v*10)/10;state[k]=v;if(k===\"days\")state.roastDate=isoFromDays(v);renderAll()}});\nvar actx=null;\nfunction initAudio(){if(actx)return;try{actx=new (window.AudioContext||window.webkitAudioContext)()}catch(e){actx=null}}\nfunction beep(freq,dur,vol){if(!actx)return;try{var o=actx.createOscillator(),g=actx.createGain();o.type=\"sine\";o.frequency.value=freq;o.connect(g);g.connect(actx.destination);var t=actx.currentTime;g.gain.setValueAtTime(vol||0.2,t);g.gain.exponentialRampToValueAtTime(0.0001,t+(dur||0.15));o.start(t);o.stop(t+(dur||0.15))}catch(e){}}\nvar tRec=null,tElapsed=0,tStart=0,tPausedAccum=0,tPauseStart=0,tRunning=false,tInterval=null,tLastIdx=-1,tLastTick=-1,tDone=false;\nfunction renderTimerSteps(){document.getElementById(\"tSteps\").innerHTML=tRec.pours.map(function(p,i){return '<div class=\"tstep\" id=\"tstep'+i+'\"><span class=\"tstep-t\">'+fmt(p.t)+'</span><span class=\"tstep-l\">'+plab(p.label)+'</span><span class=\"tstep-c\">'+(lang===\"ar\"?(\"حتى \"+p.cum+\"مل\"):(p.pour>0?\"→ \"+p.cum+\"ml\":p.cum+\"ml\"))+'</span></div>'}).join('');}\nfunction startTimer(){tRec=buildRecipe(state);initAudio();tStart=Date.now();tPausedAccum=0;tPauseStart=0;tRunning=true;tLastIdx=-1;tLastTick=-1;tDone=false;renderTimerSteps();document.getElementById(\"tPause\").textContent=tr(\"Pause\");document.getElementById(\"timerOverlay\").classList.add(\"show\");if(tInterval)clearInterval(tInterval);tInterval=setInterval(tick,100);tick();}\nfunction tick(){if(!tRunning)return;var E=(Date.now()-tStart-tPausedAccum)/1000;tElapsed=E;var ps=tRec.pours,idx=0;for(var i=0;i<ps.length;i++){if(ps[i].t<=E)idx=i;}var nextI=(idx<ps.length-1)?idx+1:-1;var cur=ps[idx];\ndocument.getElementById(\"tTime\").textContent=fmt(Math.floor(E));\ndocument.getElementById(\"tTarget\").textContent=(cur.pour>0?P(\"pour to \"+cur.cum+\"ml\",\"اسكب حتى \"+cur.cum+\"مل\"):plab(cur.label)+\" · \"+cur.cum+P(\"ml\",\"مل\"));\ndocument.getElementById(\"tNote\").textContent=tr(cur.note||\"\");\nvar ring=document.getElementById(\"tRing\");var ringEl=document.querySelector(\".tov-ring\");var stEl=document.getElementById(\"tState\");var _cl=document.getElementById(\"tClose\");if(_cl){_cl.textContent=(tElapsed>=60)?P(\"Done\",\"تم\"):P(\"Close\",\"إغلاق\");}\nvar segStart=cur.t,segEnd=(nextI>=0?ps[nextI].t:tRec.finishHi);var segLen=Math.max(1,segEnd-segStart);var segProg=Math.min(1,Math.max(0,(E-segStart)/segLen));\nif(ring){ring.style.strokeDashoffset=(678.6*(1-segProg));}\nvar pourWindow=(cur.pour>0&&(E-segStart)<10);\nif(stEl&&ringEl){if(tDone){stEl.textContent=P(\"DRAWING\",\"تصفية\");stEl.className=\"tov-state done\";ringEl.className=\"tov-ring\";var _tg=document.getElementById(\"tTarget\");if(_tg)_tg.textContent=P(\"tap Done when ready\",\"اضغط تم عند الانتهاء\");}\nelse if(pourWindow){stEl.textContent=P(\"POUR\",\"اسكب\");stEl.className=\"tov-state pour\";ringEl.className=\"tov-ring pour\";}\nelse{stEl.textContent=P(\"WAIT\",\"انتظر\");stEl.className=\"tov-state wait\";ringEl.className=\"tov-ring\";}}\nvar nx=document.getElementById(\"tNext\");\nif(nextI>=0){var secs=Math.max(0,Math.ceil(ps[nextI].t-E));var when=(secs<=0)?P(\"now\",\"الآن\"):(secs+P(\"s\",\"ث\"));nx.innerHTML=P(\"Coming up\",\"التالي\")+':  <b>'+plab(ps[nextI].label)+'</b> · '+ps[nextI].cum+P(\"ml\",\"مل\")+'  <span class=\"tnext-in\">'+P(\"in \",\"بعد \")+when+'</span>';}\nelse if(E<tRec.finishHi){nx.textContent=P(\"Let it drain — expected \",\"اتركه يتصرّف — متوقع \")+tRec.finishRange;}\nelse{nx.textContent=P(\"Done — enjoy.\",\"انتهى — بالهناء والعافية.\");}\nfor(var j=0;j<ps.length;j++){var se=document.getElementById(\"tstep\"+j);if(se)se.className=\"tstep\"+(j===idx?\" active\":(j<idx?\" done\":\"\"));}\nif(idx!==tLastIdx){if(tLastIdx>=0)beep(880,0.18,0.28);tLastIdx=idx;}\nif(nextI>=0){var rem=Math.ceil(ps[nextI].t-E);if(rem<=3&&rem>=1&&rem!==tLastTick){beep(1320,0.05,0.14);tLastTick=rem;}}\nif(!tDone&&E>=tRec.finishSec){tDone=true;beep(587,0.5,0.32);}\n}\ndocument.getElementById(\"tPause\").addEventListener(\"click\",function(){if(tRunning){tRunning=false;tPauseStart=Date.now();this.textContent=tr(\"Resume\");}else{tPausedAccum+=Date.now()-tPauseStart;tPauseStart=0;tRunning=true;this.textContent=tr(\"Pause\");}});\ndocument.getElementById(\"tSkip\").addEventListener(\"click\",function(){if(!tRec)return;var now=Date.now();if(tPauseStart){tPausedAccum+=now-tPauseStart;tPauseStart=now;}var E=(now-tStart-tPausedAccum)/1000;var ps=tRec.pours,target=-1;for(var i=0;i<ps.length;i++){if(ps[i].t>E+0.2){target=ps[i].t;break;}}if(target<0)target=tRec.finishSec;tStart=now-tPausedAccum-Math.round(target*1000);tLastTick=-1;if(tRunning){tick();}else{tRunning=true;tick();tRunning=false;}});\ndocument.getElementById(\"tReset\").addEventListener(\"click\",function(){tStart=Date.now();tPausedAccum=0;tPauseStart=0;tRunning=true;tLastIdx=-1;tLastTick=-1;tDone=false;document.getElementById(\"tPause\").textContent=tr(\"Pause\");tick();});\ndocument.getElementById(\"tClose\").addEventListener(\"click\",function(){if(tElapsed>=60){recordTimerFinish();}tRunning=false;if(window.PENDING_VER)showUpdateBanner(window.PENDING_VER);if(tInterval){clearInterval(tInterval);tInterval=null;}document.getElementById(\"timerOverlay\").classList.remove(\"show\");});\nfunction cmpVer(a,b){var pa=String(a).split(\".\").map(Number),pb=String(b).split(\".\").map(Number);for(var i=0;i<3;i++){var x=pa[i]||0,y=pb[i]||0;if(x>y)return 1;if(x<y)return -1;}return 0;}\nfunction showUpdateBanner(newV){\n  var el=document.getElementById(\"updateBanner\");if(!el)return;\n  if(isWebContext()){\n    el.innerHTML=P(\"A new version (\"+newV+\") is available. \",\"فيه إصدار جديد (\"+newV+\") متوفر. \")+'<button class=\"updbtn\" data-doupdate=\"1\">'+P(\"Reload\",\"تحديث\")+'</button> <button class=\"updx\" data-updignore=\"1\">✕</button>';\n  }else{\n    el.innerHTML=P(\"A new version (\"+newV+\") is available. \",\"فيه إصدار جديد (\"+newV+\") متوفر. \")+'<button class=\"updbtn\" data-getupdate=\"1\">'+P(\"Get it\",\"حمّله\")+'</button> <button class=\"updx\" data-updignore=\"1\">✕</button>';\n  }\n  el.style.display=\"\";\n}\nfunction isWebContext(){try{return (location.protocol===\"http:\"||location.protocol===\"https:\");}catch(e){return false;}}\nfunction checkForUpdate(){\n  if(!VERSION_URL)return;\n  try{\n    fetch(VERSION_URL+\"?t=\"+Date.now(),{cache:\"no-store\"}).then(function(r){return r.json();}).then(function(d){\n      if(d&&d.version&&cmpVer(d.version,APP_VERSION)>0){window.PENDING_VER=d.version;if(!tRunning)showUpdateBanner(d.version);}\n    }).catch(function(){});\n  }catch(e){}\n}\n(function(){var ub=document.getElementById(\"updateBanner\");if(ub){ub.addEventListener(\"click\",function(e){\n  if(e.target.closest(\"[data-getupdate]\")){var ubg=document.getElementById(\"updateBanner\");if(ubg){ubg.innerHTML=P(\"<b>How to update:</b><br>1. Tap <b>Open the page</b> below.<br>2. On that page, tap the <b>↓ download</b> icon (or Raw) to save the file.<br>3. Open the file and choose <b>Scriptable</b> — it replaces this app with the new version.<br>\",\"<b>طريقة التحديث:</b><br>1. اضغط <b>افتح الصفحة</b> بالأسفل.<br>2. في الصفحة، اضغط أيقونة <b>التنزيل ↓</b> (أو Raw) لحفظ الملف.<br>3. افتح الملف واختر <b>Scriptable</b> — بيستبدل هذا التطبيق بالنسخة الجديدة.<br>\")+'<button class=\"updbtn\" data-openrepo=\"1\">'+P(\"Open the page\",\"افتح الصفحة\")+'</button> <button class=\"updx\" data-updignore=\"1\">✕</button>';}return;}if(e.target.closest(\"[data-openrepo]\")){try{window.OPEN_URL=REPO_URL;}catch(_){}try{if(isWebContext()){window.open(REPO_URL,\"_blank\");}}catch(_){}var ubo=document.getElementById(\"updateBanner\");if(ubo)ubo.style.display=\"none\";return;}if(e.target.closest(\"[data-doupdate]\")){\n    try{if(\"caches\" in window){caches.keys().then(function(ks){ks.forEach(function(k){caches.delete(k);});});}}catch(_){}\n    if(!isWebContext()){var ub2=document.getElementById(\"updateBanner\");if(ub2)ub2.style.display=\"none\";return;}var u=location.href.split(\"#\")[0];u+=(u.indexOf(\"?\")>=0?\"&\":\"?\")+\"v=\"+Date.now();location.replace(u);\n  }\n  if(e.target.closest(\"[data-updignore]\")){ub.style.display=\"none\";window.PENDING_VER=null;}\n});}})();\nrenderAll();\ncheckForUpdate();\n</script></body></html>\n`;\n\nlet store;\ntry { store = FileManager.iCloud(); store.documentsDirectory(); } catch (e) { store = FileManager.local(); }\nconst path = store.joinPath(store.documentsDirectory(), \"brew-standard.json\");\nlet saved = \"null\";\nfunction bootWait(ms) { return new Promise(function (r) { Timer.schedule(ms, false, r); }); }\ntry {\n  if (store.fileExists(path)) {\n    try {\n      if (!store.isFileDownloaded(path)) {\n        // Race iCloud download against 3s so a slow sync never blocks launch\n        await Promise.race([store.downloadFileFromiCloud(path), bootWait(3000)]);\n      }\n    } catch (e) {}\n    saved = store.readString(path) || \"null\";\n  }\n} catch (e) {}\n// Never inject anything that is not valid JSON (a crash mid-write can truncate the file)\ntry { JSON.parse(saved); } catch (e) { saved = \"null\"; }\n// Neutralize any \"<\" inside the JSON (can only occur in strings) so it can never break the script tag\nsaved = saved.replace(/</g, \"\\\\u003c\");\n\nif (config.runsInWidget) {\n  let sysAr = false;\n  try { sysAr = (Device.language() + \"\").toLowerCase().slice(0, 2) === \"ar\"; } catch (e) {}\n  function loc(t) {\n    t = String(t || \"\");\n    if (sysAr) { return t.replace(/°C/g, \"°م\").replace(/(\\d)\\s?g\\b/g, \"$1غ\").replace(/\\bml\\b/g, \"مل\").replace(/clicks?/g, \"نقرة\"); }\n    return t.replace(/°م/g, \"°C\").replace(/(\\d)غ/g, \"$1g\").replace(/مل/g, \"ml\").replace(/نقرة/g, \"clicks\");\n  }\n  const wg = new ListWidget();\n  wg.backgroundColor = new Color(\"#17120E\");\n  const hd = wg.addText(\"☕ Coffee Way Standard\");\n  hd.textColor = new Color(\"#E89A4B\"); hd.font = Font.boldSystemFont(13);\n  try {\n    const d = JSON.parse(saved);\n    const b = d && d.library && d.library[0];\n    if (b) {\n      wg.addSpacer(6);\n      const nm = wg.addText(b.name || \"\");\n      nm.textColor = new Color(\"#F4EEE3\"); nm.font = Font.boldSystemFont(17); nm.lineLimit = 1;\n      try {\n        const rd = b.state && b.state.roastDate;\n        if (rd && b.freshMin) {\n          const days = Math.floor((Date.now() - Date.parse(rd)) / 86400000);\n          let stage, col;\n          if (days < b.freshMin) { stage = sysAr ? \"لسه طازج — دعه يرتاح\" : \"resting — too fresh\"; col = \"#3E8E8E\"; }\n          else if (days <= b.freshMax) { stage = sysAr ? \"في القمة ✓\" : \"at its peak ✓\"; col = \"#7BB661\"; }\n          else if (days <= b.freshMax + 21) { stage = sysAr ? \"بدأ يتعب\" : \"getting tired\"; col = \"#E89A4B\"; }\n          else { stage = sysAr ? \"تعدّى ذروته\" : \"past its peak\"; col = \"#C0563B\"; }\n          wg.addSpacer(3);\n          const fr = wg.addText((sysAr ? \"يوم \" : \"Day \") + days + \" · \" + stage);\n          fr.textColor = new Color(col); fr.font = Font.mediumSystemFont(12); fr.lineLimit = 1;\n        }\n      } catch (ef) {}\n      if (b.summary) { wg.addSpacer(3); const sm = wg.addText(loc(b.summary)); sm.textColor = new Color(\"#A28F78\"); sm.font = Font.mediumSystemFont(11); sm.lineLimit = 2; }\n    } else {\n      wg.addSpacer(6);\n      const e2 = wg.addText(sysAr ? \"افتح التطبيق واضبط أول كيس\" : \"Open the app to dial in your first bag\");\n      e2.textColor = new Color(\"#A28F78\"); e2.font = Font.mediumSystemFont(12);\n    }\n  } catch (e) {}\n  wg.addSpacer(8);\n  const tp = wg.addText(sysAr ? \"اضغط للفتح\" : \"Tap to open\");\n  tp.textColor = new Color(\"#7A6A57\"); tp.font = Font.mediumSystemFont(10);\n  Script.setWidget(wg);\n  Script.complete();\n} else {\n  const page = html.split(\"/*__SAVED__*/\").join(\";window.SAVED=\" + saved + \";\");\n  const wv = new WebView();\n  await wv.loadHTML(page);\n  let dismissed = false;\n  wv.present(true).then(function () { dismissed = true; });\n  function wait(ms) { return new Promise(function (r) { Timer.schedule(ms, false, r); }); }\n  let lastWritten = saved;\n  // Autosave loop: write to disk whenever the page data changes, every ~1.5s while open\n  let failCount = 0, everAlive = false, reloads = 0;\n  await wait(1200); // let the sheet finish presenting before touching the page\n  while (!dismissed) {\n    try {\n      const out = await wv.evaluateJavaScript(\"window.SAVE_DATA || 'null'\");\n      everAlive = true; failCount = 0;\n      if (out && out !== \"null\" && out !== lastWritten) { store.writeString(path, out); lastWritten = out; }\n      try {\n        const openReq = await wv.evaluateJavaScript(\"(function(){var u=window.OPEN_URL||'';window.OPEN_URL=null;return u;})()\");\n        if (openReq && /^https?:\\/\\//.test(openReq)) { Safari.open(openReq); }\n      } catch (e) {}\n    } catch (e) {\n      failCount++;\n      // Heal ONLY a page that was previously alive — never during a cold start — and at most twice\n      if (everAlive && failCount >= 5 && reloads < 2) {\n        try {\n          const pg = html.split(\"/*__SAVED__*/\").join(\";window.SAVED=\" + (lastWritten || \"null\") + \";\");\n          await wv.loadHTML(pg);\n          reloads++; failCount = 0;\n        } catch (e2) {}\n      }\n    }\n    await wait(1500);\n  }\n  // Final flush on close (best effort)\n  try {\n    const out = await wv.evaluateJavaScript(\"window.SAVE_DATA || 'null'\");\n    if (out && out !== \"null\" && out !== lastWritten) store.writeString(path, out);\n  } catch (e) {}\n  Script.complete();\n}\n", "share_sheet_inputs": []}