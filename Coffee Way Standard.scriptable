{"always_run_in_app": true, "icon": {"color": "brown", "glyph": "coffee"}, "name": "Coffee Way Standard", "script": "// Coffee Way Standard — by Abdulmajeed Mohammed Alwahieb\n// © 2026 Abdulmajeed Mohammed Alwahieb.\n\nconst html = `<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n<link rel=\"manifest\" href=\"manifest.json\">\n<meta name=\"theme-color\" content=\"#17120E\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Coffee Way\">\n<link rel=\"apple-touch-icon\" href=\"icon-192.png\">\n<title>Coffee Way Standard</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600&display=swap');\n@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;700&display=swap');\nbody.ar{direction:rtl}\nbody.ar, body.ar *{font-family:'Noto Sans Arabic','JetBrains Mono',sans-serif !important}\nbody.ar .num, body.ar .abnum, body.ar .dateinp, body.ar input[inputmode=\"numeric\"], body.ar input[inputmode=\"decimal\"]{direction:ltr}\n:root{--bg:#120D0A;--panel:#241B15;--panel2:#1C1512;--line:#3E322A;--paper:#F4EEE3;--paperLine:#E2D8C8;--ink:#2A2018;--inkSoft:#7A6A57;--cream:#EFE7D8;--creamSoft:#A99A85;--copper:#E0813C;--copperBright:#F0A057;--teal:#4FA3A3;--glow:rgba(224,129,60,.06)}\n*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}\nbody{background:var(--bg);font-family:'Space Grotesk',system-ui,sans-serif;color:var(--cream);padding:20px 16px 60px;-webkit-text-size-adjust:100%;overflow-x:hidden}\n.wrap{max-width:680px;margin:0 auto}\n.eyebrow{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.28em;color:var(--copper);text-transform:uppercase}\nh1{font-family:ui-serif,'New York',Georgia,'Noto Serif',serif;font-size:34px;font-weight:600;letter-spacing:-.02em;margin:10px 0 4px;line-height:1.02}\n.panel{background:linear-gradient(158deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:16px;padding:22px 20px;margin-bottom:22px;overflow:hidden;position:relative}.panel::before{content:\"\";position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(224,129,60,.45),transparent)}\n.field{margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid rgba(62,50,42,.4)}.field:last-child{border-bottom:none;padding-bottom:0}\n.field:last-child{margin-bottom:0}\n.flabel{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.18em;color:var(--copper);text-transform:uppercase;margin-bottom:11px}\n.seg{display:grid;grid-template-columns:repeat(auto-fit,minmax(84px,1fr));gap:6px}\n.seg-btn{min-height:48px;padding:0 10px;border-radius:11px;cursor:pointer;font-family:'Space Grotesk',sans-serif;font-size:13.5px;background:rgba(255,255,255,.025);color:var(--creamSoft);border:1px solid var(--line);font-weight:500;transition:all .14s}\n.seg-btn.active{background:var(--copper);color:#140E0C;border-color:var(--copper);font-weight:600;box-shadow:0 2px 12px rgba(224,129,60,.25)}\n.seg.teal .seg-btn.active{background:var(--teal);color:#0C1A1A;border-color:var(--teal);box-shadow:0 2px 12px rgba(79,163,163,.25)}\n.sel{width:100%;height:46px;padding:0 12px;border-radius:11px;background:var(--panel);color:var(--cream);border:1px solid var(--line);font-family:'JetBrains Mono',monospace;font-size:13px;outline:none;-webkit-appearance:none;appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--creamSoft) 50%),linear-gradient(135deg,var(--creamSoft) 50%,transparent 50%);background-position:calc(100% - 16px) 20px,calc(100% - 11px) 20px;background-size:5px 5px,5px 5px;background-repeat:no-repeat}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.grid2>*{min-width:0;box-sizing:border-box;overflow:hidden}\n.dateinp{width:100%;max-width:100%;min-width:0;height:46px;padding:0 12px;border-radius:2px;background:var(--panel);color:var(--cream);border:1px solid var(--line);font-family:'JetBrains Mono',monospace;font-size:13px;outline:none;-webkit-appearance:none;appearance:none;text-align:center;box-sizing:border-box;overflow:hidden}\n.dateinp::-webkit-date-and-time-value{margin:0;padding:0;text-align:center}\n.dateinp::-webkit-calendar-picker-indicator{margin:0;padding:0}\n.txt{width:100%;height:46px;padding:0 12px;border-radius:2px;background:var(--panel);color:var(--cream);border:1px solid var(--line);font-family:'JetBrains Mono',monospace;font-size:13px;outline:none}\n.txt::placeholder{color:var(--creamSoft)}\n.presets{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}\n.preset{display:inline-flex;align-items:stretch;border:1px solid var(--teal);border-radius:2px;overflow:hidden}\n.preset-load{background:transparent;color:var(--cream);border:none;font-family:'JetBrains Mono',monospace;font-size:12px;padding:8px 10px;cursor:pointer;max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.preset-del{background:transparent;color:var(--creamSoft);border:none;border-left:1px solid var(--line);padding:0 9px;cursor:pointer;font-size:12px}\n.nopreset{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--creamSoft);margin-bottom:10px}\n.saverow{display:flex;gap:6px}\n.pname{flex:1;min-width:0;height:42px;padding:0 12px;border-radius:2px;background:var(--panel);color:var(--cream);border:1px solid var(--line);font-family:'JetBrains Mono',monospace;font-size:12.5px;outline:none}\n.pname::placeholder{color:var(--creamSoft)}\n.savebtn{flex:none;height:42px;padding:0 14px;border-radius:2px;background:var(--teal);color:var(--bg);border:none;font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;cursor:pointer}\n.step{display:flex;align-items:center;gap:8px}\n.step-btn{width:46px;height:46px;flex:none;border-radius:2px;cursor:pointer;background:transparent;color:var(--cream);border:1px solid var(--line);font-size:22px;font-family:'JetBrains Mono',monospace;line-height:1}\n.step-btn.small{width:40px;font-size:12px;color:var(--copperBright)}\n.numbox{flex:1;height:46px;display:flex;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:2px}\n.num{width:100%;height:100%;border:none;outline:none;background:transparent;text-align:center;font-family:'JetBrains Mono',monospace;font-size:18px;color:var(--copperBright);font-weight:700}\n.suf{font-family:'JetBrains Mono',monospace;color:var(--creamSoft);font-size:12px;padding-right:10px}\n.hint{margin-top:8px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--creamSoft)}\n.fresh-dot{font-family:'JetBrains Mono',monospace;font-size:11px;margin-top:8px}\n/* card */\n.card{background:var(--paper);color:var(--ink);border-radius:16px;padding:24px 22px;box-shadow:0 1px 0 rgba(224,129,60,.25),0 12px 30px rgba(0,0,0,.35)}\n.chead{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;margin-bottom:14px}\n.ctitle{font-family:ui-serif,'New York',Georgia,'Noto Serif',serif;font-weight:600;font-size:27px;line-height:1.05;letter-spacing:-.02em}\n.cmethod{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--copper)}\n.icedstrip{background:rgba(62,142,142,.12);border:1px solid var(--teal);border-radius:3px;padding:11px 14px;margin-bottom:16px;font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--ink);font-weight:700;text-align:center}\n.grind{background:linear-gradient(158deg,#241B15,#191210);color:var(--cream);border-radius:14px;padding:18px 18px;margin-bottom:18px;position:relative;overflow:hidden}.grind::before{content:\"\";position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(224,129,60,.5),transparent)}\n.glabel{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.12em;color:var(--copperBright);text-transform:uppercase;margin-bottom:6px}\n.gnum{font-family:ui-serif,'New York',Georgia,'Noto Serif',serif;font-size:46px;font-weight:600;letter-spacing:-.02em;line-height:1;color:var(--cream);margin:2px 0}\n.gwf{font-size:12px;color:var(--creamSoft);margin-top:6px;line-height:1.45}\n.gscale{margin-top:14px}.gscale-head{display:flex;align-items:baseline;gap:8px;margin-bottom:12px}.gscale-head b{font-family:ui-serif,'New York',Georgia,serif;font-size:18px;font-weight:600;color:var(--cream)}.gscale-ref{font-size:12.5px;color:var(--copperBright)}.gscale-track{position:relative;display:flex;align-items:center;justify-content:space-between;height:28px;padding:0 6px;background:rgba(255,255,255,.05);border-radius:8px}.gtick{display:flex;align-items:center;justify-content:center;flex:1}.gtick i{display:block;background:var(--cream);border-radius:50%;opacity:.35;transition:.15s}.gtick.on i{background:var(--copper);opacity:1;box-shadow:0 0 0 3px rgba(224,129,60,.18)}.gscale-marker{position:absolute;top:-3px;width:2px;height:32px;background:var(--copper);border-radius:2px;transform:translateX(-1px);box-shadow:0 0 6px rgba(224,129,60,.5)}.gscale-ends{display:block;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.16em;color:var(--creamSoft);margin-top:8px}.gscale-note{font-size:11.5px;color:var(--creamSoft);line-height:1.55;margin-top:12px;font-style:italic;opacity:.85}body.ar .gscale-note{font-style:normal}\n.swatch{display:flex;align-items:center;gap:3px;background:rgba(255,255,255,.05);padding:6px 8px;border-radius:3px;min-height:24px}\n.swatch i{display:block;background:var(--cream);border-radius:50%;flex:none}\n.gsizetxt{font-size:12.5px;color:var(--cream)}\n.gcal{margin-top:10px}.gcal-link{background:none;border:none;color:var(--teal);font-size:11.5px;cursor:pointer;padding:0;text-decoration:underline;font-family:'Space Grotesk',sans-serif}.gcal-set .gcal-link{margin-left:8px;color:var(--creamSoft)}.gcal-badge{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--teal);background:rgba(79,163,163,.12);padding:4px 9px;border-radius:100px}.gcal-open{background:rgba(79,163,163,.06);border:1px solid rgba(79,163,163,.2);border-radius:11px;padding:13px 14px}.gcal-q{font-size:12.5px;color:var(--cream);line-height:1.5;margin-bottom:10px}.gcal-q b{color:var(--copperBright)}.gcal-row{display:flex;gap:8px;margin-bottom:9px;width:100%;box-sizing:border-box}.gcal-input{flex:1 1 auto;min-width:0;height:42px;border-radius:10px;background:rgba(255,255,255,.05);border:1px solid var(--line);color:var(--cream);font-family:ui-serif,'New York',Georgia,serif;font-size:18px;text-align:center;outline:none}.gcal-input:focus{border-color:var(--teal)}.gcal-save{flex:0 0 auto;height:42px;padding:0 16px;white-space:nowrap;box-sizing:border-box;border-radius:10px;border:none;background:var(--teal);color:#0C1A1A;font-weight:600;font-size:13px;cursor:pointer}.gcal-hint{font-size:11px;color:var(--creamSoft);line-height:1.5;opacity:.85}.gtip{font-size:11px;color:var(--creamSoft);margin-top:8px;font-style:italic;line-height:1.4}\n.brewhead{margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid rgba(42,32,24,.1)}.bh-name{font-family:ui-serif,'New York',Georgia,serif;font-size:22px;font-weight:600;color:#2A2018;line-height:1.1}.bh-sub{font-family:'JetBrains Mono',monospace;font-size:12px;color:#8A7D6C;margin-top:3px;letter-spacing:.02em}.readouts{display:grid;grid-template-columns:repeat(auto-fit,minmax(104px,1fr));gap:10px;margin-bottom:18px}\n.readouts>div{min-width:0;overflow:hidden;background:rgba(42,32,24,.06);border:1px solid rgba(42,32,24,.1);border-radius:11px;padding:12px 14px}.rk{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.12em;color:var(--inkSoft);text-transform:uppercase;margin-bottom:5px}\n.rv{font-family:ui-serif,'New York',Georgia,serif;font-size:22px;font-weight:600;line-height:1.05;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis;letter-spacing:-.01em}\n.ru{font-family:'JetBrains Mono',monospace;font-size:9.5px;color:var(--inkSoft);margin-top:3px;white-space:nowrap}\n.gfp{margin-top:12px;padding:13px 15px;border-radius:11px;background:rgba(79,163,163,.08);border:1px solid rgba(79,163,163,.22)}.gfp-h{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.04em;color:var(--teal);font-weight:600;margin-bottom:5px}.gfp-b{font-size:12.5px;color:var(--ink);line-height:1.55}.gfp-b b{color:#2b6a6a;font-family:ui-serif,'New York',Georgia,serif;font-size:15px}.fresh{font-size:13.5px;line-height:1.5;color:var(--inkSoft);margin-bottom:18px}\n.sect{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.16em;color:var(--copperSoft,var(--copper));text-transform:uppercase;margin-bottom:12px}\n.row{display:flex;gap:14px;padding:6px 0}.row+.row{margin-top:16px}\n.time{width:42px;flex:none;text-align:right;font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700}\n.ncol{position:relative;width:14px;flex:none}.dot{width:12px;height:12px;border-radius:50%;background:var(--copper);margin-top:3px;box-shadow:0 0 0 3px rgba(224,129,60,.15)}\n.vline{position:absolute;left:5px;top:14px;bottom:-16px;width:1px;background:var(--paperLine)}\n.content{flex:1;min-width:0}\n.rtop{display:flex;justify-content:space-between;align-items:baseline;gap:8px}\n.plabel{font-family:ui-serif,'New York',Georgia,serif;font-weight:600;font-size:15px;letter-spacing:-.01em}\n.amt{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--teal);font-weight:700;white-space:nowrap}.cum{color:var(--inkSoft);font-weight:400}\n.barwrap{height:6px;background:var(--paperLine);border-radius:3px;margin:6px 0;overflow:hidden}.bar{height:100%;background:var(--teal);border-radius:3px;transition:width .25s}\n.pnote{font-size:12.5px;color:var(--inkSoft);line-height:1.45}\n.notes{margin-top:20px;padding-top:18px;border-top:1px solid var(--paperLine);display:grid;gap:16px}\n.note{display:flex;gap:12px;gap:12px}.nlabel{flex:none;width:82px;font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:var(--copper);text-transform:uppercase;padding-top:3px;line-height:1.4}.ntext{font-size:13.5px;line-height:1.6;color:var(--ink)}\n.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n.navbtn{background:transparent;color:var(--copper);border:1px solid var(--line);border-radius:2px;padding:9px 13px;font-family:'JetBrains Mono',monospace;font-size:12px;cursor:pointer;font-weight:700}\n.navwrap{display:flex;gap:6px}\n.gref{background:linear-gradient(158deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:16px;padding:18px 16px;margin:22px 0 8px;position:relative;overflow:hidden}.gref::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(224,129,60,.5),transparent)}.gref-head{font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:var(--copper);text-align:center;margin-bottom:14px}.gstrip{display:flex;background:#F4EEE3;border-radius:12px;overflow:hidden;border:1px solid var(--line)}.gstrip-col{flex:1;padding:13px 3px 11px;text-align:center;border-right:1px solid #e0d5c2}.gstrip-col:last-child{border-right:none}.gstrip-col:last-child{border-right:none}.gstrip-patch{height:92px;position:relative;overflow:hidden;margin-bottom:9px;border-radius:6px}.gsd{position:absolute;background:#3a2416;border-radius:44% 56% 52% 48%;transform:translate(-50%,-50%)}.gstrip-l{font-size:10.5px;font-weight:600;color:#3a2416;line-height:1.25}.gstrip-u{font-family:'JetBrains Mono',monospace;font-size:9px;color:#8a7a60}.gstrip-ends{display:flex;justify-content:space-between;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.16em;color:var(--creamSoft);margin-top:8px;padding:0 4px;margin-bottom:8px}.libsub{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--creamSoft);margin:-8px 0 16px;line-height:1.5}\n.learn-sec{background:linear-gradient(158deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:16px;padding:22px 20px;margin-bottom:16px;position:relative;overflow:hidden}.learn-sec::before{content:\"\";position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(224,129,60,.4),transparent)}\n.learn-h{font-family:ui-serif,'New York',Georgia,'Noto Serif',serif;font-weight:600;font-size:21px;color:var(--cream);margin-bottom:16px;letter-spacing:-.01em;padding-bottom:12px;border-bottom:1px solid rgba(224,129,60,.2)}\n.learn-item{margin-bottom:16px}.learn-item:last-child{margin-bottom:0}.learn-item.pull .learn-d{font-family:ui-serif,'New York',Georgia,serif;font-size:17px;line-height:1.5;color:var(--cream);opacity:1;font-style:italic;border-left:2px solid var(--copper);padding-left:14px}.learn-item.pull .learn-t{color:var(--creamSoft)}\n.learn-item:last-child{margin-bottom:0}\n.learn-t{font-family:'Space Grotesk',sans-serif;font-size:14px;color:var(--copperBright);font-weight:600;margin-bottom:5px;letter-spacing:.01em}\n.learn-d{font-size:13.5px;color:var(--cream);opacity:.82;line-height:1.65}\n#saveBar{margin-top:18px}\n.savebar-btn{width:100%;min-height:54px;border-radius:13px;font-family:ui-serif,'New York',Georgia,serif;font-size:17px;font-weight:600;box-shadow:0 4px 16px rgba(79,163,163,.25);border:1px solid var(--teal);background:var(--teal);color:#0C1A1A;filter:none;position:relative;z-index:1;cursor:pointer}\n.saveform{display:none;gap:6px;margin-top:8px}\n.saveform.open{display:flex}\n.cancelbtn{flex:none;width:48px;height:46px;border-radius:2px;border:1px solid var(--line);background:transparent;color:var(--creamSoft);font-size:14px;cursor:pointer}\n.coach{margin-top:20px;padding-top:16px;border-top:1px solid var(--paperLine)}\n.coach-q{font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.1em;color:var(--inkSoft);text-transform:uppercase;margin-